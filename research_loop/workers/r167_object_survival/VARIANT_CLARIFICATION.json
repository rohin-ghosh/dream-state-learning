              "relevant_lines": [
                {
                  "line": 3,
                  "text": "New PLANs may omit seed (0) and presleep_variant (free_distillation), or select"
                },
                {
                  "line": 4,
                  "text": "a nonnegative 32-bit seed and one of PRESLEEP_INVITATIONS with its exact"
                },
                {
                  "line": 5,
                  "text": "compaction_invitation. no_distillation uses an empty invitation and no extra"
                },
                {
                  "line": 30,
                  "text": "    ContinualStream, PRESLEEP_INVITATIONS, digest, experiment_binding, require,"
                },
                {
                  "line": 62,
                  "text": "COMPACTION_INVITATION = PRESLEEP_INVITATIONS['free_distillation']"
                },
                {
                  "line": 411,
                  "text": "        from gpu.orch_r145_suffix_boundary import prepare_sleep as r145_prepare_sleep"
                },
                {
                  "line": 413,
                  "text": "        r145_prepare_sleep(self.engine.model, __file__, 'c66a91b631937236d614095c07785f90242e4d476c45b7fa8fe5d65a8f277d2d')"
                },
                {
                  "line": 468,
                  "text": "def prepare_sleep(child, stream, journal, cycle):"
                },
                {
                  "line": 470,
                  "text": "    variant = child.plan.get('presleep_variant', 'free_distillation')"
                },
                {
                  "line": 473,
                  "text": "    invitation_text = child.plan['compaction_invitation']"
                },
                {
                  "line": 620,
                  "text": "                prepare_sleep(child, stream, journal, cycle)"
                }
              ]
            },
