              },
              "relevant_lines": [
                {
                  "line": 14,
                  "text": "PRESLEEP_INVITATIONS = {"
                },
                {
                  "line": 45,
                  "text": "    variant = plan.get('presleep_variant', 'free_distillation')"
                },
                {
                  "line": 46,
                  "text": "    require(type(variant) is str and variant in PRESLEEP_INVITATIONS, 'known_presleep_variant')"
                },
                {
                  "line": 47,
                  "text": "    require(plan['compaction_invitation'] == PRESLEEP_INVITATIONS[variant], 'exact_posted_prompts')"
                },
                {
                  "line": 48,
                  "text": "    return dict(schema=EXPERIMENT_SCHEMA, seed=seed, presleep_variant=variant,"
                },
                {
                  "line": 49,
                  "text": "        compaction_invitation=plan['compaction_invitation'], system_prompt=plan['system_prompt'],"
                },
                {
                  "line": 54,
                  "text": "    require(type(binding) is dict and set(binding) == {'schema', 'seed', 'presleep_variant',"
                },
                {
                  "line": 55,
                  "text": "        'compaction_invitation', 'system_prompt', 'birth_prompt', 'seed_initialization'}, 'exact_experiment_binding')"
                },
                {
                  "line": 64,
                  "text": "        require(requested['seed'] == 0 and requested['presleep_variant'] == 'free_distillation',"
