      "record_sha256": "2117ddda128e64d5d9cb3d2e0a6bb0a2d995ab8c8ceddec84a7bbed80094cde0",
      "text": "### \u751f\u547d\u5468\u671f\u4e2d\u7684\u9b54\u6cd5\u8f6c\u53d8 (\u7ee7\u7eed\uff09\n\nWhisker\u7684\u7fc5\u8180\u8f7b\u5fae\u5730\u98a4\u52a8\u7740\uff0c\u5979\u8f7b\u8f7b\u5730\u5728\u672a\u6765\u7a7a\u6c14\u4e2d\u524d\u884c\u4e86\u4e00\u4e9b\u3002\u5728\u8fd9\u4e2a\u5b89\u9759\u7684\u8fc7\u7a0b\u4e2d\uff0c\u5979\u9888\u90e8\u7684\u7b2c\u4e00\u4e2a\u7ec6\u5fae\u95ea\u70c1\u5f88\u5feb\u53d8\u6210 blue\uff0c\u5e76\u6269\u5c55\u5979\u7684\u5168\u8eab\u3002\u968f\u540e\uff0c\u5979\u7684\u8eab\u4f53\u53d8\u5f97\u67d4\u8f6f\u800c\u900f\u660e\uff0c\u5f62\u6210\u4e86two\u7247\u84dd\u8272\u5149\u8f89\u7684\u7fc5\u8180\u3002\u5979\u7684\u624b\u8f7b\u8f7b\u89e6\u6478\u7740\u7a7a\u6c14\u4e2d\uff0c\u7fc5\u8180\u5fae\u5fae\u632f\u52a8\u8d77\u4e86\u060c\u867d\u7136\u5e45\u5ea6\u5f88\u5c0f\uff0c\u4f46\u662f\u5f88\u5bb9\u6613\u88ab\u5bdf\u89c9\u5230\u3002\u201d\n\n\u5468\u56f4\u7684\u6811\u6728\u548c\u82b1\u6735\u4f3c\u4e4e\u56e0\u4e3a\u5979\u7684\u5b58\u5728\u800c\u89e6\u52a8\uff0c\u5f00\u59cb\u8f7b\u6416\u66f3\u060c\u6563\u53d1\u51fa\u66f4\u52a0\u6d53\u90c1\u7684\u82b3\u9999\u3002\u9e1f\u513f\u90fd\u88abWhisker\u7684\u51fa\u73b0\u6fc0 \u53d1\u4e86\uff0c\u5b83\u4eec\u5f00\u59cb\u5728\u5979\u7684\u5468\u56f4\u7a7f\u68ad\uff0c\u53d1\u51fa\u6109\u5feb\u7684\u9e23\u97f3\u3002\u5176\u95f4\u4e00\u53ea\u5c0f\u9e1f\u751a\u81f3\u843d\u5230Whisker\u7684\u80a9\u8180\u4e0a\u4e86\uff0c\u5b83\u7684\u7fbd\u6bdb\u8f7b\u8f7b\u5730\u89e6 \u78b0\u7740Whisker\u7684\u76ae\u80a4\uff0c\u53d1\u51fa\u7ec6\u5fae\u7684\u6469\u64e6\u58f0\u97f3\u3002\n\nWhisker\u611f\u53d7\u5230\u4e86\u5c0f\u9e1f\u7684\u7fbd\u6bdb\u5728\u81ea\u5df1\u76ae\u80a4\u4e0a\u8f7b\u62c2\uff0c\u8fd9\u662f\u4e00\u4e2a\u53ea\u6709\u5979\u80fd\u591f hear\u5e76\u4e14\u611f\u5230\u5bb3\u6015\u800c\u5174\u594b\u7684\u58f0\u97f3\u3002\u5176\u4ed6\u7684\u97f3\u54cd\uff0c\u50cf\u662f\u9e1f\u513f\u9ad8\u8154\u7684\u6b4c\u58f0\u548c\u4f4e\u6c88\u7684 nil\u5583\uff0c\u4ecd\u7136\u5728\u5979\u7684\u8033\u8fb9\u56de\u54cd\uff0c\u5f62\u6210\u4e00\u4e2a\u590d\u6742\u7684\u97f3\u9891\u666f\u89c2\u3002 \u044d\u0442\u043e\u0442\u573a\u666f\u8ba9\u5979\u65e2\u5bb3\u6015\u53c8\u6fc0\u52a8\uff0c\u540c\u65f6\u5979\u5bf9\u81ea\u5df1\u65b0\u7684\u80fd\u529b\u65e2\u6709\u65b0\u9c9c\u611f\u53d7\u53c8\u4e00\u6b21\u6709\u4e9b\u4e0d\u786e\u5b9a\u3002\n\n---\n\n\u5728\u6211\u9605\u8bfb\u76f8\u5173\u53e5\u5b50\u540e\uff0c\u6211\u6ca1\u6709\u6e05\u6670\u5730\u60f3\u8c61\u51fa\u5e26\u6709\u201c\u5f69\u8272\u201d\u4e00\u8bcd\u65f6\u7684\u72ec\u7279\u753b\u9762\uff0c\u4e5f\u4e0d\u77e5\u9053\u5b83\u7684\u5220\u9664\u4f1a\u5e26\u6765\u4ec0\u4e48\u53d8\u5316\u3002\u56e0\u6b64\uff0c\u6211\u4f1a\u9009\u62e9\u63a5\u8fd1\u9605\u8bfb\u8be5\u53e5\u5b50\uff0c\u770b\u770b\u662f\u5426\u80fd\u591f\u89e3\u51b3\u6211\u5bf9\u90a3\u4e2a\u56fe\u50cf\u7684\u4e0d\u786e\u5b9a\u6027\u3002\u5982\u679c\u4ec5\u4ec5\u662f\u9605\u8bfb\u65e0\u6cd5\u505a\u51fa\u5224\u65ad\uff0c\u6211\u4f1a\u5c1d\u8bd5\u77ed\u6682\u91cd\u5199\u53e5\u5b50\uff0c\u770b\u770b\u8fd9\u80fd\u5426\u63d0\u4f9b\u66f4\u597d\u7684\u8bc1\u636e\u3002\n\n\u901a\u8fc7\u8fd9\u4e2a\u8fc7\u7a0b\uff0c\u6211\u4f1a\u786e\u5b9a\u662f\u5426\u9700\u8981\u4fdd\u7559\u201c\u5f69\u8272\u201d\u8fd9\u4e2a\u63cf\u8ff0\uff0c\u4ee5\u53ca\u5b83\u5982\u4f55\u72ec\u7279\u5730\u63cf\u8ff0\u58f0\u97f3\u3002\u5982\u679c\u5728\u5199\u4f5c\u8fc7\u7a0b\u4e2d\u6709\u4efb\u4f55\u89c2\u5bdf\u7ed3\u679c\u8ba9\u6211\u6539\u53d8\u4e3b\u610f\uff0c\u6211\u4f1a\u53ca\u65f6\u8c03\u6574 meu\u51b3\u7b56\u3002\u53e6\u5916\uff0c\u6211\u4f1a\u643a\u5e26\u652f\u6301\u8fd9\u4e00\u51b3\u7b56\u7684\u53d1\u73b0\u3001\u5269\u4f59\u7684\u4e0d\u786e\u5b9a\u6027\u4ee5\u53ca\u5176\u4ed6\u76f8\u5173\u6b65\u9aa4\u8fdb\u5165\u4e0b\u4e00\u4e2a\u56de\u5408\u3002"
    },
    {
      "actor": "child",
      "record_index": 5384,
      "record_sha256": "885cada3b0416b966cf8c31566a9ca7aaf57f6efc79d93186b31ebabbd793c9e",
      "text": "### \u751f\u547d\u5468\u671f\u4e2d\u7684\u9b54\u6cd5\u8f6c\u53d8 (\u7ee7\u7eed\uff09\n\nWhiskers\u7684\u7fc5\u8180\u8f7b\u5fae\u5730\u98a4\u52a8\u7740\uff0c\u5979\u8f7b\u8f7b\u5730\u5728\u7a7a\u6c14\u4e2d\u56fd\u524d\u884c\u4e86\u4e00\u4e9b\u3002\u5728\u8fd9\u4e2a\u5b89\u9759\u7684\u8fc7\u7a0b\u4e2d\uff0c\u5979\u9888\u90e8\u7684\u7b2c\u4e00\u4e2a\u7ec6\u5fae\u95ea\u70c1\u5f88\u5feb\u53d8\u6210\u84dd\u8272\u4e26\u6269\u5c55\u5230\u5979\u7684\u5168\u8eab\u3002\u968f\u540e\uff0c\u5979\u7684\u8eab\u4f53\u53d8\u5f97\u67d4\u8f6f\u800c\u900f\u660e\uff0c\u5f62\u6210\u4e86\u4e00\u4efd\u84dd\u8272\u5149\u8f89\u7684\u7fc5\u8180\u3002\u5979\u7684\u624b\u8f7b\u8f7b\u89e6\u6478\u7740\u7a7a\u6c14\u4e2d\uff0c\u7fc5\u8180\u5fae\u5fae\u632f\u52a8\u8d77\u6765\u4e86\u060c\u867d\u7136\u5e45\u5ea6\u5f88\u5c0f\uff0c\u4f46\u662f\u5f88\u5bb9\u6613\u88ab\u5bdf\u89c9\u5230\u3002\u201d\n\n\u5468\u56f4\u7684\u6811\u6728\u548c\u82b1\u6735\u4eff\u4f5b\u56e0\u4e3a\u5979\u7684\u5b58\u5728\u800c\u89e6\u52a8\uff0c\u5f00\u59cb\u8f7b\u6416\u66f3\uff0c\u6563\u53d1\u51fa\u66f4\u52a0\u6d53\u90c1\uc758\u82b3\u9999\u3002\u9e1f\u513f\u90fd\u88abWhiskers\u306e\u51fa\u73b0\u6fc0\u53d1\u4e86\u5417\uff0c\u5b83\u4eec\u958b\u59cb\u5728\u8fd9\u4e2a\u5468\u56f4\u7a7f\u68ad\uff0c\u53d1\u51fa\u6109\u5feb\u7684\u9e23\u97f3\u3002\u5176\u4e2d\u4e00\u53ea\u5c0f\u9e1f\u751a\u81f3\u843d\u5728\u4e86 Whiskers\u7684\u80a9\u8180\u4e0a\u4e86\uff0c\u5b83\u7684\u7fbd\u6bdb\u8f7b\u8f7b\u5730\u89e6\u78b0\u7740Whiskers\u7684\u76ae\u80a4\uff0c\u767c\u51fa\u7ec6\u5fae\u7684\u6469\u64e6\u58f0\u97f3\u3002\n\nWhiskers\u611f\u53d7\u5230\u4e86\u5c0f\u9e1f\u7684\u7fbd\u6bdb\u5728\u81ea\u5df1\u76ae\u80a4\u4e0a\u8f7b\u62c2\uff0c\u8fd9\u662f\u4e00\u4e2a\u53ea\u6709\u5f88\u591a\u5979\u80fd\u591f\u542c\u5230\u5e76\u4e14\u611f\u5230\u5bb3\u6015\u800c\u5174\u594b\u7684\u58f0\u97f3\u3002\u5176\u4ed6\u7684\u97f3\u54cd\uff0c\u50cf\u662f\u9e1f\u723e\u9ad8\u4ea2\u7684\u6b4c\u58f0\u548c\u4f4e\u6c88\u7684\u5462\u5583\uff0c\u4ecd\u7136\u5728\u5979\u7684\u8033\u8fb9\u56de\u5fc6\uff0c\u5f62\u6210\u4e00\u4e2a\u590d\u6742\u7684\u97f3\u9891\u666f\u89c2\u3002\u8fd9\u4e2a\u573a\u5408\u8ba9\u5979\u65e2\u5bb3\u6015\u53c8\u6fc0\u52a8\uff0c\u540c\u65f6\u4e5fs\u5bf9\u81ea\u5df1\u65b0\u7684\u80fd\u529b\u65e2\u6709\u65b0\u9c9c\u611f\u53d7\u53c8\u6709\u4e9b\u4e0d\u786e\u5b9a\u3002\n\n---\n\n\u5728\u6211\u9605\u8bfb\u76f8\u5173\u53e5\u5b50\u540e\uff0c\u6211\u89c9\u5f97\u201c\u5f69\u8272\u58f0\u97f3\u201d\u7684\u63cf\u8ff0\u867d\u7136\u72ec\u7279\uff0c\u4f46\u662f\u53ef\u80fd\u4f1a\u7ed9\u8bfb\u8005\u5e26\u6765\u6df7\u6dc6\u3002\u56e0\u6b64\uff0c\u6211\u4f1a\u9009\u62e9\u53bb\u9664\u8fd9\u4e2a\u63cf\u8ff0\uff0c\u770b\u770b\u662f\u5426\u4f1a\u66f4\u597d\u5730\u4f20\u8fbeWhisker\u7684\u611f\u53d7\u3002\u901a\u8fc7\u8fd9\u4e2a\u53d8\u5316\uff0c\u6211\u53ef\u4ee5\u786e\u5b9a\u662f\u5426\u9700\u8981\u4fdd\u7559\u8fd9\u4e2a\u7ec6\u8282\u3002\n\n\u6b64\u5916\uff0c\u6211\u4f1a\u643a\u5e26\u652f\u6301\u8fd9\u4e00\u51b3\u7b56\u7684\u53d1\u73b0\u3001\u5269\u4f59\u7684\u4e0d\u786e\u5b9a\u6027\u4ee5\u53ca\u76f8\u5173\u7684\u672a\u5b8c\u6210\u6b65\u9aa4\u8fdb\u5165\u4e0b\u4e00\u4e2a\u56de\u5408\u3002\u5177\u4f53\u60c5\u51b5\u5c06\u4f1a\u6839\u636e\u5b9e\u9645\u6548\u679c\u6765\u8fdb\u884c\u8c03\u6574\u3002"
    },
