      "record_sha256": "c3cabb1e5027b9cc801d2fbb0c2322176fb9bb98d3a9c12f7fe026891557286d",
      "text": "### \u5206\u6790 Ya na \u7b7e\u7f72\u56fe\u8868\u7684\u60c5\u666f\n\n\u5728\u6211\u7684\u8349\u7a3f\u4e2d\uff0c\u5173\u4e8e Ya na \u7b7e\u7f72\u56fe\u8868\u7684\u90e8\u5206\u5e76\u4e0d\u662f\u975e\u5e38\u660e\u786e\uff0c\u4e3b\u8981\u662f\u63d0\u5230\u5979\u7684\u540c\u4e8b\u88ab\u9080\u8bf7\u5728\u56fe\u8868\u4e0a\u7b7e\u5b57\u786e\u8ba4\uff0c\u5e76\u4e14 Ya na \u63a5\u53d7\u4e86\u8fd9\u4e2a\u5efa\u8bae\u3002\u5177\u4f53\u7684\u7ec6\u8282\u4e0d\u591f\u6e05\u6670\uff0c\u4e0d\u6e05\u695a Ya na \u662f\u5426\u5b9e\u9645\u7b7e\u7f72\u4e86\u56fe\u8868\uff0c\u8fd8\u4fdd\u6301\u7740\u4e00\u79cd\u4e0d\u786e\u5b9a\u6027\u3002\n\n### \u4e0b\u4e00\u6b65\u884c\u52a8\n\n\u4e3a\u4e86\u6f84\u6e05 Ya na \u662f\u5426\u5b9e\u9645\u7b7e\u7f72\u4e86\u56fe\u8868\uff0c\u6211\u5c06\u7ee7\u7eed\u53d1\u5c55\u8fd9\u6bb5\u60c5\u8282\uff0c\u805a\u7126\u4e8e\u5979\u7b7e\u7f72\u56fe\u8868\u7684\u65f6\u523b\uff0c\u4ee5\u4fbf\u66f4\u597d\u5730\u7406\u89e3\u5979\u7684\u52a8\u673a\u548c\u5fc3\u6001\u3002\u4ee5\u4e0b\u662f\u4fee\u8ba2\u540e\u7684\u6587\u672c\uff1a\n\n---\n\n\u5728\u7f51\u7edc\u4f1a\u8bae\u4e0a\uff0c\u9879\u76ee\u7ecf\u7406\u7b80\u8981\u6709\u4ecb\u7ecd\u4e86\u4e00\u9879\u76ee\u7684\u72b6\u6001\uff0c\u7136\u540e\u9080\u8bf7\u5404\u7ba1\u7406\u4eba\u5458\u8d1f\u8d23\u4eba\u5728\u5173\u952e\u56fe\u8868\u4e0a\u7b7e\u5b57\u786e\u8ba4\u3002Ya na \u4e0a\u524d\u62ff\u8d77\u56fe\u5f62\uff0c\u8be6\u7ec6\u68c0\u67e5\u6bcf\u4e00\u4e2a\u4e2a\u6578\u64da\u9ede\uff0c\u786e\u4fdd\u4e00\u5207\u90fd\u5f88\u51c6\u786e\u3002\u5f53\u5979\u68c0\u67e5\u5230\u4e00\u4e2a\u7279\u5b9a\u7684\u6570\u636e \u0111i\u1ec3m \u65f6\uff0c\u5979\u7684\u624b\u6296\u4e86\u4e00\u4e0b\uff0c\u5fc3\u4e2d\u7684\u7d27\u7ef7\u611f\u8fbe\u5230\u4e86\u9876\u70b9\uff09\u3002\u554f\u984c\u5728\u4e8e\u8a72\u6578\u64da\u9ede\u8207\u5176\u4ed6\u6578\u64da\u4e4b\u9593\u7684\u5dee\u7570-too prominent\uff0c\u986f\u793a\u4e0d\u5408\u7406\u3002\u5979\u4e0d\u786e\u5b9a\u662f\u8a08\u7b97\u932f\u8aa4\u9084\u662f\u6709\u5176\u4ed6\u539f\u56e0\u9020\u6210\u7684\u3002\n\n\u5979\u6df1\u6df1\u5438\u4e86\u4e00\u4efd\u6c14\uff0c\u5c06\u9f20\u6807\u6307\u9488\u6307\u5411\u8a72\u6578\u64da\u9ede\uff0c\u9080\u8bf7\u540c\u4e8b\u4eec\u4e00\u8d77\u6765\u68c0\u67e5\uff1a\u201c\u6aa2\u67e5\u9019\u500b\u6578\u64da\u9ede\u9644\u8fd1\u7684\u8a18\u9304\uff0c)\u201d \u5979\u8bf4\uff0c\u8bd5\u56fe\u4fdd\u6301\u8072\u97f3\u7684\u5e73\u7a69\uff0c\u201c\u4e00\u4e9b\u6771\u897f\u770b\u8d77\u6765\u4e0d\u5bf9\u52b2\u3002\u201d\u53e6\u4e00\u4f4d\u540c\u4e8b\u9760\u8fd1\uff0c\u4e00\u8d77\u5be9\u67e5\u4e86\u76f8\u95dc\u7684\u6570\u636e\u3002\u201c\u53ef\u80fd \u662f\u91c7\u96c6\u6642\u9593\u7684\u5dee\u7570\u5c0e\u81f4 \u7684\uff0c\u201d\u540c\u4e8b\u5efa\u8b70\u9053\uff0c\u4f01\u56fe\u7f13\u89e3\u5979\u7684\u58d3\u529b\u3002\u7136\u800c\uff0cYa na \u5185\u5fc3\u77e5\u9053\u9019\u50c5\u50c5\u662fsurface \u7406\u7531\uff0c\u771f\u5be6\u7684\u539f\u56e0\u53ef\u80fd\u66f4\u52a0\u8907\u96dc\u3002\n\n\u6703\u8b70\u7d50\u675f\u5f8c\uff0cYa na \u5750\u5728office\u4e2d\uff0c\u5be9\u6838\u8457\u540c\u4e8b\u63d0\u4f9b\u7684\u65e5\u8a8c\u6587\u4ef6\u3002\u5979\u700f\u89bd\u8457\u4e00\u884c\u884c\u52d5 FAG \u4e2d\u7684\u5730\u78bc\u548c\u6578\u64da\uff0c\u8a66\u5716\u627e\u5230\u90a3\u500b\u7279\u6b8a \u7684\u5dee\u7570\u3002\u5c31\u5728\u6b64\u6642\uff0cher \u624b\u673a\u6536\u5230\u4e00\u6761\u6765\u81ea\u6700\u597d\u670b\u53cb\u7684\u6d88\u606f\uff0c\u9080\u8bf7\u5979\u5728\u9031\u672b-goes \u767b\u5c71\u3002\u5979\u72b9\u8c6b\u4e86\u4e00\u6703\u5152\uff0c\u6700\u7d42\u6c7a\u5b9a\u5148\u5b8c\u6210\u8fd9\u9879\u91cd\u8981\u7684\u4efb\u52d9\u3002\n\n\u5979\u7e7c\u7e8c\u5206\u6790\u30c7\u30fc\u30bf\uff0c\u9010\u6f38\u63a5\u8fd1\u554f\u984c\u7684\u6838\u5fc3\u3002\u96a8\u8457\u6642\u9593\u7684\u63a8\u79fb\uff0c\u4e00\u7a2emode \u5f00\u59cb\u986f\u73fe\u2014\u2014\u67d0\u4e00\u500b\u7279\u5b9a\u786c\u4ef6\u5728\u67d0\u4e9b\u689d\u4ef6\u4e0b\u6ed1\u51fa\u793a\u4e86\u6e2c\u91cf\u9519\u8bef\u3002\u5979\u5174 \u594b\u5730\u8a18\u9304\u4e0b\u4e86\u9019\u500b\u767c\u73fe\uff0c\u611f\u53d7\u5230\u4e00\u7a2e\u5de8\u5927\u7684\u6210\u5c31\u611f\u3002\u7576\u5929\u665a \u4e0a\uff0c\u5979\u7d66\u670b\u53cb\u56de\u4e86\u4e00\u689d\u6d88\u606f\uff0c\u89e3\u91ca\u4e86\u81ea\u5df1\u7684\u60c5\u6cc1\uff0c\u4e26\u6c7a \u5b9a\u9031\u672b\u518d\u8003\u616e\u767b\u5c71\u7684\u4e8b\u60c5\u3002\n\n###\u4e0b\u4e00\u4e2a\u610f\u56fe\n\n\u901a\u8fc7\u4e0a\u8ff0\u4fee\u8ba2\uff0c\u6211\u660e\u786e\u4e86 Ya na \u6ca1\u6709\u5b9e\u9645\u7b7e\u7f72\u56fe\u8868\uff0c\u800c\u662f\u5979\u7684\u540c\u4e8b\u7b7e\u7f72\u4e86\u56fe\u8868\u3002\u63a5\u4e0b\u6765\uff0c\u6211\u5c06\u7ee7\u7eed\u63a2\u7d22\u5979\u4e3a\u4ec0\u4e48\u9009\u62e9\u4e0d\u7b7e\u7f72\u56fe\u8868\uff0c"
