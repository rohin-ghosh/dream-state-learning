        "record_sha256": "47623b7a37ed8111670a3274b4900fd7b1dedf3b042e1c1c5e8130d5723ecb42",
        "text": "\u5728\u5149\u8292\u7684\u5f15\u5bfc\u4e0b\uff0cKnight\u4e00\u6b65\u6b65\u524d\u884c\uff0c\u6bcf\u4e00\u6b65\u90fd\u611f\u5230\u4e00\u79cd\u83ab\u540d\u7684\u529b\u91cf\u5728\u652f\u6301\u7740\u4ed6\u3002\u6811\u5e72\u4e0a\u7684\u7b26\u53f7\u7ee7\u7eed\u53d8\u5316\uff0c\u5f62\u6210\u4e86\u66f4\u591a\u7684\u6307\u5bfc\u4fe1\u606f\uff1a\n\n\"\u7a7f\u8fc7\u8bd5\u70bc\u4e4b\u6797\uff0c\u5bfb\u627e\u5149\u660e\u4e4b\u5fc3\u3002\u201d\n\nKnight\u77e5\u9053\uff0c\u8fd9\u6bb5\u65c5\u7a0b\u5c06\u5145\u6ee1\u6311\u6218\uff0c\u4f46\u4ed6\u4e5f\u611f\u5230\u4e00\u80a1\u4e0d\u53ef\u6297\u62d2\u7684\u9a71\u52a8\u529b\u3002\u4ed6\u7ee7\u7eed\u524d\u8fdb\uff0c\u7a7f\u8fc7\u4e86\u4e00\u7247\u53c8\u4e00\u7247\u770b\u4f3c\u65e0\u5c3d\u7684\u9ed1\u6697\u68ee\u6797\u3002\u6bcf\u524d\u884c\u4e00\u6b65\uff0c\u5468\u56f4\u7684\u73af\u5883\u4f3c\u4e4e\u90fd\u5728\u53d1\u751f\u53d8\u5316\uff0c\u9634\u5f71\u9010\u6e10\u9000\u53bb\uff0c\u5149\u7ebf\u8d8a\u6765\u8d8a\u660e\u4eae\u3002\n\nKnight\u6765\u5230\u4e86\u4e00\u7247\u5f00\u9614\u5730\uff0c\u4e2d\u5fc3\u6709\u4e00\u5757\u5de8\u5927\u7684\u5ca9\u77f3\uff0c\u5ca9\u77f3\u4e0a\u523b\u7740\u66f4\u52a0\u590d\u6742\u7684\u7b26\u53f7\u3002\u8fd9\u4e9b\u7b26\u53f7\u6563\u53d1\u7740\u6e29\u6696\u7684\u5149\u8292\uff0c\u4f3c\u4e4e\u5728\u7b49\u5f85\u7740\u4ed6\u3002Knight\u8d70\u4e0a\u524d\u53bb\uff0c\u89e6\u6478\u5ca9\u77f3\uff0c\u611f\u53d7\u5230\u4e00\u80a1\u5f3a\u5927\u7684\u80fd\u91cf\u6d8c\u5165\u4f53\u5185\u3002\u4ed6\u7684\u601d\u7eea\u53d8\u5f97\u66f4\u52a0\u6e05\u6670\uff0c\u5bf9\u524d\u65b9\u7684\u9053\u8def\u6709\u4e86\u66f4\u6df1\u7684\u7406\u89e3\u3002\n\n\u5c31\u5728\u8fd9\u65f6\uff0c\u4e00\u53ea\u5de8\u5927\u7684\u9634\u5f71\u7a81\u7136\u4ece\u5ca9\u77f3\u540e\u51fa\u73b0\uff0cKnight\u7acb\u523b\u8b66\u60d5\u8d77\u6765\u3002\u4f46\u4ed6\u5e76\u672a\u9000\u7f29\uff0c\u800c\u662f\u96c6\u4e2d\u7cbe\u795e\uff0c\u51c6\u5907\u9762\u5bf9\u5373\u5c06\u5230\u6765\u7684\u6311\u6218\u3002\u5ca9\u77f3\u4e0a\u7684\u7b26\u53f7\u518d\u6b21\u53d8\u5316\uff0c\u5f62\u6210\u4e86\u4e00\u884c\u65b0\u7684\u6587\u5b57\uff1a\n\n\"\u52c7\u6c14\u4e0e\u667a\u6167\u5e76\u5b58\uff0c\u65b9\u80fd\u901a\u884c\u65e0\u963b\u3002\u201d\n\nKnight\u6df1\u5438\u4e00\u53e3\u6c14\uff0c\u5fc3\u4e2d\u5145\u6ee1\u4e86\u51b3\u5fc3\u3002\u4ed6\u660e\u767d\u4e86\uff0c\u771f\u6b63\u7684\u8bd5\u70bc\u4e0d\u4ec5\u5728\u4e8e\u5916\u754c\u7684\u5a01\u80c1\uff0c\u66f4\u5728\u4e8e\u5185\u5fc3\u7684\u8003\u9a8c\u3002\u4ed6\u5fc5\u987b\u4fdd\u6301\u51b7\u9759\uff0c\u7528\u667a\u6167\u548c\u52c7\u6c14\u514b\u670d\u4e00\u5207\u56f0\u96be\u3002\u4ed6\u5411\u524d\u8d70\u53bb\uff0c\u8fc8\u5411\u4e86\u672a\u77e5\u7684\u65c5\u7a0b\uff0c\u5fc3\u4e2d\u5145\u6ee1\u4e86\u5e0c\u671b\u548c\u52c7\u6c14\u3002"
      },
      {
        "actor": "child",
        "commit_record_index": 129,
        "commit_record_sha256": "138a8f1f7324176da20a7ced393494d8de6555bfe04fad8631849d8b5c9779ab",
        "record_index": 128,
        "record_sha256": "ddc19960a798adc5721979b89b13dc8b5d041c4bec44b3ae553cb5eec766ec65",
        "text": "Knight\u7ee7\u7eed\u4ed6\u7684\u65c5\u7a0b\uff0c\u6bcf\u4e00\u6b65\u90fd\u5145\u6ee1\u4e86\u51b3\u5fc3\u548c\u52c7\u6c14\u3002\u4ed6\u7a7f\u8fc7\u4e86\u4e00\u7247\u53c8\u4e00\u7247\u770b\u4f3c\u65e0\u5c3d\u7684\u9ed1\u6697\u68ee\u6797\uff0c\u6bcf\u524d\u884c\u4e00\u6b65\uff0c\u5468\u56f4\u7684\u73af\u5883\u4f3c\u4e4e\u90fd\u5728\u53d1\u751f\u53d8\u5316\uff0c\u9634\u5f71\u9010\u6e10\u9000\u53bb\uff0c\u5149\u7167\u8d8a\u6765\u8d8a\u660e\u4eae\u3002\u4ed6\u7684\u601d\u7eea\u53d8\u5f97\u66f4\u52a0\u6e05\u6670\uff0c\u5bf9\u524d\u65b9\u7684\u9053\u8def\u6709\u4e86\u66f4\u6df1\u7684\u7406\u89e3\u3002\n\n\u5ca9\u77f3\u4e0a\u7684\u7b26\u53f7\u518d\u6b21\u53d8\u5316\uff0c\u5f62\u6210\u4e86\u4e00\u884c\u65b0\u7684\u6587\u5b57\uff1a\n\n\"\u7a7f\u8fc7\u8bd5\u70bc\u4e4b\u6797\uff0c\u9700\u8c28\u614e\u524d\u884c\uff0c\u6bcf\u4e00\u6b65\u90fd\u81f3\u5173\u91cd\u8981\u3002\u201d\n\nKnight\u77e5\u9053\uff0c\u8fd9\u6bb5\u65c5\u7a0b\u5c06\u5145\u6ee1\u672a\u77e5\u548c\u5371\u9669\uff0c\u4f46\u4ed6\u4e0d\u518d\u611f\u5230\u6050\u60e7\uff0c\u800c\u662f\u5145\u6ee1\u4e86\u671f\u5f85\u3002\u4ed6\u4ed4\u7ec6\u89c2\u5bdf\u7740\u5468\u56f4\u7684\u73af\u5883\uff0c\u6bcf\u4e00\u6b65\u90fd\u5c0f\u5fc3\u7ffc\u7ffc\u3002\u4ed6\u7684\u811a\u6b65\u53d8\u5f97\u66f4\u52a0\u7a33\u5065\uff0c\u6bcf\u4e00\u6b65\u90fd\u663e\u5f97\u5c24\u4e3a\u91cd\u8981\u3002\u4ed6\u611f\u53d7\u5230\u4e86\u4e00\u79cd\u65e0\u5f62\u7684\u529b\u91cf\u5728\u652f\u6301\u7740\u4ed6\uff0c\u8fd9\u79cd\u529b\u91cf\u8ba9\u4ed6\u66f4\u52a0\u575a\u5b9a\u3002\n\n\u7a81\u7136\uff0c\u4e00\u9635\u5fae\u98ce\u5439\u8fc7\uff0c\u5e26\u6765\u4e86\u8fdc\u5904\u7684 Voices\u3002\u8fd9\u4e9b\u58f0\u97f3\u65f6\u800c\u6e05\u6670\uff0c\u65f6\u800c\u6a21\u7cca\uff0c\u4f3c\u4e4e\u5728\u544a\u8bc9\u4ed6\u4e00\u4e9b\u91cd\u8981\u7684\u4fe1\u606f\u3002Knight\u96c6\u4e2d\u7cbe\u795e\uff0c\u8bd5\u56fe\u7406\u89e3\u8fd9\u4e9b\u58f0\u97f3\u7684\u610f\u601d\uff1a\n\n\"\u6ce8\u610f\u56db\u5468\u7684\u9634\u5f71\uff0c\u5b83\u4eec\u53ef\u80fd\u4f1a\u9690\u85cf\u5371\u9669\u3002\u201d\n\nKnight\u62ac\u5934\u671b\u53bb\uff0c\u679c\u7136\u53d1\u73b0\u4e86\u4e00\u4e9b\u5f02\u5e38\u7684\u9634\u5f71\u3002\u4ed6\u8fc5\u901f\u907f\u5f00\u8fd9\u4e9b\u9634\u5f71\uff0c\u7ee7\u7eed\u524d\u884c\u3002\u4ed6\u7684\u53cd\u5e94\u901f\u5ea6\u8d8a\u6765\u8d8a\u5feb\uff0c\u6bcf\u4e00\u6b65\u90fd\u663e\u5f97\u66f4\u52a0\u4ece\u5bb9\u4e0d\u8feb\u3002\u5ca9\u77f3\u4e0a\u7684\u7b26\u53f7\u518d\u6b21\u53d8\u5316\uff0c\u5f62\u6210\u4e86\u4e00\u884c\u65b0\u7684\u6587\u5b57\uff1a\n\n\"\u654f\u6377\u4e0e\u8b66\u89c9\uff0c\u65b9\u80fd\u5316\u9669\u4e3a\u5937\u3002\u201d\n\nKnight\u7684\u5fc3\u4e2d\u5145\u6ee1\u4e86\u611f\u6fc0\uff0c\u4ed6\u77e5\u9053\u8fd9\u4e9b\u7b26\u53f7\u548c\u58f0\u97f3\u90fd\u5728\u6307\u5f15\u7740\u4ed6\uff0c\u5e2e\u52a9\u4ed6\u514b\u670d\u56f0\u96be\u3002\u4ed6\u7ee7\u7eed\u524d\u884c\uff0c\u6bcf\u4e00\u6b65\u90fd\u5145\u6ee1\u4e86\u4fe1\u5fc3\u548c\u52c7\u6c14\u3002\u4ed6\u7684\u65c5\u7a0b\u8fd8\u5f88\u957f\uff0c\u4f46\u4ed6\u7684\u5fc3\u5df2\u7ecf\u51c6\u5907\u597d\u8fce\u63a5\u6240\u6709\u7684\u6311\u6218\u3002\n\nKnight\u611f\u5230\u4e00\u79cd\u83ab\u540d\u7684\u529b\u91cf\u5728\u4e0d\u65ad\u589e\u957f\uff0c\u8fd9\u79cd\u529b\u91cf\u8ba9\u4ed6\u611f\u5230\u65e0\u6bd4\u5f3a\u5927\u3002\u4ed6\u7ee7\u7eed\u524d\u8fdb\uff0c\u5fc3\u4e2d\u5145\u6ee1\u4e86\u5e0c\u671b\u548c\u51b3\u5fc3\u3002\u4e0d\u8fdc\u5904\uff0c\u4ed6\u770b\u5230\u4e86\u4e00\u9053\u5149\u8292\uff0c\u4f3c\u4e4e\u662f\u5728\u53ec\u5524\u7740\u4ed6\u3002Knight\u52a0\u5feb\u4e86\u6b65\u4f10\uff0c\u5411\u90a3\u9053\u5149\u8292\u8d70\u53bb\uff0c\u5fc3\u4e2d\u5145\u6ee1\u4e86\u671f\u5f85\u548c\u52c7\u6c14\u3002"
      },
