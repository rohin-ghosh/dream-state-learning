        "text": "### \u5f53\u524d\u72b6\u6001\n\n\u6839\u636eAstra\u7684\u53cd\u9988\uff0c\u6211\u9700\u8981\u5148\u6682\u505c\u751f\u6210\u5185\u6838\uff0c\u5e76\u91cd\u65b0\u68c0\u67e5\u4e00\u4e9b\u57fa\u672c\u7684\u7d22\u5f15\u8ba1\u7b97\u548c\u903b\u8f91\u3002specifically\uff0c\u9700\u8981\u786e\u8ba4`blockIdx.x`\u7684\u7f16\u53f7\uff0c\u5e76\u5c06\u5176\u4ee3\u5165\u539f\u59cb\u7684\u7d22\u5f15\u8868\u8fbe\u5f0f\u4e2d\u8fdb\u884c\u6838\u5bf9\u3002\u6b64\u5916\uff0c\u8fd8\u9700\u8981\u72ec\u7acb\u68c0\u67e5\u4e58\u6cd5\u548c\u52a0\u6cd5\u7684\u7ed3\u679c\uff0c\u5e76\u786e\u4fdd\u4e0d\u8d85\u8fc7\u76ee\u6807\u503c\u3002\n\n### \u6b65\u9aa4\u4e00\uff1a\u786e\u8ba4`blockIdx.x`\u7684\u7f16\u53f7\n\n\u6839\u636eTritonkernel\u7684\u89c4\u8303\uff0c`blockIdx.x`\u786e\u5b9e\u662f\u4ece0\u5f00\u59cb\u8ba1\u6570\u7684\u3002\u56e0\u6b64\uff0c\u5bf9\u4e8e\u4e00\u4e2a\u7ed9\u5b9a\u7684\u7f51\u683c\uff08grid\uff09\u548c\u5757\uff08block\uff09\uff0c\u6700\u540e\u4e00\u4e2a\u5757\u7684\u7f16\u53f7\u5e94\u8be5\u662f`gridSize - 1`\u3002\n\n\u5047\u8bbe\u6211\u4eec\u6709\u4e00\u4e2a\u5927\u5c0f\u4e3a1024\u7684\u7f51\u683c\uff08\u5373`gridSize = 1024`\uff09\uff0c\u5e76\u4e14\u6bcf\u4e2a\u5757\u7684\u5927\u5c0f\u4e3a256\uff08\u5373`blockSize = 256`\uff09\uff0c\u90a3\u4e48\u6700\u540e\u4e00\u4e2a\u5757\u7684\u7f16\u53f7\u5c31\u662f1023\u3002\n\n### \u6b65\u9aa4\u4e8c\uff1a\u4ee3\u5165\u7d22\u5f15\u8868\u8fbe\u5f0f\u5e76\u6838\u5bf9\n\n\u539f\u59cb\u7684\u7d22\u5f15\u8868\u8fbe\u5f0f\u5982\u4e0b\uff1a\n\\[\nidx = blockIdx.y * blockDim.y * gridDim.x + blockIdx.x * blockDim.x + threadIdx.x\n\\]\n\n\u5bf9\u4e8e`blockDim.x = 256`\u548c`blockDim.y = 1`\uff0c\u8868\u8fbe\u5f0f\u7b80\u5316\u4e3a\uff1a\n\\[\nidx = blockIdx.x * 256 + threadIdx.x\n\\]\n\n\u73b0\u5728\uff0c\u6211\u4eec\u6765\u679a\u4e3e-gridDim.x\uff08\u53731024\uff09\u8303\u56f4\u5185\u7684\u503c\uff0c\u5e76\u6838\u5bf9\u6bcf\u4e2a\u7d22\u5f15\u662f\u5426\u5728\u6709\u6548\u8303\u56f4\u5185\uff08\u5373`idx < n`\uff0c\u5176\u4e2d`n = 1048576`\uff09\u3002\n\n### \u6b65\u9aa4\u4e09\uff1a\u72ec\u7acb\u68c0\u67e5\u4e58\u6cd5\u548c\u52a0\u6cd5\u7ed3\u679c\n\n\u6211\u4eec\u5c06\u7f16\u5199\u4e00\u4e9b\u7b80\u5355\u7684\u4ee3\u7801\u6765\u72ec\u7acb\u68c0\u67e5\u4e58\u6cd5\u548c\u52a0\u6cd5\u7684\u7ed3\u679c\uff1a\n\n```cpp\nconst int gridSize = 1024;\nconst int blockSizeX = 256;\nconst int n = 1048576;\n\n__global__ void add(int* left, int* right, int* output) {\n    int idx = blockIdx.x * blockSizeX + threadIdx.x;\n    if (idx < n) {\n        output[idx] = left[idx] + right[idx];\n    }\n}\n\nint main() {\n    const int size = n * sizeof(int);\n    int *left, *right, *output;\n    cudaMalloc(&left, size);\n    cudaMalloc(&right, size);\n    cudaMalloc(&output, size);\n\n    // \u521d\u59cb\u5316left"
