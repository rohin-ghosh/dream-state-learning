        "record_sha256": "704cfb2f4a7df051257b91b6088775b10eb0e1b73b0efaf5aecebbaac1c6d288",
        "text": "### \u5f53\u524d\u72b6\u6001\n\n\u6839\u636eAstra\u7684\u53cd\u9988\uff0c\u6211\u9700\u8981\u5148\u786e\u4fdd\u5019\u9009\u89e3\u51b3\u65b9\u6848\u7684\u542f\u52a8\u914d\u7f6e\u80fd\u591f\u8986\u76d6\u6240\u6709\u5143\u7d20\uff0c\u5e76\u68c0\u67e5\u53c2\u6570\u987a\u5e8f\u662f\u5426\u6b63\u786e\u3002\u7136\u540e\uff0c\u9700\u8981\u627e\u5230\u4e00\u79cd\u65b9\u6cd5\u6765\u89c2\u5bdf\u7ebf\u7a0b\u7d22\u5f15\uff0c\u56e0\u4e3a\u4ec5\u7f16\u5199\u4ee3\u7801\u662f\u4e0d\u591f\u7684\uff0c\u8fd8\u9700\u8981\u80fd\u591f\u770b\u5230\u5b9e\u9645\u7684\u7ebf\u7a0b\u7d22\u5f15\u503c\u3002\n\n### \u68c0\u67e5\u542f\u52a8\u914d\u7f6e\u548c\u53c2\u6570\u987a\u5e8f\n\n\u9996\u5148\uff0c\u8ba9\u6211\u4eec\u56de\u987e\u4e00\u4e0bKernel\u7684launch\u4ee3\u7801\uff1a\n\n```cpp\ndim3 grid(1024);\ndim3 block\uff08128);\nkernel<<<grid, block>>>(output, left, right), 1048576);\n```\n\n\u9700\u8981\u786e\u4fdd\u8fd9\u4e2a\u542f\u52a8\u914d\u7f6e\u786e\u5b9e\u8986\u76d6\u4e86\u6240\u6709\u7684\u5143\u7d20\uff0c\u5e76\u4e14\u53c2\u6570\u987a\u5e8f\u6b63\u786e\u3002\n\n1. **Grid\u548cBlock\u7684\u5927\u5c0f**\uff1a\n   - Grid Size: 1024\n   - Block Size\uff1a128\n\n2. **\u53c2\u6570\u987a\u5e8f**\uff1a\n   - output\n   - left\n   - right\n   - \u5143\u7d20\u6570\u91cf: 1048576\n\n\u63a5\u4e0b\u6765\uff0c\u6211\u4eec\u6765\u68c0\u67e5\u5982\u4f55\u89c2\u5bdf\u7ebf\u7a0b\u7d22\u5f15\u3002\u5728\u4e4b\u524d\u7684\u4ee3\u7801\u4e2d\uff0c\u6211\u4eec\u6ca1\u6709\u5305\u542b\u4efb\u4f55\u7528\u4e8e\u8f93\u51fa\u7ebf\u7a0b\u7d22\u5f15\u503c\u7684\u90e8\u5206\u3002\u4e3a\u4e86\u80fd\u591f\u89c2\u5bdf\u5230\u7ebf\u7a0b\u7d22\u5f15\uff0c\u6211\u4eec\u9700\u8981\u5728kernel\u51fd\u6570\u4f53\u5185\u6dfb\u52a0\u4e00\u4e9bprintStats\u7684\u529f\u80fd\u3002\n\n### \u4fee\u6539Kernel\u4ee3\u7801\n\n\u6211\u4eec\u5728kernel\u51fd\u6570\u4f53\u5185\u6dfb\u52a0\u6253\u5370\u7ebf\u7a0b\u7d22\u5f15\u7684\u4ee3\u7801\uff1a\n\n```cpp\n__global__ void kernel(float* output, const float* left, const float* right, int n) {\n    int idx = blockIdx.x * blockDim.x + threadIdx.x;\n    if (idx < n) {\n        output[idx] = left[idx] + right[idx];\n    }\n    __syncthreads();\n\n    // \u6253\u5370\u7ebf\u7a0b\u7d22\u5f15\n    if (threadIdx.x == 0 && blockIdx.x % 10 == 0) { // \u6bcf10\u4e2ablock\u6253\u5370\u4e00\u6b21\n        printf(\"Block %d: \", blockIdx.x);\n        for (int j = 0; j < blockDim.x; ++j) {\n            printf(\"%d \", threadIdx.y * gridDim.x * blockDim.x + threadIdx.x);\n        }\n        printf(\"\\n\");\n    }\n}\n```\n\n### \u8fd0\u884c\u68c0\u67e5\n\n\u73b0\u5728\uff0c\u6211\u4eec\u6765\u7f16\u8bd1\u5e76\u8fd0\u884c\u8fd9\u4e2a\u4fee\u6539\u540e\u7684\u5185\u6838\uff0c\u770b\u770b\u662f\u5426\u80fd\u591f\u770b\u5230\u7ebf\u7a0b\u7d22\u5f15\u7684\u8f93\u51fa\u3002\n\n```cpp\n# \u7f16\u8bd1\u5185\u6838\n!nvcc -o add_kernel add_kernel.cpp -Xcompiler - fPIC\n\n# \u8fd0\u884c\u5185\u6838\ndim3 grid("
