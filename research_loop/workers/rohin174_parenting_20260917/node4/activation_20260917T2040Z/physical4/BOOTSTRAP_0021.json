        "text": "### \u5185\u6838\u8bbe\u8ba1\u4e0e\u68c0\u67e5\n\n\u9996\u5148\uff0c\u6211\u4eec\u6765\u8bbe\u8ba1\u4e00\u4e2aTriton\u5185\u6838\uff0c\u7528\u4e8e\u4e24\u4e2a\u8fde\u7eed\u7684float32\u5411\u91cf\u7684\u5143\u7d20-wise\u76f8\u52a0\u3002\u6211\u4eec\u5c06\u4f1a\u8ba1\u7b97\u6bcf\u4e2a\u5757\uff08block\uff09\u548c\u7f51\u683c\uff08grid\uff09\u4e2d\u7684\u7d22\u5f15\uff0c\u5e76\u786e\u4fdd\u8986\u76d6\u6240\u6709\u7684\u5143\u7d20\u3002\n\n#### \u5185\u6838\u51fd\u6570\n\n```cpp\n__global__ void add_kernel(float* output, const float* left, const const float* right, int n) {\n    int idx = blockIdx.x *\n              blockDim.x + threadIdx.x;\n    if (idx < n) {\n       (output[idx] = left[idx] + right[idx]);\n    }\n}\n\n// \u8f85\u52a9\u51fd\u6570\u6765\u8ba1\u7b97\u6700\u5927\u7d22\u5f15\nintcalculate_max_index(int grid_size, int block_size, int n) {\n    int max_idx = 0;\n    for (int block = \uff10\uff1b block < grid_size; block++) {\n        max_idx = std::max[max_idx, block * block_size + block_size - 1];\n    }\n    return max_idx;\n}\n\nint main() {\n    const int test_size = 1048576;\n    const int grid_size= 1024;\n    const int block_size = 12\uff18;\n\n    float *left, *right, *output;\n    // \u5047\u8bbe left, right, output \u5df2\u7ecf\u6b63\u786e\u5206\u914d\u548c\u521d\u59cb\u5316\n\n    // \ufffd \u8c03\u7528\u5185\u6838\u51fd\u6570\n    add_kernel<<<grid_size, block_size>>>(output, left, right, test_size);\n\n    // \u8ba1\u7b97\u6700\u5927\u7d22\u5f15\n    int max_idx =calculate_max_index(grid_size, block_size, test_size);\n\n    // \u68c0\u67e5\u6700\u5927\u7d22\u5f15\u662f\u5426\u7b49\u4e8e n - 1\n    if (max_idx == test_size - 1) {\n        std::cout == \"\u8986\u76d6\u6240\u6709\u5143\u7d20\"\\stdnl;\n    } else {\n        std cout << \"\u672a\u8986\u76d6\u6240\u6709\u5143\u7d20\u3002\\stdnl;\n    }\n\n    return 0;\n}\n```\n\n#### \u68c0\u67e5\u903b\u8f91\n\n1. **\u7d22\u5f15\u8ba1\u7b97**\uff1a\n   - \u6211\u4eec\u4f7f\u7528 `idx = blockIdx.x * blockDim.x + threadIdx.x` \u6765\u8ba1\u7b97\u6bcf\u4e2a\u7ebf\u7a0b\u7684\u7d22\u5f15\u3002\n   - \u786e\u4fdd `idx` \u4e0d\u8d85\u8fc7 `n`\u3002\n\n2. **\u6700\u5927\u7d22\u5f15\u8ba1\u7b97**\uff1a\n   - \u6211\u4eec\u7f16\u5199\u4e86\u4e00\u4e2a\u51fd\u6570\u6765\u8ba1\u7b97\u7ed9\u5b9a\u7f51\u683c\u5927\u5c0f\u548c\u5757\u5927\u5c0f\u65f6\u7684\u6700\u5927\u7d22\u5f15\u3002\n   - \u9a8c\u8bc1\u6700\u5927\u7d22\u5f15\u662f\u5426\u7b49\u4e8e `n - 1`\uff0c"
