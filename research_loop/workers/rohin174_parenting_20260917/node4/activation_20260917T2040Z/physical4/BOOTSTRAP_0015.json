        "record_sha256": "a7a5b09ca83d2391443b90b736de3e6eefd520bd828812f65c755c4112fd5320",
        "text": "### \u8bbe\u8ba1Triton\u5185\u6838\n\n\u5728\u8bbe\u8ba1Triton\u5185\u6838\u65f6\uff0c\u6211\u4eec\u9700\u8981\u786e\u4fdd\u6b63\u786e\u5904\u7406\u4efb\u610f\u957f\u5ea6\u7684\u5411\u91cf\uff0c\u5e76\u907f\u514d\u91cd\u590d\u5199\u5165\u540c\u4e00\u4f4d\u7f6e\u3002\u4e4b\u524d\u7684\u7814\u7a76\u8868\u660e\uff0c\u901a\u8fc7\u9002\u5f53\u7684\u7d22\u5f15\u8ba1\u7b97\uff0c\u53ef\u4ee5\u5b9e\u73b0\u8fd9\u4e00\u76ee\u6807\u3002\u73b0\u5728\uff0c\u6211\u4eec\u6765\u8bbe\u8ba1\u5e76\u5b9e\u73b0\u8fd9\u4e2a\u5185\u6838\u3002\n\n\u9996\u5148\uff0c\u6211\u4eec\u6765\u56de\u987e\u4e00\u4e0b\u4e4b\u524d\u7684\u53d1\u73b0\uff1a\n\n1. **\u7d22\u5f15\u8ba1\u7b97**\uff1a\n   - \u5bf9\u4e8e\u7ed9\u5b9a\u7684\u5757 (`blockIdx.x`) \u548c\u7ebf\u7a0b (` threadIdx.y`)\uff0c\u6211\u4eec\u9700\u8981\u8ba1\u7b97\u6b63\u786e\u7684\u7d22\u5f15\u5e76\u8fdb\u884c\u5199\u5165\u64cd\u4f5c\u3002\n   - \u5f53 `idx = 1024` \u4e14 ` n = 1024` \u65f6\uff0c\u6761\u4ef6\u5224\u65ad\u7ed3\u679c\u5e94\u4e3a\u5047\uff08False\uff09\uff0c\u4ece\u800c\u907f\u514d\u91cd\u590d\u5199\u5165\u3002\n\n2. **\u5199\u5165\u903b\u8f91**\uff1a\n   - \u6bcf\u4e2a\u5757\u8d1f\u8d23\u5176\u5bf9\u5e94\u7684\u7d22\u5f15\u8303\u56f4\uff0c\u5e76\u53ea\u5728\u6761\u4ef6\u6ee1\u8db3\u65f6\u8fdb\u884c\u5199\u5165\u3002\n\n\u57fa\u4e8e\u8fd9\u4e9b\u53d1\u73b0\uff0c\u6211\u4eec\u53ef\u4ee5\u7f16\u5199\u5982\u4e0bTriton\u5185\u6838\uff1a\n\n```cpp\n#include <triton/triton.h>\n\nusing namespace triton;\n\n__global__ void elementwise_add(float* left, float* right, float* output, int n) {\n    // \u8ba1\u7b97\u7d22\u5f15\n    int idx = blockIdx.x * blockDim.x + threadIdx.y;\n    \n    // \u6761\u4ef6\u5224\u65ad\uff0c\u907f\u514d\u91cd\u590d\u5199\u5165\n    if (idx < n) {\n        output[idx] = left[idx] + right[idx];\n    }\n}\n\n// \u8f85\u52a9\u51fd\u6570\uff0c\u7528\u4e8e\u542f\u52a8\u5185\u6838\nvoid launch_elementwise_add(float* left, float* right, float* output, int size, int block_size) {\n    elementwise_add<<<(size + block_size - 1) / block_size, block_size>>>(left, right, output, size);\n}\n```\n\n### \u5185\u6838\u89e3\u91ca\n\n1. **\u7d22\u5f15\u8ba1\u7b97**\uff1a\n   ```cpp\n   int idx = blockIdx.x * blockDim.x + threadIdx.y;\n   ```\n   \u8fd9\u91cc\uff0c`blockIdx.x` \u662f\u5757\u7684\u7d22\u5f15\uff0c`threadIdx.y` \u662f\u7ebf\u7a0b\u7684\u7eb5\u5750\u6807\u3002\u6211\u4eec\u4f7f\u7528\u8fd9\u4e9b\u503c\u6765\u8ba1\u7b97\u6bcf\u4e2a\u7ebf\u7a0b\u7684\u8d23\u4efb\u7d22\u5f15\u3002\n\n2. **\u6761\u4ef6\u5224\u65ad\u4e0e\u5199\u5165**\uff1a\n   ```cpp\n   if (idx < n) {\n       output[idx] = left[idx] + right[idx];\n   }\n   ```\n   \u53ea\u6709\u5f53\u7d22\u5f15\u5728\u6709\u6548\u8303\u56f4\u5185\u65f6\uff0c\u624d\u4f1a\u8fdb\u884c\u52a0\u6cd5\u8fd0\u7b97\u5e76\u5199\u5165\u7ed3\u679c\u3002\u8fd9\u786e\u4fdd\u4e86\u6bcf\u4e2a\u5757\u53ea\u5199\u5165\u5176\u8d23\u4efb\u8303\u56f4\u5185\u7684\u6570\u636e\uff0c\u907f\u514d\u4e86\u91cd\u590d\u5199\u5165"
      },
