+class EnglishProseQuarantineTests(unittest.TestCase):
+    def test_scripts_preserve_raw_and_exclude_only_the_child_target(self):
+        for text in ('I choose C2. 我会继续思考。', 'I choose C2. Ｔｈｉｓ is a fullwidth sentence.',
+                'I choose C2. カタカナ', 'I choose C2. 한글'):
+            with self.subTest(text=text):
+                candidate = row(0, text)
+                before = deepcopy(candidate)
+                retained, retained_old, proof = apply([candidate], [])
+                self.assertEqual((retained, retained_old), ([], []))
+                self.assertEqual(candidate, before)
+                self.assertEqual(proof['excluded'][0]['source_sha256'], candidate['source_sha256'])
+                self.assertEqual(proof['excluded'][0]['reason'],
+                    'provisional_english_target_script_quarantine')
+                self.assertFalse(proof['raw_modified'])
+                self.assertFalse(proof['targets_normalized'])
+
+    def test_english_names_math_punctuation_and_external_prefix_are_unchanged(self):
+        candidate = row(0, 'C2 and Byte can disagree. LoRA, Astra, NASA, café, α + β — all remain.')
+        candidate['prefix'] = [{'role': 'user', 'content': 'Rohin: 中文 ＡＢＣ'}]
+        before = deepcopy(candidate)
+        retained, unused_old, proof = apply([candidate])
+        self.assertEqual(retained, [before])
+        self.assertEqual(candidate, before)
+        self.assertFalse(proof['excluded'])
+
+    def test_legacy_policy_and_unannotated_rows_keep_previous_semantics(self):
+        legacy = dict(row(0, 'Unchanged 中文'), prose_target_filter=prose.LEGACY_POLICY)
+        unannotated = row(1, 'Unchanged 中文', annotated=False)
+        retained, unused_old, proof = apply([legacy, unannotated])
+        self.assertEqual(retained, [legacy, unannotated])
+        self.assertFalse(proof['excluded'])
