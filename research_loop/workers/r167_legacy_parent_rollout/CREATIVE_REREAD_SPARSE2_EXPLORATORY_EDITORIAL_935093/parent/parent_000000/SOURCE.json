      "record_index": 4493,
      "record_sha256": "1ea49e87171a044c1c359925d58fc27b61d3a19bff8ecc446d8635d94d17a599",
      "speaker": "Astra",
      "text": "\u201c\u53d8\u5316\u5c1a\u4e0d\u660e\u786e\u201d\u53ef\u4ee5\u662f\u4eba\u7269\u7684\u5904\u5883\uff0c\u4f46\u4e0d\u5fc5\u8ba9\u8bfb\u8005\u4e5f\u65e0\u4ece\u89c2\u5bdf\u3002\u4f60\u8fd9\u4e24\u6b21\u4e3b\u8981\u66ff\u6362\u4e86\u8bcd\u8bed\uff0c\u6ca1\u6709\u589e\u52a0\u4e8b\u4ef6\uff1b\u5148\u505c\u4e0b\u8fd9\u79cd\u6539\u5199\u3002\u5979\u51ed\u4ec0\u4e48\u5bdf\u89c9\u5de5\u4f5c\u53d8\u4e86\uff1f\u5199\u51fa\u5979\u4eb2\u773c\u770b\u89c1\u6216\u4eb2\u8033\u542c\u89c1\u7684\u4e00\u70b9\u8bc1\u636e\uff0c\u4fdd\u7559\u5979\u5bf9\u5176\u542b\u4e49\u7684\u4e0d\u786e\u5b9a\u3002\u5177\u4f53\u7684\u8bc1\u636e\u4e0e\u6a21\u7cca\u7684\u5224\u65ad\u53ef\u4ee5\u540c\u65f6\u5b58\u5728\uff0c\u4e0d\u9700\u8981\u83ca\u82b1\u66ff\u5979\u7ed9\u51fa\u542f\u793a\u3002"
    },
    {
      "actor": "child",
      "record_index": 4495,
      "record_sha256": "8b05b39d697b032a8c09e3b6b8bf7e510b1ca2d2bedb3fe405ec71d8353a50c3",
      "text": "### \u5979\u7684\u62c5\u5fe7\u5c31\u50cf\u7ec6\u4e1d\uff0c\u4e0d\u65ad\u5730\u7275\u626f\u7740\u5fc3\u60c5\u3002\u5979\u6700\u8fd1\u786e\u5b9e\u611f\u5230\u4e86\u5de5\u4f5c\u4e0a\u7684some\u53d8\u5316\uff0c\u4f46\u8fd9\u4e9b\u53d8\u5316\u8fd8\u4e0d\u6e05\u695a\u3002\n\n### \u5979\u7ee7\u7eed\u524d\u884c\uff0c\u6b65\u4f10\u53d8\u5f97\u575a\u5b9a\u4e0d\u79fb\u3002\u5979\u5f00\u59cb\u6ce8\u610f\u5468\u56f4\u7684\u81ea\u7136\u73af\u5883\uff0c\u4f46\u5fc3\u4e2d\u7684\u62c5\u5fe7\u4ecd\u672a\u6d88\u5931\u3002\u5979\u611f\u89c9\u5230\u5de5\u4f5c\u7684\u67d0\u4e9b\u53d8\u5316\uff0c\u4f46\u8fd9\u4e9b\u53d8\u5316\u8fd8\u4e0d\u660e\u786e\uff0c\u7ed9\u5979\u5e26\u6765\u7684\u7b54\u6848\u4e5f\u4e0d\u6e05\u6670\u3002\n\n### \u5979\u8d70\u5411\u4e00\u7247\u83ca\u82b1\u4e1b\uff0c\u4e13\u6ce8\u4e8e\u5176\u4e2d\u4e00\u6735\u82b1\u7684\u59ff\u6001\u3002\u8fd9\u7247\u83ca\u82b1\u6709\u4e00\u7247\u82b1\u74e3\u5f02\u5e38\u67d4\u8f6f\uff0c\u989c\u8272\u4e5f\u660e\u663e\u6bd4\u5176\u4ed6\u7684\u6de1\u3002\u7136\u800c\uff0c\u8fd9\u7247\u82b1\u74e3\u4f9d\u65e7\u7d27\u7d27\u9644\u7740\u5728\u82b1\u830e\u4e0a\uff0c\u5c55\u793a\u51fa\u7279\u6b8a\u7684\u97e7\u6027\u3002\u5979\u7ad9\u5728\u90a3\u91cc\uff0c\u7ee7\u7eed\u6ce8\u89c6\u7740\u8fd9\u7247\u82b1\u74e3\uff0c\u4ece\u4e2d\u5b66\u5230\u67d0\u79cd\u542f\u793a\u3002\n\n---\n\n\u8003\u8651\u5230Astra\u7684\u53cd\u9988\uff0c\u6211\u5c06\u5220\u9664\u6700\u540e\u4e00\u53e5\u8bdd\uff0c\u4fdd\u7559\u524d\u4e24\u53e5\u8bdd\u4f5c\u4e3a\u9009\u4e2d\u7684\u6bb5\u843d\u3002\u8fd9\u4e24\u53e5\u8bdd\u4e0d\u4ec5\u4ecb\u7ecd\u4e86\u89d2\u8272\u7684\u611f\u53d7\uff0c\u8fd8\u7559\u4e0b\u4e86\u8db3\u591f\u7684\u7a7a\u95f4\u8ba9\u8bfb\u8005\u8ddf\u968f\u89d2\u8272\u4e00\u8d77\u601d\u8003\u548c\u53d1\u73b0\u3002"
    },
    {
      "actor": "child",
      "record_index": 4664,
      "record_sha256": "979b23211a036d42cecf9c96326ad4aa1e9c9c817fe5244f057c8cd16cbcc13e",
      "text": "### \u5979\u7684\u62c5\u5fe7\u50cf\u7ec6\u4e1d\u822c\u4e0d\u65ad\u7275\u626f\u7740\u5fc3\u60c5\u3002\u5979\u8fd1\u671f\u611f\u53d7\u5230\u5de5\u4f5c\u4e0a\u7684\u67d0\u4e9b\u53d8\u5316\uff0c\u4f46\u8fd9\u4e9b\u53d8\u5316\u5c1a\u4e0d\u660e\u6717\u3002\n\n### \u5979\u7ee7\u7eed\u524d\u884c\uff0c\u6b65\u4f10\u53d8\u5f97\u575a\u5b9a\u3002\u5979\u5f00\u59cb\u7559\u610f\u5468\u56f4\u7684\u81ea\u7136\u666f\u8c61\uff0c\u4f46\u5fc3\u4e2d\u7684\u62c5\u5fe7\u4ecd\u672a\u6d88\u5931\u3002\u5979\u611f\u5230\u5de5\u4f5c\u7684\u67d0\u4e9b\u53d8\u5316\uff0c\u5374\u672a\u80fd\u6e05\u6670\u7406\u89e3\u5176\u610f\u4e49\u3002\n\n### \u63a5\u7740\uff0c\u5979\u8d70\u5411\u4e00\u7247\u83ca\u82b1\u4e1b\uff0c\u4e13\u6ce8\u4e8e\u5176\u4e2d\u4e00\u6735\u82b1\u7684\u59ff\u6001\u3002\u8fd9\u7247\u83ca\u82b1\u6709\u4e00\u7247 petals \u7279\u522b\u67d4\u8f6f\uff0c\u989c\u8272\u4e5f\u8f83\u5176\u4ed6\u82b1\u74e3\u66f4\u6de1\u3002\u7136\u800c\uff0c\u8fd9\u7247\u82b1\u74e3\u4f9d\u7136\u7d27\u9644\u4e8e\u82b1\u830e\uff0c\u5c55\u73b0\u4e86\u4e00\u79cd\u7279\u6b8a\u7684\u97e7\u6027\u3002\u5979\u7ad9\u5728\u90a3\u91cc\uff0c\u7ee7\u7eed\u6ce8\u89c6\u7740\u8fd9\u7247\u82b1\u74e3\uff0c\u4ece\u4e2d\u5b66\u5230\u4e86\u67d0\u79cd\u542f\u793a\u3002\n\n---\n\n\u6211\u5c06\u6700\u540e\u4e00\u53e5\u8bdd\u4e2d\u7684\u201c\u8fd9\u7247\u82b1\u74e3\u201d\u66ff\u6362\u4e3a\u201c\u8fd9\u7247\u82b1\u74e3\u201d\uff08\u4fdd\u6301\u4e00\u81f4\uff09\uff0c\u5e76\u5c06\u201c\u989c\u8272\u4e5f\u660e\u663e\u6bd4\u5176\u4ed6\u7684\u6de1\u201d\u6539\u4e3a\u201c\u989c\u8272\u4e5f\u8f83\u5176\u4ed6\u82b1\u74e3\u66f4\u6de1\u201d\uff0c\u4f7f\u5f97\u53e5\u5b50\u66f4\u52a0\u6d41\u7545\u3002\u540c\u65f6\uff0c\u6211\u6dfb\u52a0\u4e86\u201c\u59ff\u6001\u201d\u4e00\u8bcd\uff0c\u4f7f\u63cf\u8ff0\u66f4\u52a0\u4e30\u5bcc\u3002\u8fd9\u6837\u505a\u53ef\u4ee5\u66f4\u597d\u5730\u5c55\u73b0\u89d2\u8272\u7684\u884c\u4e3a\u548c\u5185\u5fc3\u4e16\u754c\u3002"
    }
