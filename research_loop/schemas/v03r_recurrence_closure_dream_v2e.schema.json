    {"type":"object","additionalProperties":false,"required":["op","memory_alias","canonical_text","citations"],"properties":{"op":{"const":"REINFORCE"},"memory_alias":{"pattern":"^M[0-9]+$"},"canonical_text":{"$ref":"#/$defs/text192"},"citations":{"$ref":"#/$defs/citations"}}},
    {"type":"object","additionalProperties":false,"required":["op","memory_alias","replacement_kind","left_or_entity_alias","relation_label","right_alias","connector_alias","polarity","canonical_text","citations"],"properties":{"op":{"const":"SUPERSEDE"},"memory_alias":{"pattern":"^M[0-9]+$"},"replacement_kind":{"enum":["CONCEPT","EDGE"]},"left_or_entity_alias":{"$ref":"#/$defs/entityMemoryAlias"},"relation_label":{"oneOf":[{"$ref":"#/$defs/text64"},{"type":"null"}]},"right_alias":{"oneOf":[{"$ref":"#/$defs/entityMemoryAlias"},{"type":"null"}]},"connector_alias":{"oneOf":[{"pattern":"^C[0-9]+$"},{"type":"null"}]},"polarity":{"oneOf":[{"$ref":"#/$defs/polarity"},{"type":"null"}]},"canonical_text":{"$ref":"#/$defs/text192"},"citations":{"$ref":"#/$defs/citations"}}}
