    {"type":"object","additionalProperties":false,"required":["op","new_alias","entity_alias","concept_type","canonical_text","citations"],"properties":{"op":{"const":"CREATE_CONCEPT"},"new_alias":{"const":"N0"},"entity_alias":{"pattern":"^X[0-9]+$"},"concept_type":{"$ref":"#/$defs/text64"},"canonical_text":{"$ref":"#/$defs/text192"},"citations":{"$ref":"#/$defs/citations"}}},
