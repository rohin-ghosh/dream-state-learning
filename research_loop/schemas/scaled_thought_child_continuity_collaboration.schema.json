{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "shared_synthesis",
    "scaled_think",
    "sleep_eligibility",
    "child_continuity",
    "adaptive_parent",
    "pretrained_vs_taught",
    "current_evidence",
    "high_dimensional_questions",
    "disagreements",
    "required_changes",
    "authority_boundary"
  ],
  "properties": {
    "verdict": {"enum": ["align", "revise", "escalate"]},
    "shared_synthesis": {"type": "string", "minLength": 1},
    "scaled_think": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "sleep_eligibility": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "child_continuity": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "adaptive_parent": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "pretrained_vs_taught": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "current_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "high_dimensional_questions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "disagreements": {"type": "array", "items": {"type": "string"}},
    "required_changes": {"type": "array", "items": {"type": "string"}},
    "authority_boundary": {"type": "string", "minLength": 1}
  }
}
