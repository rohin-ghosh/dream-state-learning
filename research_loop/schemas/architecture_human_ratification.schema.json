{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_type", "ratification_id", "change_id", "state",
    "consensus_sha256", "human_required_state_sha256", "ratifier",
    "authority_statement", "decision_statement", "decided_at", "authorized_scope",
    "forbidden_scope", "authorization_evidence", "implementation_authorized"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_type": {"const": "architecture_human_ratification"},
    "ratification_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "change_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "state": {"const": "human_approved"},
    "consensus_sha256": {"$ref": "#/$defs/hash"},
    "human_required_state_sha256": {"$ref": "#/$defs/hash"},
    "ratifier": {"type": "string", "minLength": 1},
    "authority_statement": {"type": "string", "minLength": 1},
    "decision_statement": {"type": "string", "minLength": 1},
    "decided_at": {"type": "string", "minLength": 1},
    "authorized_scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "forbidden_scope": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "authorization_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "excerpt"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"},
        "excerpt": {"type": "string", "minLength": 1}
      }
    },
    "implementation_authorized": {"const": true}
  }
}
