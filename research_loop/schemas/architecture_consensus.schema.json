{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_type", "consensus_id", "change_id", "state",
    "architecture_change_sha256", "interpretation_hashes", "critique_sha256",
    "recommendation", "agreements", "disagreements", "concern_dispositions",
    "upstream_disagreement_dispositions", "acceptance_test_dispositions",
    "human_decision"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_type": {"const": "architecture_consensus"},
    "consensus_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "change_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "state": {"const": "human_required"},
    "architecture_change_sha256": {"$ref": "#/$defs/hash"},
    "interpretation_hashes": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["interpretation_id", "sha256"],
        "properties": {
          "interpretation_id": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/hash"}
        }
      }
    },
    "critique_sha256": {"$ref": "#/$defs/hash"},
    "recommendation": {"enum": ["proceed_to_implementation", "rework", "reject", "defer"]},
    "agreements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "disagreements": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["disagreement_id", "sources", "issue", "positions", "resolution"],
        "properties": {
          "disagreement_id": {"type": "string", "minLength": 1},
          "sources": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "issue": {"type": "string", "minLength": 1},
          "positions": {
            "type": "array", "minItems": 2,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["actor", "position"],
              "properties": {
                "actor": {"type": "string", "minLength": 1},
                "position": {"type": "string", "minLength": 1}
              }
            }
          },
          "resolution": {
            "type": "object", "additionalProperties": false,
            "required": ["status", "rationale", "selected_position", "required_change", "acceptance_test_ids"],
            "properties": {
              "status": {"enum": ["resolved", "unresolved"]},
              "rationale": {"type": "string", "minLength": 1},
              "selected_position": {"type": "string"},
              "required_change": {"type": "string"},
              "acceptance_test_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
            }
          }
        }
      }
    },
    "concern_dispositions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["concern_id", "status", "rationale", "resolution_id", "required_change"],
        "properties": {
          "concern_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["accepted", "rejected", "partially_accepted", "unresolved"]},
          "rationale": {"type": "string", "minLength": 1},
          "resolution_id": {"type": "string"},
          "required_change": {"type": "string"}
        }
      }
    },
    "upstream_disagreement_dispositions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["disagreement_id", "status", "rationale", "resolution_id"],
        "properties": {
          "disagreement_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["accepted", "rejected", "partially_accepted", "unresolved"]},
          "rationale": {"type": "string", "minLength": 1},
          "resolution_id": {"type": "string"}
        }
      }
    },
    "acceptance_test_dispositions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["test_id", "status", "rationale", "replacement_test_id"],
        "properties": {
          "test_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["retained", "modified", "removed"]},
          "rationale": {"type": "string", "minLength": 1},
          "replacement_test_id": {"type": "string"}
        }
      }
    },
    "human_decision": {
      "type": "object", "additionalProperties": false,
      "required": ["required", "status", "questions", "implementation_forbidden"],
      "properties": {
        "required": {"const": true},
        "status": {"const": "pending"},
        "questions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "implementation_forbidden": {"const": true}
      }
    }
  }
}
