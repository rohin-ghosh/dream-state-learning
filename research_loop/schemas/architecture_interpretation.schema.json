{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "context_file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "purpose"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"},
        "purpose": {"type": "string", "minLength": 1}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_type", "interpretation_id", "change_id", "perspective", "state",
    "architecture_change_sha256", "context_files", "system_thesis_interpretation",
    "graph_delta_interpretation", "loop_delta_interpretation",
    "claim_delta_interpretation", "visibility_matrix_interpretation",
    "acceptance_test_ids_addressed", "acceptance_test_interpretation",
    "assumptions", "ambiguities", "disagreements_with_proposal", "human_boundary"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_type": {"const": "architecture_interpretation"},
    "interpretation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "change_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "perspective": {"enum": ["systems", "benchmark", "scientific", "implementation", "independent"]},
    "state": {"const": "interpreted"},
    "architecture_change_sha256": {"$ref": "#/$defs/hash"},
    "context_files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/context_file"}},
    "system_thesis_interpretation": {"type": "string", "minLength": 1},
    "graph_delta_interpretation": {"type": "string", "minLength": 1},
    "loop_delta_interpretation": {"type": "string", "minLength": 1},
    "claim_delta_interpretation": {"type": "string", "minLength": 1},
    "visibility_matrix_interpretation": {"type": "string", "minLength": 1},
    "acceptance_test_ids_addressed": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "acceptance_test_interpretation": {"type": "string", "minLength": 1},
    "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "ambiguities": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["ambiguity_id", "question", "impact"],
        "properties": {
          "ambiguity_id": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "impact": {"type": "string", "minLength": 1}
        }
      }
    },
    "disagreements_with_proposal": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["disagreement_id", "statement", "rationale", "proposed_resolution"],
        "properties": {
          "disagreement_id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 1},
          "proposed_resolution": {"type": "string", "minLength": 1}
        }
      }
    },
    "human_boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["required", "open_questions"],
      "properties": {
        "required": {"const": true},
        "open_questions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
