{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper1-v03r-canary-dream-operation-v1a",
  "oneOf": [
    {"type": "object", "additionalProperties": false, "required": ["op", "reason"], "properties": {"op": {"const": "PASS"}, "reason": {"$ref": "#/$defs/text"}}},
    {"type": "object", "additionalProperties": false, "required": ["op", "kind", "fields", "citations", "prediction", "confidence"], "properties": {"op": {"const": "CREATE"}, "kind": {"enum": ["ROLE_EQUIV", "CAUSAL_JOIN", "ROLE_APPLICATION"]}, "fields": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"$ref": "#/$defs/atom"}}, "citations": {"type": "array", "minItems": 2, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?:E|M)[0-9]+$"}}, "prediction": {"$ref": "#/$defs/text"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}}
