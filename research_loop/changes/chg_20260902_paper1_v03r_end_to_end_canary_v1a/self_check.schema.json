{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper1-v03r-canary-self-check-v1a",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "support_basis", "premise_ids", "counterevidence_ids", "prediction", "confidence", "reason"],
  "properties": {
    "verdict": {"enum": ["SUPPORTED", "CONTRADICTED", "UNRESOLVED"]},
    "support_basis": {"enum": ["NONE", "SELF_REVIEW_SAME_EVIDENCE", "INDEPENDENT_CORROBORATION"]},
    "premise_ids": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?:E|M)[0-9]+$"}},
    "counterevidence_ids": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?:E|M)[0-9]+$"}},
    "prediction": {"type": "string", "minLength": 1, "maxLength": 192, "pattern": "^[ -!#-\\[\\]-~]+$"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "reason": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[ -!#-\\[\\]-~]+$"}
  }
}
