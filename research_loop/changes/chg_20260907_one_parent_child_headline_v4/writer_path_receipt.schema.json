{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dream-state:one-parent-v4:writer-path-receipt",
  "title": "One-parent v4 writer-path receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_hash", "root_id", "service", "arm", "cycle_or_cut", "slot_id", "target_type", "source_event_id", "committed_dispatch_id", "eligibility", "admission_route", "row_class", "rejection_code", "response_tokens", "attended_tokens", "exposures", "optimizer_positions", "fit_id", "candidate_adapter_sha256", "prior_adapter_sha256", "fit_state", "mount_state", "rollback_state", "adapter_off_probe_id", "strict_behavior_probe_id", "later_probe_id"],
  "properties": {
    "schema_version": {"const": 1},
    "protocol_hash": {"$ref": "#/$defs/sha256"},
    "root_id": {"type": "string", "minLength": 1},
    "service": {"enum": ["P0", "P1", "U0", "U1", "R0", "P_CHILDHOOD", "U_CHILDHOOD"]},
    "arm": {"enum": ["P", "U", "R"]},
    "cycle_or_cut": {"enum": ["C1", "C2", "C3", "T16", "T32", "T48"]},
    "slot_id": {"type": "string", "minLength": 1},
    "target_type": {"enum": ["THINK_TO_ACT", "DREAM_STATE"]},
    "source_event_id": {"type": ["string", "null"]},
    "committed_dispatch_id": {"type": ["string", "null"]},
    "eligibility": {"enum": ["ELIGIBLE", "INELIGIBLE"]},
    "admission_route": {"enum": ["IMPROVEMENT", "SURPRISE_REVISION", "DREAM_SUPPORT", "NONE"]},
    "row_class": {"enum": ["SCIENTIFIC", "REHEARSAL_FILL", "ANCHOR"]},
    "rejection_code": {"enum": ["NONE", "NO_COMMITTED_BRANCH", "NO_PUBLIC_SUPPORT", "FAILED_PROCESS_PREDICATE", "FAILED_UTILITY_GUARD", "FAILED_PROVENANCE", "FAILED_FIREWALL", "OVERLENGTH", "MISSING_EOS", "DUPLICATE_TARGET", "SLOT_ALREADY_FILLED", "OTHER_REGISTERED"]},
    "response_tokens": {"type": "integer", "minimum": 0, "maximum": 256},
    "attended_tokens": {"type": "integer", "minimum": 0, "maximum": 2048},
    "exposures": {"type": "integer", "enum": [0, 4]},
    "optimizer_positions": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
    "fit_id": {"type": ["string", "null"]},
    "candidate_adapter_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "prior_adapter_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "fit_state": {"enum": ["NOT_RUN", "ABORTED", "QUARANTINED", "PASSED"]},
    "mount_state": {"enum": ["NOT_ATTEMPTED", "FAILED", "HASH_MISMATCH", "MOUNTED"]},
    "rollback_state": {"enum": ["NOT_REQUIRED", "PASSED", "FAILED"]},
    "adapter_off_probe_id": {"type": ["string", "null"]},
    "strict_behavior_probe_id": {"type": ["string", "null"]},
    "later_probe_id": {"type": ["string", "null"]}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}

