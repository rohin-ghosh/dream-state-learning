{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper1-v03r-canary-memory-row-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["row_id", "kind", "subject", "relation", "object", "value", "status", "citations"],
  "properties": {
    "row_id": {"type": "string", "pattern": "^M[0-9]+$"},
    "kind": {"enum": ["ROUTE", "EFFECT", "SOURCE_VALUE", "ANIMAL_VALUE", "TARGET_BASELINE", "RECIPE", "ROLE_EQUIV", "CAUSAL_JOIN", "TRANSFERRED_VALUE"]},
    "subject": {"$ref": "#/$defs/atom"},
    "relation": {"$ref": "#/$defs/atom"},
    "object": {"$ref": "#/$defs/atom"},
    "value": {"type": "string", "maxLength": 192, "pattern": "^[ -!#-\\[\\]-~]*$"},
    "status": {"enum": ["PROVISIONAL", "SUPPORTED", "CONTRADICTED", "SUPERSEDED"]},
    "citations": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?:E|M)[0-9]+$"}}
  },
  "$defs": {
    "atom": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"}
  }
}
