  "x-semantic-contract": {
    "bound_artifact_hashes": "semantic_consistency_matrix_sha256, opportunity_ledger_schema_sha256, role_declaration_manifest_sha256, separate_review_request_plan_manifest_sha256, and claim_rejection_fixture_receipt_sha256 must byte-equal their same-named packet artifact sha256 fields. A non-null terminal_claim_state_sha256 must equal artifacts.terminal_claim_state.sha256.",
    "noncircular_review_order": "The packet binds a pre-review request-plan manifest only. It contains no assignment, response, disposition, or future-response digest. Each later assignment and disposition binds this unchanged packet; the authority token binds the two completed disposition hashes after review and grants either the exact successor stage or HUMAN_TERMINAL.",
    "P1CB10": "artifacts.p1cb10 must verify every positive, negative, stage-conditional, and LoRA-resubstitution fixture; exact terminal-claim-state rendering; reviewer-labelled supremacy; changed-byte rereview; noncircular packet-before-assignment-before-disposition-before-authority ordering; and HUMAN_TERMINAL.",
    "separation_boundary": "Actor identifiers, role labels, and freshness declarations are hash-bound self-declared workflow metadata only. Packet validation must not report platform attestation, authentication, canonical identity, actual freshness, or reviewer independence.",
    "scoped_departure": "No qualifying platform-owned issuer/signature/lookup exists. The v1e packet deliberately records the weaker evidence rather than fabricating v1d R10 closure; fresh v1e deliberation must adjudicate this choice."
  },
