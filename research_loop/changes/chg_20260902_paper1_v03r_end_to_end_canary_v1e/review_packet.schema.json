          "artifacts": {"$ref": "#/$defs/early_terminal_artifacts"}
        }
      }
    },
    {
      "if": {"properties": {"transition": {"const": "EARLY_TERMINAL"}, "terminal_stage": {"const": "CPU_IMPLEMENTATION"}}, "required": ["transition", "terminal_stage"]},
      "then": {"properties": {"predecessor_authority_token_sha256": {"type": "null"}}}
    },
    {
      "if": {"properties": {"transition": {"const": "EARLY_TERMINAL"}, "terminal_stage": {"enum": ["DEV_GOLD", "HELDOUT_TEXT", "CONDITIONAL_LORA"]}}, "required": ["transition", "terminal_stage"]},
      "then": {"properties": {"predecessor_authority_token_sha256": {"$ref": "#/$defs/sha256"}}}
    }
