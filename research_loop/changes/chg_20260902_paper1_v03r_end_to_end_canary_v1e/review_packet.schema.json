{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper1-v03r-canary-review-packet-v1e.schema.json",
  "title": "Paper-1 v03r canary v1e immutable review packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "change_id", "transition", "terminal_stage", "protocol_lock_sha256", "semantic_consistency_matrix_sha256", "opportunity_ledger_schema_sha256", "reviewed_lock_sha256", "predecessor_authority_token_sha256", "human_ratification_sha256", "declared_producer_actor_ids", "declared_author_actor_ids", "declared_implementer_actor_ids", "role_declaration_manifest_sha256", "separate_review_request_plan_manifest_sha256", "claim_rejection_fixture_receipt_sha256", "workflow_separation_evidence_boundary", "terminal_claim_state_sha256", "artifact_inventory_id", "artifacts", "supplied_context_manifest_sha256", "artifact_set_sha256", "packet_creation_receipt_sha256", "created_at_utc", "packet_sha256_rule"],
  "properties": {
    "schema_version": {"const": "paper1-v03r-canary-review-packet-v1e.0"},
    "packet_id": {"type": "string", "pattern": "^P1E-PACKET-(CPU_TO_DEV|DEV_TO_HELDOUT|HELDOUT_TO_LORA|STAGE_L_TERMINAL|EARLY_TERMINAL)-[0-9]{4}$"},
    "change_id": {"const": "chg_20260902_paper1_v03r_end_to_end_canary_v1e"},
    "transition": {"enum": ["CPU_TO_DEV", "DEV_TO_HELDOUT", "HELDOUT_TO_LORA", "STAGE_L_TERMINAL", "EARLY_TERMINAL"]},
    "terminal_stage": {"oneOf": [{"type": "null"}, {"enum": ["CPU_IMPLEMENTATION", "DEV_GOLD", "HELDOUT_TEXT", "CONDITIONAL_LORA"]}]},
    "protocol_lock_sha256": {"$ref": "#/$defs/sha256"},
    "semantic_consistency_matrix_sha256": {"$ref": "#/$defs/sha256"},
    "opportunity_ledger_schema_sha256": {"$ref": "#/$defs/sha256"},
    "reviewed_lock_sha256": {"$ref": "#/$defs/sha256"},
    "predecessor_authority_token_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "human_ratification_sha256": {"$ref": "#/$defs/sha256"},
    "declared_producer_actor_ids": {"$ref": "#/$defs/actor_ids"},
    "declared_author_actor_ids": {"$ref": "#/$defs/actor_ids"},
    "declared_implementer_actor_ids": {"$ref": "#/$defs/actor_ids"},
    "role_declaration_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "separate_review_request_plan_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "claim_rejection_fixture_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "workflow_separation_evidence_boundary": {"const": "HASH_BOUND_ROLE_LABELS_AND_FRESHNESS_DECLARATIONS_SELF_DECLARED_UNVERIFIED"},
    "terminal_claim_state_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "artifact_inventory_id": {"enum": ["CPU_TO_DEV_V1E", "DEV_TO_HELDOUT_V1E", "HELDOUT_TO_LORA_V1E", "STAGE_L_TERMINAL_V1E", "EARLY_TERMINAL_V1E"]},
    "artifacts": {"type": "object"},
    "supplied_context_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_set_sha256": {"$ref": "#/$defs/sha256"},
    "packet_creation_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "packet_sha256_rule": {"const": "sha256(UTF-8 RFC8785_JCS(packet excluding packet_sha256)); artifact_set_sha256 hashes the ASCII-byte-sorted array of exact artifact-reference JCS objects"}
  },
  "allOf": [
    {
      "if": {"properties": {"transition": {"const": "CPU_TO_DEV"}}},
      "then": {
        "properties": {
          "terminal_stage": {"type": "null"},
          "predecessor_authority_token_sha256": {"type": "null"},
          "artifact_inventory_id": {"const": "CPU_TO_DEV_V1E"},
