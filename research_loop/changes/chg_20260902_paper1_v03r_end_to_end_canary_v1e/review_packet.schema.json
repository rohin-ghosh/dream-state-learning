      }
    },
    {
      "if": {"properties": {"transition": {"const": "EARLY_TERMINAL"}}},
      "then": {
        "properties": {
          "terminal_stage": {"enum": ["CPU_IMPLEMENTATION", "DEV_GOLD", "HELDOUT_TEXT", "CONDITIONAL_LORA"]},
