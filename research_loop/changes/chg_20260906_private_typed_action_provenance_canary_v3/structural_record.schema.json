{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "private-typed-action-structural-record-v3",
  "$defs": {
    "hash": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "hex": {"type":"string","pattern":"^(?:[0-9a-f]{2})*$"},
