    {
      "allOf": [
        {"$ref":"#/$defs/common"},
        {"type":"object","additionalProperties":false,"required":["action_authorization_sha256","actor","after_state","before_state","event_index","event_type","fixture_id","prior_record_sha256","record_schema_version","score_denominator","score_numerator","transition_manifest_sha256"],"properties":{"action_authorization_sha256":{"$ref":"#/$defs/hash"},"actor":{"const":"TRANSITION_ORACLE"},"after_state":{"type":"integer","minimum":-12,"maximum":12},"before_state":{"type":"integer","minimum":-8,"maximum":8},"event_index":{"const":4},"event_type":{"const":"TRANSITION_DECLARED"},"fixture_id":{"type":"string","minLength":1,"maxLength":128},"prior_record_sha256":{"$ref":"#/$defs/hash"},"record_schema_version":{"const":1},"score_denominator":{"enum":[1,2,4,8]},"score_numerator":{"type":"integer","minimum":-12,"maximum":8},"transition_manifest_sha256":{"$ref":"#/$defs/hash"}}}
