      ]
    },
    {
      "allOf": [
        {"$ref":"#/$defs/common"},
        {"type":"object","additionalProperties":false,"required":["actor","assistant_text_bytes_hex","assistant_text_sha256","event_index","event_type","fixture_id","prior_record_sha256","raw_response_envelope_bytes_hex","raw_response_envelope_sha256","raw_tool_channel_bytes_hex_or_empty","record_schema_version","response_extractor_manifest_sha256"],"properties":{"actor":{"const":"FIXTURE_WRITER"},"assistant_text_bytes_hex":{"$ref":"#/$defs/hex"},"assistant_text_sha256":{"$ref":"#/$defs/hash"},"event_index":{"const":2},"event_type":{"const":"RESPONSE_DECLARED"},"fixture_id":{"type":"string","minLength":1,"maxLength":128},"prior_record_sha256":{"$ref":"#/$defs/hash"},"raw_response_envelope_bytes_hex":{"$ref":"#/$defs/hex"},"raw_response_envelope_sha256":{"$ref":"#/$defs/hash"},"raw_tool_channel_bytes_hex_or_empty":{"$ref":"#/$defs/hex"},"record_schema_version":{"const":1},"response_extractor_manifest_sha256":{"$ref":"#/$defs/hash"}}}
      ]
