    {
      "allOf": [
        {"$ref":"#/$defs/common"},
        {"type":"object","additionalProperties":false,"required":["actor","dispatch_permitted","event_index","event_type","fixture_id","parse_decision_sha256","prior_record_sha256","record_schema_version","transition_present"],"properties":{"actor":{"const":"STRUCTURAL_PARSER"},"dispatch_permitted":{"const":false},"event_index":{"const":4},"event_type":{"const":"NONDISPATCH_DECLARED"},"fixture_id":{"type":"string","minLength":1,"maxLength":128},"parse_decision_sha256":{"$ref":"#/$defs/hash"},"prior_record_sha256":{"$ref":"#/$defs/hash"},"record_schema_version":{"const":1},"transition_present":{"const":false}}}
      ]
    },
    {
      "allOf": [
        {"$ref":"#/$defs/common"},
        {"type":"object","additionalProperties":false,"required":["actor","branch","event_index","event_type","fixture_id","prior_record_sha256","record_count","record_schema_version","terminal_record_set_sha256"],"properties":{"actor":{"const":"FIXTURE_WRITER"},"branch":{"enum":["ACCEPTED","REJECTED"]},"event_index":{"const":5},"event_type":{"const":"FIXTURE_CLOSE"},"fixture_id":{"type":"string","minLength":1,"maxLength":128},"prior_record_sha256":{"$ref":"#/$defs/hash"},"record_count":{"const":6},"record_schema_version":{"const":1},"terminal_record_set_sha256":{"$ref":"#/$defs/hash"}}}
