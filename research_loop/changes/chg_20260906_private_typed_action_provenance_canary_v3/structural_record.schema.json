    {
      "allOf": [
        {"$ref":"#/$defs/common"},
        {"type":"object","additionalProperties":false,"required":["actor","event_index","event_type","first_error_or_null","fixture_id","parse_decision","parse_input_sha256","parser_manifest_sha256","prior_record_sha256","record_schema_version","typed_arguments_or_null"],"properties":{"actor":{"const":"STRUCTURAL_PARSER"},"event_index":{"const":3},"event_type":{"const":"PARSE_DECLARED"},"first_error_or_null":{"enum":[null,"E_ENVELOPE_HEX","E_ENVELOPE_BYTES_LIMIT","E_RESPONSE_UTF8","E_RESPONSE_JSON_DUPKEY","E_RESPONSE_JSON_SYNTAX","E_RESPONSE_ROOT","E_RESPONSE_POINTER","E_RESPONSE_SHAPE","E_EMPTY_CHANNEL","E_DUPLICATE_CALL","E_CALL_SHAPE","E_UNKNOWN_TOOL","E_ARGUMENT_BYTES_LIMIT","E_ARGUMENT_JSON_DUPKEY","E_ARGUMENT_JSON_SYNTAX","E_ARGUMENT_SCHEMA","E_RECORD_RESOURCE","E_RECORD_SCHEMA","E_RELATION"]},"fixture_id":{"type":"string","minLength":1,"maxLength":128},"parse_decision":{"enum":["ACCEPTED","REJECTED"]},"parse_input_sha256":{"$ref":"#/$defs/hash"},"parser_manifest_sha256":{"$ref":"#/$defs/hash"},"prior_record_sha256":{"$ref":"#/$defs/hash"},"record_schema_version":{"const":1},"typed_arguments_or_null":{"oneOf":[{"$ref":"#/$defs/typed_arguments"},{"type":"null"}]}}}
      ]
