{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper1-v03r-canary-review-packet-v1c.schema.json",
  "title": "Paper-1 v03r canary v1c immutable review packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "change_id", "transition", "terminal_stage", "protocol_lock_sha256", "reviewed_lock_sha256", "predecessor_authority_token_sha256", "human_ratification_sha256", "producer_actor_ids", "author_actor_ids", "implementer_actor_ids", "actor_identity_manifest_sha256", "artifact_inventory_id", "artifacts", "supplied_context_manifest_sha256", "artifact_set_sha256", "packet_creation_receipt_sha256", "created_at_utc", "packet_sha256_rule"],
  "properties": {
    "schema_version": {"const": "paper1-v03r-canary-review-packet-v1c.0"},
    "packet_id": {"type": "string", "pattern": "^P1C-PACKET-(CPU_TO_DEV|DEV_TO_HELDOUT|HELDOUT_TO_LORA|STAGE_L_TERMINAL|EARLY_TERMINAL)-[0-9]{4}$"},
    "change_id": {"const": "chg_20260902_paper1_v03r_end_to_end_canary_v1c"},
