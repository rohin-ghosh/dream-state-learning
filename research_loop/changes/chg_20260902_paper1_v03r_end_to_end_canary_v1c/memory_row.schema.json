{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper1-v03r-canary-memory-row-v1c",
  "title": "Immutable accepted cognitive memory row",
  "type": "object",
  "additionalProperties": false,
  "required": ["row_id", "origin", "kind", "fields", "status", "support_basis", "citations", "depth", "semantic_hash", "record_hash"],
  "properties": {
    "row_id": {"type": "string", "pattern": "^M[0-9]{6}$"},
    "origin": {"enum": ["WITNESSED", "DREAMED"]},
    "kind": {"enum": ["ROUTE", "EFFECT", "SOURCE_VALUE", "ANIMAL_VALUE", "TARGET_BASELINE", "RECIPE", "ROLE_EQUIV", "CAUSAL_JOIN", "ROLE_APPLICATION"]},
    "fields": {"type": "array", "minItems": 2, "maxItems": 3},
    "status": {"enum": ["WITNESSED", "SUPPORTED"]},
    "support_basis": {"enum": ["WITNESS", "SELF_REVIEW_SAME_EVIDENCE", "MODEL_CLAIMED_DISTINCT_LINEAGE_SUPPORT"]},
    "citations": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^M[0-9]{6}$"}},
    "depth": {"type": "integer", "minimum": 0, "maximum": 100},
    "semantic_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "record_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"origin": {"const": "WITNESSED"}}, "required": ["origin"]},
      "then": {
        "properties": {
          "row_id": {"type": "string", "pattern": "^M0000[0-9]{2}$"},
          "kind": {"enum": ["ROUTE", "EFFECT", "SOURCE_VALUE", "ANIMAL_VALUE", "TARGET_BASELINE", "RECIPE"]},
          "status": {"const": "WITNESSED"},
          "support_basis": {"const": "WITNESS"},
          "citations": {"maxItems": 0},
          "depth": {"const": 0}
        }
      }
    },
    {
      "if": {"properties": {"origin": {"const": "DREAMED"}}, "required": ["origin"]},
      "then": {
        "properties": {
          "row_id": {"type": "string", "pattern": "^M0010[0-9]{2}$"},
          "kind": {"enum": ["ROLE_EQUIV", "CAUSAL_JOIN", "ROLE_APPLICATION"]},
          "status": {"const": "SUPPORTED"},
          "support_basis": {"enum": ["SELF_REVIEW_SAME_EVIDENCE", "MODEL_CLAIMED_DISTINCT_LINEAGE_SUPPORT"]},
          "citations": {"minItems": 2, "maxItems": 8},
          "depth": {"type": "integer", "minimum": 1, "maximum": 100}
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "ROUTE"}}, "required": ["kind"]},
      "then": {"properties": {"fields": {"type": "array", "prefixItems": [{"$ref": "#/$defs/valve"}, {"$ref": "#/$defs/source"}], "minItems": 2, "maxItems": 2}}}
    },
    {
      "if": {"properties": {"kind": {"const": "EFFECT"}}, "required": ["kind"]},
      "then": {"properties": {"fields": {"type": "array", "prefixItems": [{"$ref": "#/$defs/valve"}, {"$ref": "#/$defs/target"}, {"$ref": "#/$defs/effect_atom"}], "minItems": 3, "maxItems": 3}}}
    },
    {
      "if": {"properties": {"kind": {"enum": ["SOURCE_VALUE", "ANIMAL_VALUE"]}}, "required": ["kind"]},
      "then": {"properties": {"fields": {"type": "array", "prefixItems": [{"$ref": "#/$defs/animal"}, {"$ref": "#/$defs/source"}, {"$ref": "#/$defs/label"}], "minItems": 3, "maxItems": 3}}}
    },
    {
      "if": {"properties": {"kind": {"const": "TARGET_BASELINE"}}, "required": ["kind"]},
      "then": {"properties": {"fields": {"type": "array", "prefixItems": [{"$ref": "#/$defs/animal"}, {"$ref": "#/$defs/target"}, {"$ref": "#/$defs/mixture"}], "minItems": 3, "maxItems": 3}}}
    },
    {
      "if": {"properties": {"kind": {"const": "RECIPE"}}, "required": ["kind"]},
      "then": {"properties": {"fields": {"type": "array", "prefixItems": [{"$ref": "#/$defs/mixture"}, {"$ref": "#/$defs/label"}], "minItems": 2, "maxItems": 2}}}
    },
    {
      "if": {"properties": {"kind": {"const": "ROLE_EQUIV"}}, "required": ["kind"]},
      "then": {"properties": {"fields": {"type": "array", "prefixItems": [{"$ref": "#/$defs/animal"}, {"$ref": "#/$defs/animal"}], "minItems": 2, "maxItems": 2}}}
    },
    {
      "if": {"properties": {"kind": {"const": "CAUSAL_JOIN"}}, "required": ["kind"]},
      "then": {"properties": {"fields": {"type": "array", "prefixItems": [{"$ref": "#/$defs/source"}, {"$ref": "#/$defs/target"}, {"$ref": "#/$defs/effect_atom"}], "minItems": 3, "maxItems": 3}}}
    },
    {
      "if": {"properties": {"kind": {"const": "ROLE_APPLICATION"}}, "required": ["kind"]},
      "then": {"properties": {"fields": {"type": "array", "prefixItems": [{"$ref": "#/$defs/animal"}, {"$ref": "#/$defs/target"}, {"$ref": "#/$defs/animal"}], "minItems": 3, "maxItems": 3}}}
    }
  ],
  "$defs": {
    "valve": {"type": "string", "pattern": "^valve:[a-z0-9][a-z0-9_.+-]{0,63}$"},
    "source": {"type": "string", "pattern": "^source:[a-z0-9][a-z0-9_.+-]{0,63}$"},
    "target": {"type": "string", "pattern": "^target:[a-z0-9][a-z0-9_.+-]{0,63}$"},
    "animal": {"type": "string", "pattern": "^animal:[a-z0-9][a-z0-9_.+-]{0,63}$"},
    "label": {"type": "string", "pattern": "^label:[a-z0-9][a-z0-9_.+-]{0,63}$"},
    "mixture": {"type": "string", "maxLength": 128, "pattern": "^mixture:[1-9][0-9]*\\*[a-z0-9][a-z0-9_.-]{0,63}(?:\\+[1-9][0-9]*\\*[a-z0-9][a-z0-9_.-]{0,63})*$"},
    "effect_atom": {"enum": ["CHANGE", "STABLE"]}
  }
}
