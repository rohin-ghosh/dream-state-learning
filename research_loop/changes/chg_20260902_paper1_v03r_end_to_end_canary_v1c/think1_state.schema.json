{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper1-v03r-canary-think1-state-v1c",
  "type": "object",
  "additionalProperties": false,
  "required": ["question", "state_tokens", "scratch", "previous_read"],
  "properties": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal_id", "question"],
      "properties": {
        "goal_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.:-]+$"},
        "question": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[ -!#-\\[\\]-~]+$"}
      }
    },
    "state_tokens": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^label:[a-z0-9][a-z0-9_.+-]{0,63}$"}
    },
    "scratch": {"$ref": "scratch.schema.json"},
    "previous_read": {"$ref": "think0_state.schema.json#/$defs/previousRead"}
  }
}
