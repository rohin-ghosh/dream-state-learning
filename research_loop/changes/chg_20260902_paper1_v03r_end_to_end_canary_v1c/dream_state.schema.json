{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper1-v03r-canary-dream-state-v1c",
  "type": "object",
  "additionalProperties": false,
  "required": ["trigger", "rows", "focus"],
  "properties": {
    "trigger": {"$ref": "#/$defs/row"},
    "rows": {"type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true, "items": {"$ref": "#/$defs/row"}},
    "focus": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {"type": {"const": "NO_FOCUS"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "source", "target"],
          "properties": {
            "type": {"const": "CAUSAL_JOIN_FOCUS"},
            "source": {"$ref": "#/$defs/source"},
            "target": {"$ref": "#/$defs/target"}
          }
        }
      ]
    }
  },
  "$defs": {
    "row": {"oneOf": [{"$ref": "#/$defs/witnessedRow"}, {"$ref": "#/$defs/dreamedRow"}]},
    "witnessedRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_id", "origin", "kind", "fields", "status", "support_basis", "citations", "depth", "semantic_hash", "record_hash"],
      "properties": {
        "row_id": {"type": "string", "pattern": "^M0000[0-9]{2}$"},
        "origin": {"const": "WITNESSED"},
        "kind": {"enum": ["ROUTE", "EFFECT", "SOURCE_VALUE", "ANIMAL_VALUE", "TARGET_BASELINE", "RECIPE"]},
        "fields": {"oneOf": [
          {"$ref": "#/$defs/routeFields"}, {"$ref": "#/$defs/effectFields"}, {"$ref": "#/$defs/sourceValueFields"},
          {"$ref": "#/$defs/animalValueFields"}, {"$ref": "#/$defs/targetBaselineFields"}, {"$ref": "#/$defs/recipeFields"}
        ]},
        "status": {"const": "WITNESSED"},
        "support_basis": {"const": "WITNESS"},
        "citations": {"type": "array", "maxItems": 0},
        "depth": {"const": 0},
        "semantic_hash": {"$ref": "#/$defs/hash"},
        "record_hash": {"$ref": "#/$defs/hash"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "ROUTE"}}}, "then": {"properties": {"fields": {"$ref": "#/$defs/routeFields"}}}},
        {"if": {"properties": {"kind": {"const": "EFFECT"}}}, "then": {"properties": {"fields": {"$ref": "#/$defs/effectFields"}}}},
        {"if": {"properties": {"kind": {"const": "SOURCE_VALUE"}}}, "then": {"properties": {"fields": {"$ref": "#/$defs/sourceValueFields"}}}},
        {"if": {"properties": {"kind": {"const": "ANIMAL_VALUE"}}}, "then": {"properties": {"fields": {"$ref": "#/$defs/animalValueFields"}}}},
        {"if": {"properties": {"kind": {"const": "TARGET_BASELINE"}}}, "then": {"properties": {"fields": {"$ref": "#/$defs/targetBaselineFields"}}}},
        {"if": {"properties": {"kind": {"const": "RECIPE"}}}, "then": {"properties": {"fields": {"$ref": "#/$defs/recipeFields"}}}}
      ]
    },
    "dreamedRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_id", "origin", "kind", "fields", "status", "support_basis", "citations", "depth", "semantic_hash", "record_hash"],
      "properties": {
        "row_id": {"type": "string", "pattern": "^M0010[0-9]{2}$"},
        "origin": {"const": "DREAMED"},
        "kind": {"enum": ["ROLE_EQUIV", "CAUSAL_JOIN", "ROLE_APPLICATION"]},
        "fields": {"oneOf": [{"$ref": "#/$defs/roleEquivFields"}, {"$ref": "#/$defs/causalJoinFields"}, {"$ref": "#/$defs/roleApplicationFields"}]},
        "status": {"const": "SUPPORTED"},
        "support_basis": {"enum": ["SELF_REVIEW_SAME_EVIDENCE", "MODEL_CLAIMED_DISTINCT_LINEAGE_SUPPORT"]},
        "citations": {"type": "array", "minItems": 2, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^M[0-9]{6}$"}},
        "depth": {"type": "integer", "minimum": 1, "maximum": 100},
        "semantic_hash": {"$ref": "#/$defs/hash"},
        "record_hash": {"$ref": "#/$defs/hash"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "ROLE_EQUIV"}}}, "then": {"properties": {"fields": {"$ref": "#/$defs/roleEquivFields"}}}},
        {"if": {"properties": {"kind": {"const": "CAUSAL_JOIN"}}}, "then": {"properties": {"fields": {"$ref": "#/$defs/causalJoinFields"}}}},
        {"if": {"properties": {"kind": {"const": "ROLE_APPLICATION"}}}, "then": {"properties": {"fields": {"$ref": "#/$defs/roleApplicationFields"}}}}
      ]
    },
    "valve": {"type": "string", "pattern": "^valve:[a-z0-9][a-z0-9_.+-]{0,63}$"},
    "source": {"type": "string", "pattern": "^source:[a-z0-9][a-z0-9_.+-]{0,63}$"},
    "target": {"type": "string", "pattern": "^target:[a-z0-9][a-z0-9_.+-]{0,63}$"},
    "animal": {"type": "string", "pattern": "^animal:[a-z0-9][a-z0-9_.+-]{0,63}$"},
    "label": {"type": "string", "pattern": "^label:[a-z0-9][a-z0-9_.+-]{0,63}$"},
    "mixture": {"type": "string", "maxLength": 128, "pattern": "^mixture:[1-9][0-9]*\\*[a-z0-9][a-z0-9_.-]{0,63}(?:\\+[1-9][0-9]*\\*[a-z0-9][a-z0-9_.-]{0,63})*$"},
    "effect": {"enum": ["CHANGE", "STABLE"]},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "routeFields": {"type": "array", "prefixItems": [{"$ref": "#/$defs/valve"}, {"$ref": "#/$defs/source"}], "items": false, "minItems": 2, "maxItems": 2},
    "effectFields": {"type": "array", "prefixItems": [{"$ref": "#/$defs/valve"}, {"$ref": "#/$defs/target"}, {"$ref": "#/$defs/effect"}], "items": false, "minItems": 3, "maxItems": 3},
    "sourceValueFields": {"type": "array", "prefixItems": [{"$ref": "#/$defs/animal"}, {"$ref": "#/$defs/source"}, {"$ref": "#/$defs/label"}], "items": false, "minItems": 3, "maxItems": 3},
    "animalValueFields": {"$ref": "#/$defs/sourceValueFields"},
    "targetBaselineFields": {"type": "array", "prefixItems": [{"$ref": "#/$defs/animal"}, {"$ref": "#/$defs/target"}, {"$ref": "#/$defs/mixture"}], "items": false, "minItems": 3, "maxItems": 3},
    "recipeFields": {"type": "array", "prefixItems": [{"$ref": "#/$defs/mixture"}, {"$ref": "#/$defs/label"}], "items": false, "minItems": 2, "maxItems": 2},
    "roleEquivFields": {"type": "array", "prefixItems": [{"$ref": "#/$defs/animal"}, {"$ref": "#/$defs/animal"}], "items": false, "minItems": 2, "maxItems": 2},
    "causalJoinFields": {"type": "array", "prefixItems": [{"$ref": "#/$defs/source"}, {"$ref": "#/$defs/target"}, {"$ref": "#/$defs/effect"}], "items": false, "minItems": 3, "maxItems": 3},
    "roleApplicationFields": {"type": "array", "prefixItems": [{"$ref": "#/$defs/animal"}, {"$ref": "#/$defs/target"}, {"$ref": "#/$defs/animal"}], "items": false, "minItems": 3, "maxItems": 3}
  }
}
