{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper1-v03r-canary-opportunity-ledger-v1f.schema.json",
  "title": "Paper-1 v03r canary v1f canonical opportunity ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "change_id",
    "ledger_id",
    "rows"
  ],
  "properties": {
    "schema_version": {
      "const": "paper1-v03r-canary-opportunity-ledger-v1f.0"
    },
    "change_id": {
      "const": "chg_20260903_paper1_v03r_end_to_end_canary_v1f"
    },
    "ledger_id": {
      "type": "string",
      "pattern": "^P1F-LEDGER-[A-Z0-9_.:-]{1,160}$"
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/opportunity_row"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "opportunity_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opportunity_id",
        "stage",
        "arm_id",
        "trace_id",
        "profile",
        "slot",
        "condition",
        "ledger_state",
        "reason",
        "attempts",
        "input_tokens",
        "output_tokens",
        "provider_request_id",
        "cause_opportunity_id",
        "stage_gate_evidence_sha256"
      ],
      "properties": {
        "opportunity_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,192}$"
        },
        "stage": {
          "enum": [
            "DEV_GOLD",
            "HELDOUT_TEXT",
            "CONDITIONAL_LORA"
          ]
        },
        "arm_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Z0-9_-]{1,64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "trace_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,192}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "profile": {
          "enum": [
            "DREAM",
            "SELF_CHECK",
            "THINK0",
            "THINK1_DEV",
            "THINK1_TEXT",
            "THINK1_LORA"
          ]
        },
        "slot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "condition": {
          "enum": [
            "DISPATCH_COMPLETED_NONTERMINAL",
            "DISPATCH_COMMIT",
            "DISPATCH_REQUEST_RETURN",
            "DISPATCH_DEFER",
            "DISPATCH_BUDGET_EXHAUSTED",
            "DISPATCH_MODEL_OUTPUT_FAILURE",
            "DISPATCH_INFRASTRUCTURE_INVALIDITY",
            "NON_DISPATCH_DUPLICATE",
            "NON_DISPATCH_SELF_CHECK_NO_PROPOSAL",
            "NON_DISPATCH_SELF_CHECK_INVALID_PROPOSAL",
            "NON_DISPATCH_PRECONDITION",
            "NON_DISPATCH_UNAUTHORIZED",
            "NON_DISPATCH_STAGE_MISSING_ABSTRACTION",
            "NON_DISPATCH_STAGE_SHAM_INFEASIBLE",
            "NON_DISPATCH_STAGE_FIDELITY_FAILURE",
            "NON_DISPATCH_POST_COMMIT",
            "NON_DISPATCH_POST_REQUEST_RETURN",
            "NON_DISPATCH_POST_DEFER",
            "NON_DISPATCH_POST_BUDGET_EXHAUSTED",
            "NON_DISPATCH_POST_MODEL_FAILURE",
            "NON_DISPATCH_POST_INFRASTRUCTURE_INVALIDITY"
          ]
        },
        "ledger_state": {
          "enum": [
            "DISPATCHED",
            "NON_DISPATCH_DUPLICATE",
            "NON_DISPATCH_NOT_APPLICABLE",
            "NON_DISPATCH_PRECONDITION",
            "NON_DISPATCH_NOT_AUTHORIZED",
            "NON_DISPATCH_STAGE_FAILURE",
