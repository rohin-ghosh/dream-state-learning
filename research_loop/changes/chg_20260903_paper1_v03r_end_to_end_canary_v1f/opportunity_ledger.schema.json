            {
              "$ref": "#/$defs/dispatched_commit"
            },
            {
              "$ref": "#/$defs/dispatched_request_return"
            },
            {
              "$ref": "#/$defs/dispatched_defer"
            },
            {
              "$ref": "#/$defs/dispatched_budget_exhausted"
            },
            {
              "$ref": "#/$defs/dispatched_model_output_failure"
