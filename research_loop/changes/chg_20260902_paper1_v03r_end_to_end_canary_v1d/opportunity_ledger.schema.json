{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper1-v03r-canary-opportunity-ledger-v1d.schema.json",
  "title": "Paper-1 v03r canary v1d canonical opportunity ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "change_id",
    "ledger_id",
    "rows"
  ],
  "properties": {
    "schema_version": {
      "const": "paper1-v03r-canary-opportunity-ledger-v1d.0"
    },
    "change_id": {
      "const": "chg_20260902_paper1_v03r_end_to_end_canary_v1d"
    },
    "ledger_id": {
      "type": "string",
      "pattern": "^P1D-LEDGER-[A-Z0-9_.:-]{1,160}$"
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/opportunity_row"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "opportunity_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opportunity_id",
        "stage",
        "arm_id",
        "trace_id",
        "profile",
        "slot",
        "condition",
        "ledger_state",
        "reason",
        "attempts",
        "input_tokens",
        "output_tokens",
        "provider_request_id",
        "cause_opportunity_id",
        "stage_gate_evidence_sha256"
      ],
      "properties": {
        "opportunity_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,192}$"
        },
        "stage": {
          "enum": [
            "DEV_GOLD",
            "HELDOUT_TEXT",
            "CONDITIONAL_LORA"
          ]
        },
        "arm_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Z0-9_-]{1,64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "trace_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,192}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "profile": {
          "enum": [
            "DREAM",
            "SELF_CHECK",
            "THINK0",
            "THINK1_DEV",
            "THINK1_TEXT",
            "THINK1_LORA"
          ]
        },
        "slot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "condition": {
          "enum": [
            "DISPATCH_COMPLETED_NONTERMINAL",
            "DISPATCH_COMMIT",
            "DISPATCH_REQUEST_RETURN",
            "DISPATCH_DEFER",
            "DISPATCH_BUDGET_EXHAUSTED",
            "DISPATCH_MODEL_OUTPUT_FAILURE",
            "DISPATCH_INFRASTRUCTURE_INVALIDITY",
            "NON_DISPATCH_DUPLICATE",
            "NON_DISPATCH_PRECONDITION",
            "NON_DISPATCH_UNAUTHORIZED",
            "NON_DISPATCH_STAGE_MISSING_ABSTRACTION",
            "NON_DISPATCH_STAGE_SHAM_INFEASIBLE",
            "NON_DISPATCH_STAGE_FIDELITY_FAILURE",
            "NON_DISPATCH_POST_COMMIT",
            "NON_DISPATCH_POST_REQUEST_RETURN",
            "NON_DISPATCH_POST_DEFER",
            "NON_DISPATCH_POST_BUDGET_EXHAUSTED",
            "NON_DISPATCH_POST_MODEL_FAILURE",
            "NON_DISPATCH_POST_INFRASTRUCTURE_INVALIDITY"
          ]
        },
        "ledger_state": {
          "enum": [
            "DISPATCHED",
            "NON_DISPATCH_DUPLICATE",
            "NON_DISPATCH_PRECONDITION",
            "NON_DISPATCH_NOT_AUTHORIZED",
            "NON_DISPATCH_STAGE_FAILURE",
            "NON_DISPATCH_POST_TERMINAL",
            "NON_DISPATCH_POST_INVALID"
          ]
        },
        "reason": {
          "enum": [
            "COMPLETED_NONTERMINAL",
            "COMMIT",
            "REQUEST_RETURN",
            "DEFER",
            "BUDGET_EXHAUSTED",
            "MODEL_OUTPUT_FAILURE",
            "INFRASTRUCTURE_INVALIDITY",
            "DUPLICATE_PROPOSAL",
            "PRE_DISPATCH_INVALID_PRECONDITION",
            "STAGE_NOT_AUTHORIZED",
            "MISSING_REQUIRED_ABSTRACTION",
            "SHAM_NOT_IDENTIFIABLE",
            "FIDELITY_GATE_FAILED",
            "PRIOR_COMMIT",
            "PRIOR_REQUEST_RETURN",
            "PRIOR_DEFER",
            "PRIOR_BUDGET_EXHAUSTED",
            "PRIOR_MODEL_OUTPUT_FAILURE",
            "PRIOR_INFRASTRUCTURE_INVALIDITY"
          ]
        },
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "provider_request_id": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "cause_opportunity_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,192}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "stage_gate_evidence_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "profile": {
                "enum": [
                  "THINK0",
                  "THINK1_DEV",
                  "THINK1_TEXT",
                  "THINK1_LORA"
                ]
              }
            },
            "required": [
              "profile"
            ]
          },
          "then": {
            "properties": {
              "slot": {
                "maximum": 11
              }
            }
          }
        },
        {
          "oneOf": [
            {
              "$ref": "#/$defs/dispatched_completed_nonterminal"
            },
            {
              "$ref": "#/$defs/dispatched_commit"
            },
            {
              "$ref": "#/$defs/dispatched_request_return"
            },
            {
              "$ref": "#/$defs/dispatched_defer"
            },
            {
              "$ref": "#/$defs/dispatched_budget_exhausted"
            },
            {
              "$ref": "#/$defs/dispatched_model_output_failure"
            },
            {
              "$ref": "#/$defs/dispatched_infrastructure_invalidity"
            },
            {
              "$ref": "#/$defs/non_dispatch_duplicate"
            },
            {
              "$ref": "#/$defs/non_dispatch_precondition"
            },
            {
              "$ref": "#/$defs/non_dispatch_unauthorized"
            },
            {
              "$ref": "#/$defs/non_dispatch_stage_missing_abstraction"
            },
            {
              "$ref": "#/$defs/non_dispatch_stage_sham_infeasible"
            },
            {
              "$ref": "#/$defs/non_dispatch_stage_fidelity_failure"
            },
            {
              "$ref": "#/$defs/non_dispatch_post_commit"
            },
            {
              "$ref": "#/$defs/non_dispatch_post_request_return"
            },
            {
              "$ref": "#/$defs/non_dispatch_post_defer"
            },
            {
              "$ref": "#/$defs/non_dispatch_post_budget_exhausted"
            },
            {
              "$ref": "#/$defs/non_dispatch_post_model_failure"
            },
            {
              "$ref": "#/$defs/non_dispatch_post_infrastructure_invalidity"
            }
          ]
        }
      ]
    },
    "dispatched_base": {
      "properties": {
        "ledger_state": {
          "const": "DISPATCHED"
        },
        "attempts": {
          "const": 1
        },
        "provider_request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "cause_opportunity_id": {
          "type": "null"
        },
        "stage_gate_evidence_sha256": {
          "type": "null"
        },
        "trace_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,192}$"
        }
      }
    },
    "zero_attempt_base": {
      "properties": {
        "attempts": {
          "const": 0
        },
        "input_tokens": {
          "const": 0
        },
        "output_tokens": {
          "const": 0
        },
        "provider_request_id": {
          "type": "null"
        }
      }
    },
    "dispatched_completed_nonterminal": {
      "allOf": [
        {
          "$ref": "#/$defs/dispatched_base"
        },
        {
          "properties": {
            "condition": {
              "const": "DISPATCH_COMPLETED_NONTERMINAL"
            },
            "reason": {
              "const": "COMPLETED_NONTERMINAL"
            }
          }
        }
      ]
    },
    "dispatched_commit": {
      "allOf": [
        {
          "$ref": "#/$defs/dispatched_base"
        },
        {
          "properties": {
            "condition": {
              "const": "DISPATCH_COMMIT"
            },
            "reason": {
              "const": "COMMIT"
            },
            "profile": {
              "enum": [
                "THINK1_DEV",
                "THINK1_TEXT",
                "THINK1_LORA"
              ]
            }
          }
        }
      ]
    },
    "dispatched_request_return": {
      "allOf": [
        {
          "$ref": "#/$defs/dispatched_base"
        },
        {
          "properties": {
            "condition": {
              "const": "DISPATCH_REQUEST_RETURN"
            },
            "reason": {
              "const": "REQUEST_RETURN"
            },
            "profile": {
              "const": "THINK0"
            }
          }
        }
      ]
    },
    "dispatched_defer": {
      "allOf": [
        {
          "$ref": "#/$defs/dispatched_base"
        },
        {
          "properties": {
            "condition": {
              "const": "DISPATCH_DEFER"
            },
            "reason": {
              "const": "DEFER"
            },
            "profile": {
              "enum": [
                "THINK0",
                "THINK1_DEV",
                "THINK1_TEXT",
                "THINK1_LORA"
              ]
            }
          }
        }
      ]
    },
    "dispatched_budget_exhausted": {
      "allOf": [
        {
          "$ref": "#/$defs/dispatched_base"
        },
        {
          "properties": {
            "condition": {
              "const": "DISPATCH_BUDGET_EXHAUSTED"
            },
            "reason": {
              "const": "BUDGET_EXHAUSTED"
            },
            "profile": {
              "enum": [
                "THINK0",
                "THINK1_DEV",
                "THINK1_TEXT",
                "THINK1_LORA"
              ]
            },
            "slot": {
              "const": 11
            }
          }
        }
      ]
    },
    "dispatched_model_output_failure": {
      "allOf": [
        {
          "$ref": "#/$defs/dispatched_base"
        },
        {
          "properties": {
            "condition": {
              "const": "DISPATCH_MODEL_OUTPUT_FAILURE"
            },
            "reason": {
              "const": "MODEL_OUTPUT_FAILURE"
            }
          }
        }
      ]
    },
    "dispatched_infrastructure_invalidity": {
      "allOf": [
        {
          "$ref": "#/$defs/dispatched_base"
        },
        {
          "properties": {
            "condition": {
              "const": "DISPATCH_INFRASTRUCTURE_INVALIDITY"
