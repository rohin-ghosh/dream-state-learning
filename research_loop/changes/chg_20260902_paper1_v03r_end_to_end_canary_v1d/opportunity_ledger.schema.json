              "type": "null"
            }
          }
        }
      ]
    },
    "non_dispatch_precondition": {
      "allOf": [
        {
          "$ref": "#/$defs/zero_attempt_base"
        },
        {
          "properties": {
            "condition": {
              "const": "NON_DISPATCH_PRECONDITION"
            },
            "ledger_state": {
              "const": "NON_DISPATCH_PRECONDITION"
            },
            "reason": {
              "const": "PRE_DISPATCH_INVALID_PRECONDITION"
            },
            "cause_opportunity_id": {
              "type": "null"
            },
            "stage_gate_evidence_sha256": {
              "type": "null"
            }
          }
        }
      ]
    },
    "non_dispatch_unauthorized": {
      "allOf": [
        {
          "$ref": "#/$defs/zero_attempt_base"
        },
        {
          "properties": {
            "condition": {
              "const": "NON_DISPATCH_UNAUTHORIZED"
            },
            "ledger_state": {
              "const": "NON_DISPATCH_NOT_AUTHORIZED"
            },
            "reason": {
              "const": "STAGE_NOT_AUTHORIZED"
            },
            "cause_opportunity_id": {
              "type": "null"
            },
            "stage_gate_evidence_sha256": {
              "type": "null"
            }
          }
        }
      ]
    },
    "non_dispatch_stage_missing_abstraction": {
      "allOf": [
        {
          "$ref": "#/$defs/zero_attempt_base"
        },
        {
          "properties": {
            "condition": {
              "const": "NON_DISPATCH_STAGE_MISSING_ABSTRACTION"
            },
            "stage": {
              "const": "HELDOUT_TEXT"
            },
            "profile": {
              "const": "THINK1_TEXT"
            },
            "ledger_state": {
              "const": "NON_DISPATCH_STAGE_FAILURE"
            },
            "reason": {
              "const": "MISSING_REQUIRED_ABSTRACTION"
            },
            "trace_id": {
              "type": "string"
            },
            "cause_opportunity_id": {
              "type": "null"
            },
            "stage_gate_evidence_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      ]
    },
    "non_dispatch_stage_sham_infeasible": {
      "allOf": [
        {
          "$ref": "#/$defs/zero_attempt_base"
