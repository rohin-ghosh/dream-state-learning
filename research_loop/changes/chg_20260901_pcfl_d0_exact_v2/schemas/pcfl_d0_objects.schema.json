        "registered_answers": {"$ref": "#/$defs/registered_answer_pair"},
        "right_world_commitment": {"$ref": "#/$defs/sha256"},
        "schema_version": {"$ref": "#/$defs/schema_version"},
        "valid": {"const": true}
      }
    },
    "binding_map_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["after_object", "before_object", "donor_atom_id", "rebound_atom_id", "source_atom_id", "stratum_id"],
      "properties": {
        "after_object": {"$ref": "#/$defs/node_ref"},
        "before_object": {"$ref": "#/$defs/node_ref"},
