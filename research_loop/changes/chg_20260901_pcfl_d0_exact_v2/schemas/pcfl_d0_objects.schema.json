        "last_read": {"$ref": "#/$defs/collision_component"},
        "prompt_input": {"$ref": "#/$defs/collision_component"},
        "repeat_state": {"$ref": "#/$defs/collision_component"},
        "return_envelope": {"$ref": "#/$defs/collision_component"},
        "snapshot_handle": {"$ref": "#/$defs/collision_component"},
        "state": {"$ref": "#/$defs/collision_component"},
        "system_prompt": {"$ref": "#/$defs/collision_component"},
        "timing_class": {"$ref": "#/$defs/collision_component"},
        "workspace": {"$ref": "#/$defs/collision_component"}
      }
    },
    "registered_answer_pair": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["disjoint", "left_preparations", "right_preparations", "target_level"], "properties": {"disjoint": {"const": true}, "left_preparations": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/preparation_handle"}}, "right_preparations": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/preparation_handle"}}, "target_level": {"const": "A2"}}},
        {"type": "object", "additionalProperties": false, "required": ["disjoint", "left_preparations", "right_preparations", "target_level"], "properties": {"disjoint": {"const": true}, "left_preparations": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/preparation_handle"}}, "right_preparations": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/preparation_handle"}}, "target_level": {"const": "A3"}}}
      ]
    },
    "preaction_twin_collision_certificate": {
      "$comment": "For every component, the checker independently computes both digests and lengths and requires left == right. It also requires the complete legal-query catalog/order digest and return envelope/timing class to collide. Authentic post-query atom payloads may differ; no pre-action input may. The registered preparation sets must be distinct and disjoint.",
      "type": "object",
      "additionalProperties": false,
      "required": ["certificate_id", "components", "different_correct_assignments", "left_world_commitment", "object_type", "registered_answers", "right_world_commitment", "schema_version", "valid"],
      "properties": {
        "certificate_id": {"$ref": "#/$defs/sha256"},
        "components": {"$ref": "#/$defs/collision_components"},
