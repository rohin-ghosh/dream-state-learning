        "stratum_id": {"$ref": "#/$defs/short_id"}
      }
    },
    "four_view_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["FORWARD_COMPLETION", "INCIDENT_EDGE_RECALL", "ONE_MEMORY_STATEMENT", "REVERSE_COMPLETION"],
      "properties": {
        "FORWARD_COMPLETION": {"type": "integer", "minimum": 0},
        "INCIDENT_EDGE_RECALL": {"type": "integer", "minimum": 0},
        "ONE_MEMORY_STATEMENT": {"type": "integer", "minimum": 0},
        "REVERSE_COMPLETION": {"type": "integer", "minimum": 0}
      }
    },
    "s_bind_manifest": {
      "$comment": "One frozen claim-level derangement is applied once and then propagated to atom identities, alias targets, control root projections, all four views, candidate/query membership, answer slots, returns, and manifests. Rebound products are tainted controls, never SUPPORTED claims. before_object != after_object and the source->donor map is a fixed-point-free bijection within each frozen stratum; only the predeclared adjacent length-bin merge is legal.",
      "type": "object",
      "additionalProperties": false,
      "required": ["alias_rewrite_sha256", "answer_slot_rewrite_sha256", "binding_map", "candidate_membership_rewrite_sha256", "control_id", "control_root_projection_sha256", "lifecycle_status", "object_type", "return_rewrite_sha256", "root_compatibility_audit", "schema_version", "source_snapshot_handle", "taint", "training_envelope_equal", "view_counts_after", "view_counts_before"],
      "properties": {
        "alias_rewrite_sha256": {"$ref": "#/$defs/sha256"},
        "answer_slot_rewrite_sha256": {"$ref": "#/$defs/sha256"},
        "binding_map": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/binding_map_entry"}},
        "candidate_membership_rewrite_sha256": {"$ref": "#/$defs/sha256"},
        "control_id": {"$ref": "#/$defs/sha256"},
        "control_root_projection_sha256": {"$ref": "#/$defs/sha256"},
        "lifecycle_status": {"const": "NOT_A_LIFECYCLE_CLAIM"},
        "object_type": {"const": "S_BIND_MANIFEST"},
        "return_rewrite_sha256": {"$ref": "#/$defs/sha256"},
        "root_compatibility_audit": {"type": "object", "additionalProperties": false, "required": ["all_projected_roots_match_rebound_atoms", "authentic_roots_unchanged", "passed"], "properties": {"all_projected_roots_match_rebound_atoms": {"const": true}, "authentic_roots_unchanged": {"const": true}, "passed": {"const": true}}},
        "schema_version": {"$ref": "#/$defs/schema_version"},
        "source_snapshot_handle": {"$ref": "#/$defs/snapshot_handle"},
        "taint": {"const": "CONTROL_CORRUPTED_S_BIND"},
        "training_envelope_equal": {"const": true},
        "view_counts_after": {"$ref": "#/$defs/four_view_counts"},
        "view_counts_before": {"$ref": "#/$defs/four_view_counts"}
      }
    },
    "changed_pointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change_class", "pointer"],
      "properties": {
        "change_class": {"enum": ["MEMORY_ATOM", "PATH_COPY", "PUBLIC_STATE", "PUBLIC_OUTCOME", "REPEAT_STATE", "BUDGET" ]},
        "pointer": {"$ref": "#/$defs/json_pointer"}
      }
    },
    "twin_intervention_certificate": {
      "$comment": "MEMORY_ONLY_AT_COLLIDING_CUT permits changes only to MEMORY_ATOM and dependent PATH_COPY pointers and requires a valid pre-action or decision-cut collision certificate. MATCHED_TWIN_STATE_FORK must be independently replayed to a simulator-reachable twin cut, enumerate every changed pointer, and use the complete matched twin public state/outcomes/repeat/budget rather than a hybrid. All unlisted bytes must match.",
      "type": "object",
      "additionalProperties": false,
      "required": ["all_unlisted_bytes_equal", "changed_pointers", "collision_certificate_id", "intervention_id", "mode", "object_type", "replayed_reachable", "schema_version", "source_cut_sha256", "twin_cut_sha256", "valid"],
      "properties": {
        "all_unlisted_bytes_equal": {"const": true},
        "changed_pointers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/changed_pointer"}},
        "collision_certificate_id": {"$ref": "#/$defs/sha256"},
        "intervention_id": {"$ref": "#/$defs/sha256"},
        "mode": {"enum": ["MEMORY_ONLY_AT_COLLIDING_CUT", "MATCHED_TWIN_STATE_FORK"]},
        "object_type": {"const": "TWIN_INTERVENTION_CERTIFICATE"},
        "replayed_reachable": {"const": true},
        "schema_version": {"$ref": "#/$defs/schema_version"},
        "source_cut_sha256": {"$ref": "#/$defs/sha256"},
        "twin_cut_sha256": {"$ref": "#/$defs/sha256"},
        "valid": {"const": true}
      }
    }
  }
}
