{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ppc5r3-contracts.schema.json",
  "$defs": {
    "hash": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "id": {"type":"string","pattern":"^[a-z][a-z0-9]*-[0-9]{8}$"},
    "nullable_id": {"anyOf":[{"$ref":"#/$defs/id"},{"type":"null"}]},
    "symbol": {"type":"string","pattern":"^[A-Z][A-Z0-9_]{0,95}$"},
    "bytes": {"type":"string","minLength":1},
    "hashes": {"type":"array","items":{"$ref":"#/$defs/hash"},"uniqueItems":true},
    "ids": {"type":"array","items":{"$ref":"#/$defs/id"},"uniqueItems":true},
    "budget": {
      "type":"object","additionalProperties":false,
      "required":["calls","reads","actions","tokens"],
      "properties":{"calls":{"type":"integer","minimum":0},"reads":{"type":"integer","minimum":0},"actions":{"type":"integer","minimum":0},"tokens":{"type":"integer","minimum":0}}
    },
    "prediction": {
      "type":"object","additionalProperties":false,
      "required":["action_id","direction","value_bin"],
      "properties":{"action_id":{"$ref":"#/$defs/id"},"direction":{"enum":["INCREASE","DECREASE","SAME"]},"value_bin":{"$ref":"#/$defs/symbol"}}
    },
    "outcome": {
      "type":"object","additionalProperties":false,
      "required":["action_id","direction","value_bin","normalized_value"],
      "properties":{"action_id":{"$ref":"#/$defs/id"},"direction":{"enum":["INCREASE","DECREASE","SAME"]},"value_bin":{"$ref":"#/$defs/symbol"},"normalized_value":{"type":"number","minimum":0,"maximum":1}}
    },
    "read_found": {
      "type":"object","additionalProperties":false,
      "required":["contract","status","subject_id","relation_id","object_id","record_id"],
      "properties":{"contract":{"const":"ppc5.read.v3"},"status":{"const":"FOUND"},"subject_id":{"$ref":"#/$defs/id"},"relation_id":{"$ref":"#/$defs/id"},"object_id":{"$ref":"#/$defs/id"},"record_id":{"$ref":"#/$defs/id"}}
    },
    "read_null": {
      "type":"object","additionalProperties":false,
      "required":["contract","status","subject_id","relation_id","object_id","record_id"],
      "properties":{"contract":{"const":"ppc5.read.v3"},"status":{"enum":["NOT_FOUND","MISSING_NO_RETRY","INVALID_CELL"]},"subject_id":{"type":"null"},"relation_id":{"type":"null"},"object_id":{"type":"null"},"record_id":{"type":"null"}}
    },
    "read_response": {"oneOf":[{"$ref":"#/$defs/read_found"},{"$ref":"#/$defs/read_null"}]},
    "op_read": {"type":"object","additionalProperties":false,"required":["contract","op","subject_id","relation_id"],"properties":{"contract":{"const":"ppc5.op.v3"},"op":{"const":"READ"},"subject_id":{"$ref":"#/$defs/id"},"relation_id":{"$ref":"#/$defs/id"}}},
    "op_predict": {"type":"object","additionalProperties":false,"required":["contract","op","prediction"],"properties":{"contract":{"const":"ppc5.op.v3"},"op":{"const":"PREDICT"},"prediction":{"$ref":"#/$defs/prediction"}}},
    "op_act": {"type":"object","additionalProperties":false,"required":["contract","op","action_id"],"properties":{"contract":{"const":"ppc5.op.v3"},"op":{"const":"ACT"},"action_id":{"$ref":"#/$defs/id"}}},
    "op_stop": {"type":"object","additionalProperties":false,"required":["contract","op","reason"],"properties":{"contract":{"const":"ppc5.op.v3"},"op":{"const":"STOP"},"reason":{"enum":["GOAL_COMPLETE","NO_VALID_ACTION","USER_STOP"]}}},
    "operation": {"oneOf":[{"$ref":"#/$defs/op_read"},{"$ref":"#/$defs/op_predict"},{"$ref":"#/$defs/op_act"},{"$ref":"#/$defs/op_stop"}]},
    "candidate": {
      "type":"object","additionalProperties":false,
      "required":["candidate_id","record_id","subject_id","relation_id","object_id","public_record_bytes"],
      "properties":{"candidate_id":{"$ref":"#/$defs/id"},"record_id":{"$ref":"#/$defs/id"},"subject_id":{"$ref":"#/$defs/id"},"relation_id":{"$ref":"#/$defs/id"},"object_id":{"$ref":"#/$defs/id"},"public_record_bytes":{"$ref":"#/$defs/bytes"}}
    },
    "semantic_table": {
      "type":"object","additionalProperties":false,
      "required":["contract","table_id","candidates","table_hash"],
      "properties":{"contract":{"const":"ppc5.semantic_table.v3"},"table_id":{"$ref":"#/$defs/id"},"candidates":{"type":"array","items":{"$ref":"#/$defs/candidate"}},"table_hash":{"$ref":"#/$defs/hash"}}
    },
    "model_view": {
      "type":"object","additionalProperties":false,
      "required":["contract","phase","schedule_mode","controller_phase","planning_slot","path_length","item_id","world_state","workspace_record_ids","opened_record_ids","last_read","live_prediction","last_outcome","budgets","call_ordinal","consecutive_error_count","latest_error","prior_transition_hash","ledger_hash","legal_action_ids","operation_schema_hash"],
      "properties":{"contract":{"const":"ppc5.model_view.v3"},"phase":{"enum":["INITIAL","RUNNING"]},"schedule_mode":{"enum":["AUTHENTIC","ONE_SHOT_READ","OPEN_LOOP"]},"controller_phase":{"enum":["INTERLEAVED","PLANNING_READS","FLUSH_READS","COMMIT","COMMIT_BLIND","FLUSH_AND_EXECUTE"]},"planning_slot":{"type":"integer","minimum":0},"path_length":{"type":"integer","minimum":0,"maximum":3},"item_id":{"$ref":"#/$defs/id"},"world_state":{"$ref":"#/$defs/bytes"},"workspace_record_ids":{"$ref":"#/$defs/ids"},"opened_record_ids":{"$ref":"#/$defs/ids"},"last_read":{"anyOf":[{"$ref":"#/$defs/read_response"},{"type":"null"}]},"live_prediction":{"anyOf":[{"$ref":"#/$defs/prediction"},{"type":"null"}]},"last_outcome":{"anyOf":[{"$ref":"#/$defs/outcome"},{"type":"null"}]},"budgets":{"$ref":"#/$defs/budget"},"call_ordinal":{"type":"integer","minimum":0},"consecutive_error_count":{"type":"integer","minimum":0,"maximum":2},"latest_error":{"anyOf":[{"$ref":"#/$defs/symbol"},{"type":"null"}]},"prior_transition_hash":{"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]},"ledger_hash":{"$ref":"#/$defs/hash"},"legal_action_ids":{"$ref":"#/$defs/ids"},"operation_schema_hash":{"$ref":"#/$defs/hash"}}
    },
    "state": {
      "type":"object","additionalProperties":false,
      "required":["contract","phase","public_view","private_controller_hash","terminal_reason","state_hash"],
      "properties":{"contract":{"const":"ppc5.state.v3"},"phase":{"enum":["INITIAL","RUNNING","TERMINAL"]},"public_view":{"anyOf":[{"$ref":"#/$defs/model_view"},{"type":"null"}]},"private_controller_hash":{"$ref":"#/$defs/hash"},"terminal_reason":{"anyOf":[{"enum":["GOAL_COMPLETE","NO_VALID_ACTION","USER_STOP","BUDGET_EXHAUSTED","ERROR_LIMIT","INVALID_CELL","RUN_INVALID"]},{"type":"null"}]},"state_hash":{"$ref":"#/$defs/hash"}},
      "allOf":[{"if":{"properties":{"phase":{"const":"TERMINAL"}}},"then":{"properties":{"public_view":{"type":"null"},"terminal_reason":{"type":"string"}}},"else":{"properties":{"public_view":{"$ref":"#/$defs/model_view"},"terminal_reason":{"type":"null"}}}}]
    },
    "private_controller": {
      "type":"object","additionalProperties":false,
      "required":["contract","schedule_mode","phase","planning_slot","queued_request_hashes","queued_result_hashes","committed_prediction_hash","committed_action_id","discarded_queue_hash"],
      "properties":{"contract":{"const":"ppc5.private_controller.v3"},"schedule_mode":{"enum":["AUTHENTIC","ONE_SHOT_READ","OPEN_LOOP"]},"phase":{"enum":["INTERLEAVED","PLANNING_READS","FLUSH_READS","COMMIT","COMMIT_BLIND","FLUSH_AND_EXECUTE","TERMINAL"]},"planning_slot":{"type":"integer","minimum":0},"queued_request_hashes":{"$ref":"#/$defs/hashes"},"queued_result_hashes":{"$ref":"#/$defs/hashes"},"committed_prediction_hash":{"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]},"committed_action_id":{"$ref":"#/$defs/nullable_id"},"discarded_queue_hash":{"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]}}
    },
    "operation_envelope": {
      "type":"object","additionalProperties":false,
      "required":["contract","call_id","call_ordinal","model_hash","tokenizer_hash","prompt_hash","adapter_hash","seed","input_tokens","output_tokens","raw_output_hash","parse_status","operation"],
      "properties":{"contract":{"const":"ppc5.operation_envelope.v3"},"call_id":{"$ref":"#/$defs/id"},"call_ordinal":{"type":"integer","minimum":0},"model_hash":{"$ref":"#/$defs/hash"},"tokenizer_hash":{"$ref":"#/$defs/hash"},"prompt_hash":{"$ref":"#/$defs/hash"},"adapter_hash":{"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]},"seed":{"type":"integer","minimum":0},"input_tokens":{"type":"integer","minimum":0},"output_tokens":{"type":"integer","minimum":0},"raw_output_hash":{"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]},"parse_status":{"enum":["PARSED","MODEL_MISSING_NO_RETRY","PARSE_ERROR"]},"operation":{"anyOf":[{"$ref":"#/$defs/operation"},{"type":"null"}]}}
    },
    "operation_result": {
      "type":"object","additionalProperties":false,
      "required":["contract","status","origin","read_response","outcome","error_code","stop_reason","slot_ack","result_hash"],
      "properties":{"contract":{"const":"ppc5.operation_result.v3"},"status":{"enum":["SUCCESS","ERROR","TERMINAL","SLOT_ACK"]},"origin":{"enum":["MODEL","HARNESS","PROVIDER","ENVIRONMENT","CONTROLLER"]},"read_response":{"anyOf":[{"$ref":"#/$defs/read_response"},{"type":"null"}]},"outcome":{"anyOf":[{"$ref":"#/$defs/outcome"},{"type":"null"}]},"error_code":{"anyOf":[{"enum":["MODEL_MISSING_NO_RETRY","TOKEN_LIMIT","PARSE_ERROR","READ_LIMIT","ACTION_LIMIT","INVALID_DOMAIN","INVALID_REFERENCE","PREDICTION_REQUIRED","PREDICTION_MISMATCH","INVALID_ACTION","SCHEDULE_VIOLATION","RUN_INVALID"]},{"type":"null"}]},"stop_reason":{"anyOf":[{"enum":["GOAL_COMPLETE","NO_VALID_ACTION","USER_STOP","BUDGET_EXHAUSTED","ERROR_LIMIT","INVALID_CELL","RUN_INVALID"]},{"type":"null"}]},"slot_ack":{"anyOf":[{"type":"object","additionalProperties":false,"required":["slot","status"],"properties":{"slot":{"type":"integer","minimum":0},"status":{"enum":["QUEUED","REJECTED"]}}},{"type":"null"}]},"result_hash":{"$ref":"#/$defs/hash"}}
    },
    "ledger_event": {
      "type":"object","additionalProperties":false,
      "required":["contract","event_id","event_ordinal","prior_event_hash","pre_state_hash","operation_envelope_hash","result_hash","post_state_hash","debit_before","debit_after","event_hash"],
      "properties":{"contract":{"const":"ppc5.ledger_event.v3"},"event_id":{"$ref":"#/$defs/id"},"event_ordinal":{"type":"integer","minimum":0},"prior_event_hash":{"$ref":"#/$defs/hash"},"pre_state_hash":{"$ref":"#/$defs/hash"},"operation_envelope_hash":{"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]},"result_hash":{"$ref":"#/$defs/hash"},"post_state_hash":{"$ref":"#/$defs/hash"},"debit_before":{"$ref":"#/$defs/budget"},"debit_after":{"$ref":"#/$defs/budget"},"event_hash":{"$ref":"#/$defs/hash"}}
    },
    "terminal_receipt": {
      "type":"object","additionalProperties":false,
      "required":["contract","origin","reason","attempted_call_id","attempted_debits","discarded_private_queue_hash","terminal_state_hash","terminal_event_hash"],
      "properties":{"contract":{"const":"ppc5.terminal.v3"},"origin":{"enum":["MODEL","HARNESS"]},"reason":{"enum":["GOAL_COMPLETE","NO_VALID_ACTION","USER_STOP","BUDGET_EXHAUSTED","ERROR_LIMIT","INVALID_CELL","RUN_INVALID"]},"attempted_call_id":{"$ref":"#/$defs/nullable_id"},"attempted_debits":{"$ref":"#/$defs/budget"},"discarded_private_queue_hash":{"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]},"terminal_state_hash":{"$ref":"#/$defs/hash"},"terminal_event_hash":{"$ref":"#/$defs/hash"}}
    },
    "provider_receipt": {
      "type":"object","additionalProperties":false,
      "required":["contract","request_hash","table_hash","provider_kind","mounted_artifact_hash","candidate_score_micros","selected_candidate_id","response","scoring_kernel_hash","receipt_hash"],
      "properties":{"contract":{"const":"ppc5.provider_receipt.v3"},"request_hash":{"$ref":"#/$defs/hash"},"table_hash":{"$ref":"#/$defs/hash"},"provider_kind":{"enum":["READER_LORA","ADAPTER_OFF","WRONG_LIFE_ADAPTER","MATCHED_BINDING_SHUFFLED_READER","RAW_RAG","EXPLICIT_GRAPH"]},"mounted_artifact_hash":{"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]},"candidate_score_micros":{"type":"array","items":{"type":"integer"}},"selected_candidate_id":{"$ref":"#/$defs/nullable_id"},"response":{"$ref":"#/$defs/read_response"},"scoring_kernel_hash":{"$ref":"#/$defs/hash"},"receipt_hash":{"$ref":"#/$defs/hash"}}
    },
    "runtime_intervention": {
      "type":"object","additionalProperties":false,
      "required":["contract","intervention_id","kind","query_hash","selected_response_hash","replacement_response","locked_token_count","byte_length_class","lineage_hash"],
      "properties":{"contract":{"const":"ppc5.runtime_intervention.v3"},"intervention_id":{"$ref":"#/$defs/id"},"kind":{"enum":["AUTHENTIC","CUT","TWIN","SHAM"]},"query_hash":{"$ref":"#/$defs/hash"},"selected_response_hash":{"$ref":"#/$defs/hash"},"replacement_response":{"anyOf":[{"$ref":"#/$defs/read_response"},{"type":"null"}]},"locked_token_count":{"type":"integer","minimum":0},"byte_length_class":{"$ref":"#/$defs/symbol"},"lineage_hash":{"$ref":"#/$defs/hash"}}
    },
    "intervention_receipt": {
      "type":"object","additionalProperties":false,
      "required":["contract","intervention_id","match_count","input_response_hash","output_response_hash","parity_passed","non_target_noop","receipt_hash"],
      "properties":{"contract":{"const":"ppc5.intervention_receipt.v3"},"intervention_id":{"$ref":"#/$defs/id"},"match_count":{"type":"integer","minimum":0},"input_response_hash":{"$ref":"#/$defs/hash"},"output_response_hash":{"$ref":"#/$defs/hash"},"parity_passed":{"type":"boolean"},"non_target_noop":{"type":"boolean"},"receipt_hash":{"$ref":"#/$defs/hash"}}
    },
    "dream_request": {
      "type":"object","additionalProperties":false,
      "required":["contract","snapshot_hash","public_slice_hash","world_state_hash","live_prediction_hash","allowed_record_ids","capacity_records","render_token_ceiling","shared_call_id"],
      "properties":{"contract":{"const":"ppc5.dream_request.v3"},"snapshot_hash":{"$ref":"#/$defs/hash"},"public_slice_hash":{"$ref":"#/$defs/hash"},"world_state_hash":{"$ref":"#/$defs/hash"},"live_prediction_hash":{"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]},"allowed_record_ids":{"$ref":"#/$defs/ids"},"capacity_records":{"type":"integer","minimum":0},"render_token_ceiling":{"type":"integer","minimum":0},"shared_call_id":{"$ref":"#/$defs/id"}}
    },
    "dream_publish": {"type":"object","additionalProperties":false,"required":["contract","kind","retained_record_ids","next_focus_record_id"],"properties":{"contract":{"const":"ppc5.dream_result.v3"},"kind":{"const":"PUBLISH"},"retained_record_ids":{"$ref":"#/$defs/ids"},"next_focus_record_id":{"$ref":"#/$defs/nullable_id"}}},
    "dream_abstain": {"type":"object","additionalProperties":false,"required":["contract","kind","reason"],"properties":{"contract":{"const":"ppc5.dream_result.v3"},"kind":{"const":"ABSTAIN"},"reason":{"enum":["NO_USEFUL_CONTEXT","INSUFFICIENT_SUPPORT","CONTEXT_ALREADY_MINIMAL"]}}},
    "dream_result": {"oneOf":[{"$ref":"#/$defs/dream_publish"},{"$ref":"#/$defs/dream_abstain"}]},
    "dream_receipt": {
      "type":"object","additionalProperties":false,
      "required":["contract","shared_call_id","request_hash","status","result","input_tokens","output_tokens","model_hash","seed","receipt_hash"],
      "properties":{"contract":{"const":"ppc5.dream_receipt.v3"},"shared_call_id":{"$ref":"#/$defs/id"},"request_hash":{"$ref":"#/$defs/hash"},"status":{"enum":["VALID","PUBLISH_EMPTY","ABSTAIN","DREAM_INVALID_OUTPUT","DREAM_MISSING_NO_RETRY"]},"result":{"anyOf":[{"$ref":"#/$defs/dream_result"},{"type":"null"}]},"input_tokens":{"type":"integer","minimum":0},"output_tokens":{"type":"integer","minimum":0},"model_hash":{"$ref":"#/$defs/hash"},"seed":{"type":"integer","minimum":0},"receipt_hash":{"$ref":"#/$defs/hash"}}
    },
    "context_install_receipt": {
      "type":"object","additionalProperties":false,
      "required":["contract","arm_id","dream_receipt_hash","status","ordered_record_ids","focus_record_id","render_hash","render_tokens","installed","receipt_hash"],
      "properties":{"contract":{"const":"ppc5.context_install.v3"},"arm_id":{"enum":["AUTHENTIC_DREAM_CONTEXT","RECENCY_CONTEXT","PERMUTED_CONTEXT"]},"dream_receipt_hash":{"$ref":"#/$defs/hash"},"status":{"enum":["VALID","VALID_EMPTY","ABSTAIN","DREAM_INVALID_OUTPUT","DREAM_MISSING_NO_RETRY","CONSTRUCTION_FAIL","RUN_INVALID"]},"ordered_record_ids":{"$ref":"#/$defs/ids"},"focus_record_id":{"$ref":"#/$defs/nullable_id"},"render_hash":{"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]},"render_tokens":{"type":"integer","minimum":0},"installed":{"type":"boolean"},"receipt_hash":{"$ref":"#/$defs/hash"}}
    },
    "eligibility": {
      "type":"object","additionalProperties":false,
      "required":["contract","record_id","source_event_id","role","dream_visible","item_closed","source_commit_ordinal","before_boundary","probe_or_future","target_derived","source_channel","direct_relation","source_hash","eligible","equivalence_tuple_hash","semantic_family_id","alias_family_id","item_family_id","donor_overlap_group"],
      "properties":{"contract":{"const":"ppc5.eligibility.v3"},"record_id":{"$ref":"#/$defs/id"},"source_event_id":{"$ref":"#/$defs/id"},"role":{"enum":["ACQUIRE","PROBE","STATIC"]},"dream_visible":{"type":"boolean"},"item_closed":{"type":"boolean"},"source_commit_ordinal":{"type":"integer","minimum":0},"before_boundary":{"type":"boolean"},"probe_or_future":{"type":"boolean"},"target_derived":{"type":"boolean"},"source_channel":{"enum":["DIRECT_PUBLIC_ENVIRONMENT","COGNITIVE","DREAM","SCORER","POLICY_TARGET","OTHER"]},"direct_relation":{"type":"boolean"},"source_hash":{"$ref":"#/$defs/hash"},"eligible":{"type":"boolean"},"equivalence_tuple_hash":{"$ref":"#/$defs/hash"},"semantic_family_id":{"$ref":"#/$defs/id"},"alias_family_id":{"$ref":"#/$defs/id"},"item_family_id":{"$ref":"#/$defs/id"},"donor_overlap_group":{"$ref":"#/$defs/id"}}
    },
    "projection_receipt": {
      "type":"object","additionalProperties":false,
      "required":["contract","policy_id","nominee_record_id","first_failure","representative_record_id","source_hashes","projection_hash"],
      "properties":{"contract":{"const":"ppc5.projection_receipt.v3"},"policy_id":{"$ref":"#/$defs/symbol"},"nominee_record_id":{"$ref":"#/$defs/id"},"first_failure":{"anyOf":[{"enum":["MISSING_RECORD","NOT_DREAM_VISIBLE","NOT_ACQUIRE","ITEM_OPEN","AFTER_BOUNDARY","PROBE_OR_FUTURE","TARGET_DERIVED","NOT_DIRECT_PUBLIC_ENVIRONMENT","NOT_DIRECT_RELATION","SOURCE_HASH_MISMATCH","NOT_ELIGIBLE"]},{"type":"null"}]},"representative_record_id":{"$ref":"#/$defs/nullable_id"},"source_hashes":{"$ref":"#/$defs/hashes"},"projection_hash":{"$ref":"#/$defs/hash"}}
    },
    "sleep_row": {
      "type":"object","additionalProperties":false,
      "required":["contract","row_id","root_record_id","request_subject_id","request_relation_id","target_response","source_hash","row_token_count","byte_length_class","row_hash"],
      "properties":{"contract":{"enum":["ppc5.sleep_row.v3","ppc5.control_sleep_row.v3"]},"row_id":{"$ref":"#/$defs/id"},"root_record_id":{"$ref":"#/$defs/id"},"request_subject_id":{"$ref":"#/$defs/id"},"request_relation_id":{"$ref":"#/$defs/id"},"target_response":{"$ref":"#/$defs/read_found"},"source_hash":{"$ref":"#/$defs/hash"},"row_token_count":{"type":"integer","minimum":1},"byte_length_class":{"$ref":"#/$defs/symbol"},"row_hash":{"$ref":"#/$defs/hash"}}
    },
    "adapter_manifest": {
      "type":"object","additionalProperties":false,
      "required":["contract","artifact_id","artifact_hash","status","base_hash","tokenizer_hash","shape_hash","recipe_family_hash","mount_interface_hash","corpus_hash","row_count","token_count","update_count","rank","finite_tensors","structural_check_passed"],
      "properties":{"contract":{"const":"ppc5.adapter_manifest.v3"},"artifact_id":{"$ref":"#/$defs/id"},"artifact_hash":{"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]},"status":{"enum":["VALID","VALID_EMPTY","TRAIN_FAILED","MISSING","RUN_INVALID"]},"base_hash":{"$ref":"#/$defs/hash"},"tokenizer_hash":{"$ref":"#/$defs/hash"},"shape_hash":{"$ref":"#/$defs/hash"},"recipe_family_hash":{"$ref":"#/$defs/hash"},"mount_interface_hash":{"$ref":"#/$defs/hash"},"corpus_hash":{"$ref":"#/$defs/hash"},"row_count":{"type":"integer","minimum":0},"token_count":{"type":"integer","minimum":0},"update_count":{"type":"integer","minimum":0},"rank":{"type":"integer","minimum":0},"finite_tensors":{"type":"boolean"},"structural_check_passed":{"type":"boolean"}}
    },
    "path_proof": {
      "type":"object","additionalProperties":false,
      "required":["contract","item_id","alias_map_hash","world_variant_table_hash","registered_action_id","ordered_edge_ids","proper_subset_sufficiency","alternate_sufficient_path_count","source_preimage_hashes","twin_intervention_ids","sham_intervention_id","proof_hash"],
      "properties":{"contract":{"const":"ppc5.path_proof.v3"},"item_id":{"$ref":"#/$defs/id"},"alias_map_hash":{"$ref":"#/$defs/hash"},"world_variant_table_hash":{"$ref":"#/$defs/hash"},"registered_action_id":{"$ref":"#/$defs/id"},"ordered_edge_ids":{"$ref":"#/$defs/ids"},"proper_subset_sufficiency":{"type":"array","items":{"type":"boolean"}},"alternate_sufficient_path_count":{"const":0},"source_preimage_hashes":{"$ref":"#/$defs/hashes"},"twin_intervention_ids":{"$ref":"#/$defs/ids"},"sham_intervention_id":{"$ref":"#/$defs/id"},"proof_hash":{"$ref":"#/$defs/hash"}}
    },
    "assay_assignment": {
      "type":"object","additionalProperties":false,
      "required":["contract","recipient_life_id","assay_id","clone_id","arm_id","snapshot_hash","seed_bundle_hash","component_matrix_hash","assignment_hash"],
      "properties":{"contract":{"const":"ppc5.assay_assignment.v3"},"recipient_life_id":{"$ref":"#/$defs/id"},"assay_id":{"enum":["D1A","D1B","D1C","D1D"]},"clone_id":{"$ref":"#/$defs/id"},"arm_id":{"$ref":"#/$defs/symbol"},"snapshot_hash":{"$ref":"#/$defs/hash"},"seed_bundle_hash":{"$ref":"#/$defs/hash"},"component_matrix_hash":{"$ref":"#/$defs/hash"},"assignment_hash":{"$ref":"#/$defs/hash"}}
    },
    "stage_outcome": {
      "type":"object","additionalProperties":false,
      "required":["contract","unit_id","assay_id","arm_id","raw_status","installed_hash","calls_debited","tokens_debited","rows_admitted","downstream_executed","missing","endpoint_mode","claim_blocker","receipt_hash"],
      "properties":{"contract":{"const":"ppc5.stage_outcome.v3"},"unit_id":{"$ref":"#/$defs/id"},"assay_id":{"enum":["D1A","D1B","D1C","D1D"]},"arm_id":{"$ref":"#/$defs/symbol"},"raw_status":{"enum":["VALID","PUBLISH_EMPTY","VALID_EMPTY","ABSTAIN","DREAM_INVALID_OUTPUT","PROJECTION_REJECTED","WRITER_EMPTY","TRAIN_FAILED","DREAM_MISSING_NO_RETRY","MODEL_MISSING_NO_RETRY","PROVIDER_MISSING_NO_RETRY","CONSTRUCTION_FAIL","RUN_INVALID"]},"installed_hash":{"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]},"calls_debited":{"type":"integer","minimum":0},"tokens_debited":{"type":"integer","minimum":0},"rows_admitted":{"type":"integer","minimum":0},"downstream_executed":{"type":"boolean"},"missing":{"type":"boolean"},"endpoint_mode":{"enum":["OBSERVED","ADVERSE_BOUND","NONE_BLOCKED"]},"claim_blocker":{"type":"boolean"},"receipt_hash":{"$ref":"#/$defs/hash"}}
    },
    "observation": {
