{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pcfl:compose:event-catalog:v2",
  "title": "PCFL-Compose v2 catalogs, model-visible reads, audit receipts, and target packets",
  "$comment": "The semantic schema with $id urn:pcfl:compose:semantic-dsl:v2 is a required local registry dependency. Network reference retrieval is forbidden.",
  "x-discriminator": ["artifact", "result_kind", "handle_kind", "status"],
  "$defs": {
    "phase": {"enum": ["DREAM1", "DREAM2", "THINK"]},
    "public_event_handle": {
      "$comment": "Fixed-shape non-content handle: E plus the one-based TREE_EVENT source ordinal 01..13, or A plus the one-based RAW_A_EVENT source ordinal 01..02.",
      "type": "string", "pattern": "^(E(0[1-9]|1[0-3])|A0[1-2])$", "minLength": 3, "maxLength": 3
    },
    "candidate_read_handle": {
      "$comment": "Fixed-shape, non-content Dream-1 pool handle deterministically derived from pool ordinal under rng_contract.json's model_visible_identifier namespace.",
      "type": "string", "pattern": "^hdl_c_[A-Za-z0-9_-]{22}$", "minLength": 28, "maxLength": 28
    },
    "memory_read_handle": {
      "$comment": "Fixed-shape, non-content target-memory handle deterministically derived from target-session topology and handle ordinal under rng_contract.json's model_visible_identifier namespace.",
      "type": "string", "pattern": "^hdl_m_[A-Za-z0-9_-]{22}$", "minLength": 28, "maxLength": 28
    },
    "object_capability": {
      "$comment": "Current-session fixed-shape, non-content token deterministically derived from its issuing resolver ordinal under rng_contract.json's model_visible_identifier namespace; never a digest, address, path, length, variant, cache, or deduplication signal.",
      "type": "string", "pattern": "^cap_o_[A-Za-z0-9_-]{22}$", "minLength": 28, "maxLength": 28
    },
    "receipt_ref": {
      "$comment": "Fixed-shape receipt label deterministically derived from the charged read/source ordinal under rng_contract.json's model_visible_identifier namespace, with no content- or treatment-derived component.",
      "type": "string", "pattern": "^rcpt_[A-Za-z0-9_-]{22}$", "minLength": 27, "maxLength": 27
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "minLength": 64, "maxLength": 64},
    "slot_permutation": {
      "type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0, "maximum": 5}
    },
    "public_event": {
      "type": "object", "additionalProperties": false,
      "required": ["before", "action", "after", "slot_permutation"],
      "properties": {
        "before": {"$ref": "urn:pcfl:compose:semantic-dsl:v2#/$defs/tray"},
        "action": {"$ref": "urn:pcfl:compose:semantic-dsl:v2#/$defs/use_action_string"},
        "after": {"$ref": "urn:pcfl:compose:semantic-dsl:v2#/$defs/tray"},
        "slot_permutation": {"$ref": "#/$defs/slot_permutation"}
      }
    },
    "tree_catalog_entry": {
      "type": "object", "additionalProperties": false,
      "required": ["handle_id", "handle_kind", "ordinal", "readable"],
      "properties": {
        "handle_id": {"type": "string", "pattern": "^E(0[1-9]|1[0-3])$", "minLength": 3, "maxLength": 3},
        "handle_kind": {"const": "TREE_EVENT"},
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 13},
        "readable": {"type": "boolean"}
      }
    },
    "raw_a_catalog_entry": {
      "type": "object", "additionalProperties": false,
      "required": ["handle_id", "handle_kind", "ordinal", "readable"],
      "properties": {
        "handle_id": {"type": "string", "pattern": "^A0[1-2]$", "minLength": 3, "maxLength": 3},
        "handle_kind": {"const": "RAW_A_EVENT"},
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 2},
        "readable": {"type": "boolean"}
      }
    },
    "candidate_catalog_entry": {
      "type": "object", "additionalProperties": false,
      "required": ["handle_id", "handle_kind", "ordinal", "readable"],
      "properties": {
        "handle_id": {"$ref": "#/$defs/candidate_read_handle"},
        "handle_kind": {"const": "CANDIDATE"},
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 2},
        "readable": {"type": "boolean"}
      }
    },
    "catalog_entry": {
      "oneOf": [
        {"$ref": "#/$defs/tree_catalog_entry"},
        {"$ref": "#/$defs/raw_a_catalog_entry"},
        {"$ref": "#/$defs/candidate_catalog_entry"}
      ]
    },
    "pre_read_catalog": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact", "phase", "entries"],
      "properties": {
        "artifact": {"const": "PRE_READ_CATALOG"},
        "phase": {"enum": ["DREAM1", "DREAM2"]},
        "entries": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/catalog_entry"}}
      }
    },
    "event_read_result": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact", "result_kind", "phase", "receipt_ref", "handle_id", "handle_kind", "payload"],
      "properties": {
        "artifact": {"const": "EVENT_READ_RECEIPT"},
        "result_kind": {"const": "PUBLIC_EVENT"},
        "phase": {"enum": ["DREAM1", "DREAM2"]},
        "receipt_ref": {"$ref": "#/$defs/receipt_ref"},
        "handle_id": {"$ref": "#/$defs/public_event_handle"},
        "handle_kind": {"enum": ["TREE_EVENT", "RAW_A_EVENT"]},
        "payload": {"$ref": "#/$defs/public_event"}
      }
    },
    "opaque_candidate_payload": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_slot", "representation", "notes", "predictions", "provenance", "confidence", "audit_explanation"],
      "properties": {
        "candidate_slot": {"enum": ["C01", "C02"]},
        "representation": {"const": "OPAQUE_NOTE"},
        "notes": {"type": "array", "minItems": 1, "maxItems": 13, "items": {"$ref": "urn:pcfl:compose:semantic-dsl:v2#/$defs/note"}},
        "predictions": {"$ref": "urn:pcfl:compose:semantic-dsl:v2#/$defs/A_predictions"},
        "provenance": {"$ref": "urn:pcfl:compose:semantic-dsl:v2#/$defs/provenance"},
        "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]},
        "audit_explanation": {"$ref": "urn:pcfl:compose:semantic-dsl:v2#/$defs/audit_explanation"}
      }
    },
    "ast_candidate_payload": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_slot", "representation", "symbols", "records", "predictions", "provenance", "confidence", "audit_explanation"],
      "properties": {
        "candidate_slot": {"enum": ["C01", "C02"]},
        "representation": {"const": "OPERATOR_AST"},
        "symbols": {"type": "array", "maxItems": 8, "items": {"$ref": "urn:pcfl:compose:semantic-dsl:v2#/$defs/symbol_decl"}},
        "records": {"type": "array", "minItems": 1, "maxItems": 13, "items": {"$ref": "urn:pcfl:compose:semantic-dsl:v2#/$defs/ast_record"}},
        "predictions": {"$ref": "urn:pcfl:compose:semantic-dsl:v2#/$defs/A_predictions"},
        "provenance": {"$ref": "urn:pcfl:compose:semantic-dsl:v2#/$defs/provenance"},
        "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]},
        "audit_explanation": {"$ref": "urn:pcfl:compose:semantic-dsl:v2#/$defs/audit_explanation"}
      }
    },
    "candidate_payload": {"oneOf": [{"$ref": "#/$defs/opaque_candidate_payload"}, {"$ref": "#/$defs/ast_candidate_payload"}]},
    "one_shot_opaque_candidate_payload": {
      "$comment": "Immutable one-shot Dream-1 pool item. Every nested provenance object is capability-free; additionalProperties:false rejects capability-named members.",
      "type": "object", "additionalProperties": false,
      "required": ["candidate_slot", "representation", "notes", "predictions", "provenance", "confidence", "audit_explanation"],
      "properties": {
        "candidate_slot": {"enum": ["C01", "C02"]},
        "representation": {"const": "OPAQUE_NOTE"},
        "notes": {"type": "array", "minItems": 1, "maxItems": 13, "items": {"$ref": "urn:pcfl:compose:semantic-dsl:v2#/$defs/one_shot_note"}},
        "predictions": {"$ref": "urn:pcfl:compose:semantic-dsl:v2#/$defs/A_predictions"},
        "provenance": {"$ref": "urn:pcfl:compose:semantic-dsl:v2#/$defs/one_shot_provenance"},
        "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]},
        "audit_explanation": {"$ref": "urn:pcfl:compose:semantic-dsl:v2#/$defs/audit_explanation"}
      }
    },
    "candidate_read_result": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact", "result_kind", "phase", "receipt_ref", "handle_id", "handle_kind", "candidate", "candidate_capability"],
      "properties": {
        "artifact": {"const": "MODEL_READ_RESULT"},
        "result_kind": {"const": "CANDIDATE"},
        "phase": {"const": "DREAM2"},
        "receipt_ref": {"$ref": "#/$defs/receipt_ref"},
        "handle_id": {"$ref": "#/$defs/candidate_read_handle"},
        "handle_kind": {"const": "CANDIDATE"},
        "candidate": {"$ref": "#/$defs/candidate_payload"},
        "candidate_capability": {"$ref": "#/$defs/object_capability"}
      }
    },
    "opaque_memory_found": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact", "result_kind", "phase", "receipt_ref", "lane", "status", "query", "next_cursor", "note_value"],
      "properties": {
        "artifact": {"const": "MODEL_READ_RESULT"}, "result_kind": {"const": "MEMORY"}, "phase": {"const": "THINK"},
        "receipt_ref": {"$ref": "#/$defs/receipt_ref"}, "lane": {"const": "OPAQUE_NOTE"}, "status": {"const": "FOUND"},
        "query": {"$ref": "urn:pcfl:compose:semantic-dsl:v2#/$defs/lexical_query"},
        "next_cursor": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 12}, {"type": "null"}]},
        "note_value": {"$ref": "urn:pcfl:compose:semantic-dsl:v2#/$defs/note"}
      }
    },
    "ast_memory_found": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact", "result_kind", "phase", "receipt_ref", "lane", "status", "query", "next_cursor", "record_value"],
      "properties": {
        "artifact": {"const": "MODEL_READ_RESULT"}, "result_kind": {"const": "MEMORY"}, "phase": {"const": "THINK"},
        "receipt_ref": {"$ref": "#/$defs/receipt_ref"}, "lane": {"const": "OPERATOR_AST"}, "status": {"const": "FOUND"},
        "query": {"$ref": "urn:pcfl:compose:semantic-dsl:v2#/$defs/ast_query"},
        "next_cursor": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 12}, {"type": "null"}]},
        "record_value": {"$ref": "urn:pcfl:compose:semantic-dsl:v2#/$defs/ast_record"}
      }
    },
    "opaque_memory_not_found": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact", "result_kind", "phase", "receipt_ref", "lane", "status", "query", "next_cursor"],
      "properties": {
        "artifact": {"const": "MODEL_READ_RESULT"}, "result_kind": {"const": "MEMORY"}, "phase": {"const": "THINK"},
        "receipt_ref": {"$ref": "#/$defs/receipt_ref"}, "lane": {"const": "OPAQUE_NOTE"}, "status": {"const": "NOT_FOUND"},
        "query": {"$ref": "urn:pcfl:compose:semantic-dsl:v2#/$defs/lexical_query"}, "next_cursor": {"type": "null"}
      }
    },
    "ast_memory_not_found": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact", "result_kind", "phase", "receipt_ref", "lane", "status", "query", "next_cursor"],
      "properties": {
        "artifact": {"const": "MODEL_READ_RESULT"}, "result_kind": {"const": "MEMORY"}, "phase": {"const": "THINK"},
        "receipt_ref": {"$ref": "#/$defs/receipt_ref"}, "lane": {"const": "OPERATOR_AST"}, "status": {"const": "NOT_FOUND"},
        "query": {"$ref": "urn:pcfl:compose:semantic-dsl:v2#/$defs/ast_query"}, "next_cursor": {"type": "null"}
      }
    },
    "model_read_result": {
      "oneOf": [
        {"$ref": "#/$defs/event_read_result"}, {"$ref": "#/$defs/candidate_read_result"},
        {"$ref": "#/$defs/opaque_memory_found"}, {"$ref": "#/$defs/ast_memory_found"},
        {"$ref": "#/$defs/opaque_memory_not_found"}, {"$ref": "#/$defs/ast_memory_not_found"}
      ]
    },
    "batch_event": {
      "type": "object", "additionalProperties": false,
      "required": ["receipt_ref", "handle_id", "handle_kind", "payload"],
      "properties": {
        "receipt_ref": {"$ref": "#/$defs/receipt_ref"}, "handle_id": {"$ref": "#/$defs/public_event_handle"},
        "handle_kind": {"enum": ["TREE_EVENT", "RAW_A_EVENT"]}, "payload": {"$ref": "#/$defs/public_event"}
      }
    },
    "one_shot_event_batch": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact", "phase", "delivery", "events", "charged_read_count"],
      "properties": {
        "artifact": {"const": "ONE_SHOT_EVENT_BATCH"}, "phase": {"enum": ["DREAM1", "DREAM2"]},
        "delivery": {"const": "MECHANICALLY_CHARGED_PREINPUT"},
        "events": {"type": "array", "minItems": 1, "maxItems": 15, "items": {"$ref": "#/$defs/batch_event"}},
        "charged_read_count": {"type": "integer", "minimum": 1, "maximum": 15}
      }
    },
    "target_menu_packet": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact", "release", "target_id", "action_ordinal", "current_tray", "goal_tray", "legal_actions"],
      "properties": {
        "artifact": {"const": "TARGET_MENU_PACKET"}, "release": {"const": "POST_CORPUS_FREEZE_T3"},
        "target_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$", "minLength": 1, "maxLength": 64},
        "action_ordinal": {"type": "integer", "minimum": 1, "maximum": 4},
        "current_tray": {"$ref": "urn:pcfl:compose:semantic-dsl:v2#/$defs/tray"},
        "goal_tray": {"$ref": "urn:pcfl:compose:semantic-dsl:v2#/$defs/tray"},
        "legal_actions": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "urn:pcfl:compose:semantic-dsl:v2#/$defs/use_action_string"}}
      }
    },
    "audit_read_receipt": {
      "$comment": "AUDIT_READ_RECEIPT and its digest/length fields are forbidden from every model input.",
      "type": "object", "additionalProperties": false,
      "required": ["artifact", "receipt_ref", "phase", "source_kind", "operation_ordinal", "charged", "canonical_payload_sha256", "canonical_payload_bytes"],
      "properties": {
        "artifact": {"const": "AUDIT_READ_RECEIPT"}, "receipt_ref": {"$ref": "#/$defs/receipt_ref"}, "phase": {"$ref": "#/$defs/phase"},
        "source_kind": {"enum": ["TREE_EVENT", "RAW_A_EVENT", "CANDIDATE", "OPAQUE_NOTE", "AST_RECORD", "NOT_FOUND"]},
        "operation_ordinal": {"type": "integer", "minimum": 1, "maximum": 32}, "charged": {"const": true},
        "canonical_payload_sha256": {"$ref": "#/$defs/sha256"},
        "canonical_payload_bytes": {"type": "integer", "minimum": 0, "maximum": 32768}
      }
    },
    "audit_batch_receipt": {
      "$comment": "Audit-only proof of one-shot event-by-event charging and ordering.",
      "type": "object", "additionalProperties": false,
      "required": ["artifact", "phase", "source_ledger_sha256", "batch_jcs_sha256", "ordered_receipt_refs", "charged_read_count", "canonical_payload_bytes"],
      "properties": {
        "artifact": {"const": "AUDIT_BATCH_RECEIPT"}, "phase": {"enum": ["DREAM1", "DREAM2"]},
        "source_ledger_sha256": {"$ref": "#/$defs/sha256"}, "batch_jcs_sha256": {"$ref": "#/$defs/sha256"},
        "ordered_receipt_refs": {"type": "array", "minItems": 1, "maxItems": 15, "uniqueItems": true, "items": {"$ref": "#/$defs/receipt_ref"}},
        "charged_read_count": {"type": "integer", "minimum": 1, "maximum": 15},
        "canonical_payload_bytes": {"type": "integer", "minimum": 1, "maximum": 32768}
      }
    },
    "node_capability": {
      "$comment": "Current-session fixed-shape, non-content node token deterministically derived from its accepted authoring resolver ordinal under rng_contract.json's model_visible_identifier namespace.",
      "type": "string", "pattern": "^cap_n_[A-Za-z0-9_-]{22}$", "minLength": 28, "maxLength": 28
    },
    "resolver_state": {
      "type": "object", "additionalProperties": false,
      "required": ["phase", "resolver_ordinal", "workspace_node_capabilities", "staged_object_capabilities", "action_prefix", "terminal_status"],
      "properties": {
        "phase": {"$ref": "#/$defs/phase"},
        "resolver_ordinal": {
          "$comment": "Zero-based pre-operation resolver ordinal r. Every operation_ordinal for this opportunity and the emitted RESOLVER_STEP ordinal are exactly r+1.",
          "type": "integer", "minimum": 0, "maximum": 32
        },
        "workspace_node_capabilities": {"type": "array", "maxItems": 13, "uniqueItems": true, "items": {"$ref": "#/$defs/node_capability"}},
        "staged_object_capabilities": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/object_capability"}},
        "action_prefix": {"type": "array", "maxItems": 4, "items": {"$ref": "urn:pcfl:compose:semantic-dsl:v2#/$defs/use_action_string"}},
        "terminal_status": {"enum": ["OPEN", "COMMITTED", "ABSTAINED", "LOCKED", "FAILED"]}
      }
    },
    "one_shot_resolver_state": {
      "$comment": "Exact empty initial one-shot state. It is structurally capability-free: workspace_node_capabilities, staged_object_capabilities, and every other undeclared capability member are rejected by additionalProperties:false.",
      "type": "object", "additionalProperties": false,
      "required": ["phase", "resolver_ordinal", "action_prefix", "terminal_status"],
      "properties": {
        "phase": {"$ref": "#/$defs/phase"},
        "resolver_ordinal": {"const": 0},
        "action_prefix": {"type": "array", "maxItems": 0},
        "terminal_status": {"const": "OPEN"}
      }
    },
    "dream1_recurrent_budgets": {
      "type": "object", "additionalProperties": false,
      "required": ["operations_remaining", "reads_remaining", "raw_output_tokens_remaining", "prospective_output_tokens"],
      "properties": {
        "operations_remaining": {"type": "integer", "minimum": 0, "maximum": 32},
        "reads_remaining": {"type": "integer", "minimum": 0, "maximum": 13},
        "raw_output_tokens_remaining": {"type": "integer", "minimum": 0, "maximum": 8192},
        "prospective_output_tokens": {"type": "integer", "minimum": 0, "maximum": 2048}
      }
    },
    "dream2_recurrent_budgets": {
      "type": "object", "additionalProperties": false,
      "required": ["operations_remaining", "reads_remaining", "raw_output_tokens_remaining", "prospective_output_tokens"],
      "properties": {
        "operations_remaining": {"type": "integer", "minimum": 0, "maximum": 16},
        "reads_remaining": {"type": "integer", "minimum": 0, "maximum": 8},
        "raw_output_tokens_remaining": {"type": "integer", "minimum": 0, "maximum": 4096},
        "prospective_output_tokens": {"type": "integer", "minimum": 0, "maximum": 2048}
      }
    },
    "think_recurrent_budgets": {
      "type": "object", "additionalProperties": false,
      "required": ["operations_remaining", "reads_remaining", "actions_remaining", "raw_output_tokens_remaining", "prospective_output_tokens"],
      "properties": {
        "operations_remaining": {"type": "integer", "minimum": 0, "maximum": 31},
        "reads_remaining": {"type": "integer", "minimum": 0, "maximum": 13},
        "actions_remaining": {"type": "integer", "minimum": 0, "maximum": 4},
        "raw_output_tokens_remaining": {"type": "integer", "minimum": 0, "maximum": 15872},
        "prospective_output_tokens": {"type": "integer", "minimum": 0, "maximum": 512}
      }
    },
    "one_shot_budgets": {
      "type": "object", "additionalProperties": false,
      "required": ["input_tokens_max", "output_tokens_max", "candidate_count_max", "charged_read_count"],
      "properties": {
        "input_tokens_max": {"type": "integer", "minimum": 1, "maximum": 32768},
        "output_tokens_max": {"type": "integer", "minimum": 1, "maximum": 15872},
        "candidate_count_max": {"type": "integer", "minimum": 0, "maximum": 2},
        "charged_read_count": {"type": "integer", "minimum": 0, "maximum": 15}
      }
    },
    "dream1_one_shot_budgets": {
      "type": "object", "additionalProperties": false,
      "required": ["input_tokens_max", "output_tokens_max", "candidate_count_max", "charged_read_count"],
      "properties": {
        "input_tokens_max": {"const": 32768}, "output_tokens_max": {"const": 8192},
        "candidate_count_max": {"const": 2}, "charged_read_count": {"type": "integer", "minimum": 1, "maximum": 13}
      }
    },
    "dream2_one_shot_budgets": {
      "type": "object", "additionalProperties": false,
      "required": ["input_tokens_max", "output_tokens_max", "candidate_count_max", "charged_read_count"],
      "properties": {
        "input_tokens_max": {"const": 32768}, "output_tokens_max": {"const": 4096},
        "candidate_count_max": {"const": 1}, "charged_read_count": {"type": "integer", "minimum": 1, "maximum": 15}
      }
    },
    "think_one_shot_budgets": {
      "type": "object", "additionalProperties": false,
      "required": ["input_tokens_max", "output_tokens_max", "candidate_count_max", "charged_read_count"],
      "properties": {
        "input_tokens_max": {"const": 32768}, "output_tokens_max": {"const": 15872},
        "candidate_count_max": {"const": 0}, "charged_read_count": {"const": 0}
      }
    },
    "dream1_recurrent_input": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact", "contract_version", "mode", "lane", "operation_ordinal", "budgets", "state", "catalog", "last_read_result"],
      "properties": {
        "artifact": {"const": "INPUT_ENVELOPE"}, "contract_version": {"const": "pcfl-v2"}, "mode": {"const": "DREAM1_RECURRENT"},
        "lane": {"enum": ["OPAQUE_NOTE", "OPERATOR_AST"]}, "operation_ordinal": {"type": "integer", "minimum": 1, "maximum": 32},
        "budgets": {"$ref": "#/$defs/dream1_recurrent_budgets"}, "state": {"$ref": "#/$defs/resolver_state"},
        "catalog": {"$ref": "#/$defs/pre_read_catalog"},
        "last_read_result": {"oneOf": [{"$ref": "#/$defs/event_read_result"}, {"type": "null"}]}
      }
    },
    "dream2_recurrent_input": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact", "contract_version", "mode", "lane", "operation_ordinal", "budgets", "state", "catalog", "last_read_result"],
      "properties": {
        "artifact": {"const": "INPUT_ENVELOPE"}, "contract_version": {"const": "pcfl-v2"}, "mode": {"const": "DREAM2_RECURRENT"},
        "lane": {"enum": ["OPAQUE_NOTE", "OPERATOR_AST"]}, "operation_ordinal": {"type": "integer", "minimum": 1, "maximum": 16},
        "budgets": {"$ref": "#/$defs/dream2_recurrent_budgets"}, "state": {"$ref": "#/$defs/resolver_state"},
        "catalog": {"$ref": "#/$defs/pre_read_catalog"},
        "last_read_result": {"oneOf": [{"$ref": "#/$defs/event_read_result"}, {"$ref": "#/$defs/candidate_read_result"}, {"type": "null"}]}
      }
    },
    "think_recurrent_input": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact", "contract_version", "mode", "lane", "operation_ordinal", "budgets", "state", "memory_handle", "target_packet", "last_read_result"],
