      "kind": "human",
      "instructions": "A P0/P1, population, lock, intake, or exact-review gate failed. No GPU launch or autonomous repair is authorized.",
      "next": "stopped"
    },
    "science_escalation": {
      "kind": "human",
      "instructions": "The bounded postcommit result is ready. No LoRA, repair, replication, follow-up, or claim promotion is authorized without a new intake and human ratification.",
      "next": "stopped"
    },
    "infrastructure_escalation": {
      "kind": "human",
      "instructions": "Remote persistence, markers, timeout, sync, pull, or artifact verification failed. Do not infer completion or relaunch automatically.",
      "next": "stopped"
    },
    "review_failure": {
      "kind": "human",
      "instructions": "A fresh reviewer failed, rejected, escalated, or returned malformed output. No other reviewer or author advocate may override it.",
      "next": "stopped"
    },
    "stopped": {
      "kind": "end",
      "status": "complete",
