{
  "schema_version": 1,
  "name": "dream-ladder-v5-dev",
  "architecture_intake": {"mode": "legacy_no_material_change"},
  "workspace": "../..",
  "state_dir": ".research_loop",
  "start": "local_contract",
  "max_steps": 16,
  "nodes": {
    "local_contract": {
      "kind": "command",
      "argv": [
        ".venv/bin/python",
        "-m",
        "research_loop.validate_v5_contract"
      ],
      "stdout_regex": "\"ok\": true",
      "timeout_sec": 60,
      "next": "freeze_review_inputs",
      "on_failure": "repair_required"
    },
    "freeze_review_inputs": {
      "kind": "command",
      "argv": [
        ".venv/bin/python",
        "-m",
        "research_loop.freeze",
        "create",
        "--root",
        ".",
        "--out",
        "research_loop/runtime/{run_id}.lock.json",
        "--file",
        "alchemy/__init__.py",
        "--file",
        "alchemy/run_lands_v02_dreamladder.py",
        "--file",
        "alchemy/run_lands_v02_organism.py",
        "--file",
        "alchemy/backend.py",
        "--file",
        "alchemy/lora_mem.py",
        "--file",
        "lands/__init__.py",
        "--file",
        "lands/model.py",
        "--file",
        "lands/skins.py",
        "--file",
        "lands/world.py",
        "--file",
        "lands/v02.py",
        "--file",
        "research_notes/35_goalposts_paper1.md",
        "--file",
        "alchemy/v2_out/mini_ledger.md",
        "--file",
        "research_notes/40_FABLE_HANDOFF_RESEARCH_LOOP.md",
        "--file",
        "research_loop/plans/dream_ladder_v5.md",
        "--file",
        "research_loop/prompts/science_reviewer.md",
        "--file",
        "research_loop/prompts/result_analyst.md",
        "--file",
        "research_loop/schemas/review.schema.json",
        "--file",
        "research_loop/schemas/result.schema.json",
        "--file",
        "research_loop/__init__.py",
        "--file",
        "research_loop/agents.py",
        "--file",
        "research_loop/capture_environment.py",
        "--file",
        "research_loop/runtime_preflight.py",
        "--file",
        "research_loop/context_catalog.json",
        "--file",
        "research_loop/fable_transport.py",
        "--file",
        "research_loop/freeze.py",
        "--file",
        "research_loop/io.py",
        "--file",
        "research_loop/plain_tests.py",
        "--file",
        "research_loop/review_binding.py",
        "--file",
        "research_loop/remote_job.py",
        "--file",
        "research_loop/supervisor.py",
        "--file",
        "research_loop/validate_v5_contract.py",
        "--file",
        "research_loop/verify_artifacts.py",
        "--file",
        "research_loop/test_research_loop.py",
        "--file",
        "research_loop/test_v5_semantics.py",
        "--file",
        "research_loop/watchdog.py",
        "--file",
        "research_loop/start_watchdog.sh",
        "--file",
        "gpu/v2node_sync.sh",
        "--file",
        "gpu/v2node_ssh.sh",
        "--file",
        "gpu/v2node_start_research_job.sh",
        "--file",
        "gpu/v2node_pull_research_job.sh",
        "--file",
        "research_loop/workflows/dream_ladder_v5.json",
        "--file",
        "research_loop/workflows/dream_ladder_v5.remote.json"
      ],
      "require_fresh_files": [
        "research_loop/runtime/{run_id}.lock.json"
      ],
      "timeout_sec": 60,
      "next": "fresh_fable_review",
      "on_failure": "repair_required"
    },
    "fresh_fable_review": {
      "kind": "agent",
      "provider": "fable_mailbox",
      "allow_write": false,
      "request_id": "{run_id}-fable-science",
      "prompt_file": "research_loop/prompts/science_reviewer.md",
      "schema_file": "research_loop/schemas/review.schema.json",
      "context_catalog": "research_loop/context_catalog.json",
      "context_profile": "v5_science_review",
      "binding_file": "research_loop/runtime/{run_id}.fable-review.json",
      "context_files": [
        "research_loop/plans/dream_ladder_v5.md",
        "research_notes/35_goalposts_paper1.md",
        "research_loop/runtime/{run_id}.lock.json",
        "research_loop/workflows/dream_ladder_v5.json",
        "research_loop/workflows/dream_ladder_v5.remote.json",
        "research_loop/capture_environment.py",
        "research_loop/runtime_preflight.py",
        "research_loop/remote_job.py",
        "research_loop/review_binding.py",
        "alchemy/backend.py",
        "alchemy/lora_mem.py",
        "lands/model.py",
        "lands/skins.py",
        "lands/world.py",
        "lands/v02.py",
        "alchemy/run_lands_v02_dreamladder.py",
        "alchemy/run_lands_v02_organism.py"
      ],
      "route_field": "verdict",
      "next_by": {
        "approve": "fresh_sol_review",
        "reject": "science_escalation",
        "escalate": "science_escalation"
      },
      "on_failure": "fresh_sol_review",
      "timeout_sec": 60
    },
    "fresh_sol_review": {
      "kind": "agent",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "reasoning_effort": "ultra",
      "provider_attempts": 2,
      "provider_attempt_timeout_sec": 1200,
      "allow_write": false,
      "prompt_file": "research_loop/prompts/science_reviewer.md",
      "schema_file": "research_loop/schemas/review.schema.json",
      "context_catalog": "research_loop/context_catalog.json",
      "context_profile": "v5_science_review",
      "binding_file": "research_loop/runtime/{run_id}.sol-review.json",
      "context_files": [
        "research_loop/plans/dream_ladder_v5.md",
        "research_notes/35_goalposts_paper1.md",
        "research_loop/runtime/{run_id}.lock.json",
        "research_loop/workflows/dream_ladder_v5.json",
        "research_loop/workflows/dream_ladder_v5.remote.json",
        "research_loop/capture_environment.py",
        "research_loop/runtime_preflight.py",
        "research_loop/remote_job.py",
        "research_loop/freeze.py",
        "research_loop/review_binding.py",
        "alchemy/backend.py",
        "alchemy/lora_mem.py",
        "lands/model.py",
        "lands/skins.py",
        "lands/world.py",
        "lands/v02.py",
        "alchemy/run_lands_v02_dreamladder.py",
        "alchemy/run_lands_v02_organism.py"
      ],
      "route_field": "verdict",
      "next_by": {
        "approve": "integrity_tests",
        "reject": "science_escalation",
        "escalate": "science_escalation"
      },
      "on_failure": "agent_failure",
      "timeout_sec": 3600
    },
    "integrity_tests": {
      "kind": "command",
      "argv": [
        ".venv/bin/python",
        "-m",
        "research_loop.plain_tests",
        "research_loop.test_research_loop",
        "research_loop.test_v5_semantics",
        "alchemy.test_integrity",
        "lands.test_v02"
      ],
      "timeout_sec": 600,
      "next": "verify_frozen_inputs",
      "on_failure": "repair_required"
    },
    "verify_frozen_inputs": {
      "kind": "command",
      "argv": [
        ".venv/bin/python",
        "-m",
        "research_loop.freeze",
        "verify",
        "--root",
        ".",
        "--lock",
        "research_loop/runtime/{run_id}.lock.json"
      ],
      "stdout_regex": "verified_at",
      "timeout_sec": 60,
      "next": "verify_sol_review_binding",
      "on_failure": "science_escalation"
    },
    "verify_sol_review_binding": {
      "kind": "command",
      "argv": [
        ".venv/bin/python",
        "-m",
        "research_loop.review_binding",
        "--root",
        ".",
        "--binding",
        "research_loop/runtime/{run_id}.sol-review.json",
        "--required-verdict",
        "approve"
      ],
      "stdout_regex": "\"ok\": true",
      "timeout_sec": 60,
      "next": "sync_h100",
      "on_failure": "science_escalation"
    },
    "sync_h100": {
      "kind": "command",
      "argv": ["./gpu/v2node_sync.sh"],
      "timeout_sec": 900,
      "next": "launch_h100",
      "on_failure": "infrastructure_escalation"
    },
    "launch_h100": {
      "kind": "command",
      "argv": [
        "./gpu/v2node_ssh.sh",
        "cd ~/dream-state && ./gpu/v2node_start_research_job.sh {run_id} {fresh_sol_review_binding_sha256}"
      ],
      "success_exit_codes": [0, 75],
      "stdout_regex": "{run_id}",
      "timeout_sec": 120,
      "next": "wait_h100",
      "on_failure": "infrastructure_escalation"
    },
    "wait_h100": {
      "kind": "poll",
      "argv": [
        "./gpu/v2node_ssh.sh",
        "cd ~/dream-state && env PYTHONPATH=. /localhome/local-rohing/v2/venv/bin/python -m research_loop.remote_job status --run-id {run_id} --job-root /localhome/local-rohing/v2/jobs"
      ],
      "pending_exit_codes": [75, 76],
      "interval_sec": 30,
      "command_timeout_sec": 60,
      "timeout_sec": 43200,
      "next": "pull_artifacts",
      "on_failure": "infrastructure_escalation",
      "on_timeout": "infrastructure_escalation"
    },
    "pull_artifacts": {
      "kind": "command",
      "argv": ["./gpu/v2node_pull_research_job.sh", "{run_id}"],
      "stdout_regex": "{run_id}",
      "timeout_sec": 900,
      "next": "verify_pulled_artifacts",
      "on_failure": "infrastructure_escalation"
    },
    "verify_pulled_artifacts": {
      "kind": "command",
      "argv": [
        ".venv/bin/python",
        "-m",
        "research_loop.verify_artifacts",
        "--job-dir",
        "gpu_artifacts_local/research_loop/{run_id}/job"
      ],
      "stdout_regex": "\"ok\": true",
      "timeout_sec": 60,
      "next": "fresh_result_analysis",
      "on_failure": "infrastructure_escalation"
    },
    "fresh_result_analysis": {
      "kind": "agent",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "reasoning_effort": "ultra",
      "provider_attempts": 2,
      "provider_attempt_timeout_sec": 1200,
      "allow_write": false,
      "prompt_file": "research_loop/prompts/result_analyst.md",
      "schema_file": "research_loop/schemas/result.schema.json",
      "context_catalog": "research_loop/context_catalog.json",
      "context_profile": "result_analysis",
      "context_files": [
        "research_loop/plans/dream_ladder_v5.md",
        "research_notes/35_goalposts_paper1.md",
        "gpu_artifacts_local/research_loop/{run_id}/job/done.json",
        "gpu_artifacts_local/research_loop/{run_id}/job/inputs/research_loop/runtime/{run_id}.lock.json",
        "gpu_artifacts_local/research_loop/{run_id}/job/inputs/research_loop/runtime/{run_id}.sol-review.json",
        "gpu_artifacts_local/research_loop/{run_id}/job/inputs/research_loop/workflows/dream_ladder_v5.remote.json",
        "gpu_artifacts_local/research_loop/{run_id}/job/inputs/research_loop/plans/dream_ladder_v5.md",
        "gpu_artifacts_local/research_loop/{run_id}/job/inputs/alchemy/run_lands_v02_dreamladder.py",
        "gpu_artifacts_local/research_loop/{run_id}/job/inputs/alchemy/run_lands_v02_organism.py",
        "gpu_artifacts_local/research_loop/{run_id}/job/00_runtime_preflight.log",
        "gpu_artifacts_local/research_loop/{run_id}/job/01_capture_environment.log",
        "gpu_artifacts_local/research_loop/{run_id}/job/02_dream_v5.log",
        "gpu_artifacts_local/research_loop/{run_id}/job/03_think_dreamtext.log",
        "gpu_artifacts_local/research_loop/{run_id}/job/artifacts/research_loop/runtime/{run_id}.preflight.json",
        "gpu_artifacts_local/research_loop/{run_id}/job/artifacts/research_loop/runtime/{run_id}.environment.json",
        "gpu_artifacts_local/research_loop/{run_id}/job/artifacts/alchemy/v2_out/dreamladder_aligned_s0.json",
        "gpu_artifacts_local/research_loop/{run_id}/job/artifacts/alchemy/v2_out/organism_corpus_aligned_s0.json",
        "gpu_artifacts_local/research_loop/{run_id}/job/artifacts/alchemy/v2_out/organism_think_dreamtext_aligned_s0.json"
      ],
      "route_field": "next_decision",
      "next_by": {
        "repair": "science_escalation",
        "run_frozen": "science_escalation",
        "replicate_frozen": "science_escalation",
        "stop": "science_escalation",
        "escalate": "science_escalation"
      },
      "on_failure": "agent_failure",
      "timeout_sec": 3600
    },
    "repair_required": {
      "kind": "human",
      "instructions": "A deterministic local contract or test failed. Inspect last_result; repair without changing the scientific plan, then initialize a new run.",
      "next": "stopped"
    },
    "science_escalation": {
      "kind": "human",
      "instructions": "A scientifically meaningful result or design objection is ready. Rohin must ratify the next frozen transition before another development iteration or replication.",
      "next": "stopped"
    },
    "infrastructure_escalation": {
      "kind": "human",
      "instructions": "The remote launch, marker, timeout, or artifact transfer failed. This is infrastructure state, not a scientific result.",
      "next": "stopped"
    },
    "agent_failure": {
      "kind": "human",
      "instructions": "A fresh agent failed to return valid structured output. Inspect its logs; do not route on prose or assume approval.",
      "next": "stopped"
    },
    "stopped": {
      "kind": "end",
      "status": "complete",
      "message": "Workflow stopped at a review boundary."
    }
  }
}
