      "kind": "human",
      "instructions": "A fresh full-closure reviewer failed, rejected, escalated, or returned malformed output. No author advocate or alternate reviewer may override it.",
      "next": "stopped"
    },
    "infrastructure_escalation": {
      "kind": "human",
      "instructions": "Remote sync, markers, heartbeat, verified resume, timeout, pull, or independent artifact verification failed. Do not infer completion, alter science, or relaunch automatically.",
      "next": "stopped"
    },
    "mandatory_human_stop": {
      "kind": "human",
      "instructions": "The bounded six-life recurrence-closure development result is ready or invalid. No repair, replication, follow-up, LoRA, heldout access, claim promotion, external action, or second GPU run is authorized.",
