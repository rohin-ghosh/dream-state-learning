        "student_prefix": [
          {
            "content": "A private company raised $2500 to be used for charity. They donated  80% to a public foundation with 8 organizations. How much money will each organization receive?",
            "role": "user"
          }
        ],
        "student_prefix_sha256": "390ad1717100044723dd7f4ebb999e7a5083fc7d44837feabc9995476baf7e94",
        "target": "Given: The private company raised $2500 and donated 80% of it to a public foundation. This foundation then distributes the donation equally among 8 organizations.\n\nFirst, calculate the amount donated to the public foundation:\n\\[ 80\\% \\text{ of } \\$2500 = 0.80 \\times 2500 = \\$2000 \\]\n\nNext, distribute this amount equally among the 8 organizations:\n\\[ \\frac{\\$2000}{8} = \\$250 \\]\n\nEach organization will receive $250.\n\nFINAL: 250",
        "target_sha256": "21439df7f7e05b9e60b588f99d9044f4ede843549b813d081bedb2ad3da328f1"
