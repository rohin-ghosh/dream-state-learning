{"gold":[{"independent_answer":"400","question_sha256":"d3b4f483c02fcc0472d38e6ad8136c87cb9048918e830625c832dc744d94f505","reason":"Daily pay is 50 × 10 = 500. Withholding 20% removes 0.20 × 500 = 100, leaving 500 − 100 = 400, equal to the gold.","status":"VALID","task_id":"gsm8k-train-7387"},{"independent_answer":"17","question_sha256":"9fa52b480e4dbec563a69dd3698ed4389d3f221e959b359f819a8e46b5574c24","reason":"The marked price is 50 × 1.30 = 65. A 10% discount gives 65 × 0.90 = 58.5, so profit is 8.5 and percent profit is 8.5/50 × 100 = 17, equal to the gold.","status":"VALID","task_id":"gsm8k-train-6916"},{"independent_answer":"22","question_sha256":"c53918a99e6540396a10811cbf572073cac6760ed151ea5edfccac5600f7ece9","reason":"Vanilla orders are 20% of 220, or 44. Since vanilla orders are twice chocolate orders, chocolate orders are 44/2 = 22, equal to the gold. The remaining customers may have ordered other flavors.","status":"VALID","task_id":"gsm8k-train-2765"},{"independent_answer":"23","question_sha256":"07933e52ddd2b91d6b141ccc5db5b073be8fcdd23edc33620716cada8bc2335b","reason":"Ten percent of 920 is 92 eight-antlered deer. One quarter of 92 is 23, equal to the gold.","status":"VALID","task_id":"gsm8k-train-4306"},{"independent_answer":"24","question_sha256":"1ee26c51704ba28d4fc4398336b7757d6588ff484670c3e9b459c8830b0f2dc9","reason":"The two sides contain 16 + 16 = 32 squares. Betsy has sewn 25% of 32 = 8, leaving 32 − 8 = 24, equal to the gold.","status":"VALID","task_id":"gsm8k-train-5139"},{"independent_answer":"184","question_sha256":"5b812f989c4063bb44e6547da4f036595385855c8ddbe6639f1a4d7aceedd159","reason":"Federal tax is 450/3 = 150 and state tax is 0.08 × 450 = 36. Total deductions are 150 + 36 + 50 + 20 + 10 = 266, leaving 450 − 266 = 184, equal to the gold.","status":"VALID","task_id":"gsm8k-train-3706"},{"independent_answer":"underdetermined","question_sha256":"ae3ca08f91d25aeeb357267b400e343aa44b9b9da34078883c2263b6a99bc149","reason":"The foundatio