    "responses": [
      {
        "key": "gsm8k-train-5474:rich",
        "raw_call_sha256": "4d8ce2f177fcca7a0f65c2b9e2ebcd4f193427d6c1224167c25184ddcf2f6050",
        "student_prefix": [
